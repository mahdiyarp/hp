import React, { useEffect, useState } from 'react'import { useI18n } from './i18n/I18nContext'export default function App() {  const { t, dir } = useI18n()  const [apiMessage, setApiMessage] = useState<string>('')  useEffect(() => {    document.documentElement.dir = dir  }, [dir])  useEffect(() => {    // Test backend connectivity    fetch('/api/hello')      .then(r => r.ok ? r.json() : Promise.reject(r.statusText))      .then(d => setApiMessage(d?.message || ''))      .catch(() => setApiMessage(''))  }, [])  return (    <div style={{ padding: '2rem' }}>      <h1 style={{ marginBottom: '1rem' }}>حساب‌پاک - Frontend</h1>      {apiMessage && (        <p style={{ color: '#2f855a', marginBottom: '1rem' }}>Backend: {apiMessage}</p>      )}      <p>{t('welcome', 'به برنامه خوش آمدید')}</p>    </div>  )}