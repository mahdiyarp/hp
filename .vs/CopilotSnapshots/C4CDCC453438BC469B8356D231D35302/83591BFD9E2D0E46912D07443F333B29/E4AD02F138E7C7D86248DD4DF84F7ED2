#!/usr/bin/env python3
"""
Simple encoding repair tool for repository text files.
Usage: python tools/fix_encodings.py [paths...]
If no paths provided, defaults to 'frontend' and 'backend'.

Heuristics:
- Read file bytes
- Try decode as utf-8; if success, attempt to detect mojibake (UTF-8 bytes decoded then re-encoded as Latin-1). If detected, recover by re-decoding.
- If utf-8 decode fails, try cp1256 (Arabic) and cp1252 and fallback to latin1; if one yields a candidate with many Arabic/Persian letters, re-save as UTF-8.
- Create .bak for modified files.

This is best-effort; review diffs after running.
"""
import sys
from pathlib import Path
import re

TEXT_EXTS = {'.js', '.ts', '.tsx', '.jsx', '.py', '.json', '.html', '.css', '.md', '.txt'}

ARABIC_RE = re.compile(r'[\u0600-\u06FF]')


def arabic_score(s: str) -> int:
    return len(ARABIC_RE.findall(s))


def try_fix_bytes(b: bytes) -> (str, bool):
    """Return (fixed_text, changed_flag)."""
    # Try decode as utf-8
    try:
        s = b.decode('utf-8')
    except Exception:
        s = None

    # If utf-8 decodes, check for mojibake pattern: if re-encoding via latin1 -> utf-8 yields more arabic letters, pick it
    if s is not None:
        base_score = arabic_score(s)
        try:
            cand = s.encode('latin1').decode('utf-8')
            cand_score = arabic_score(cand)
            if cand_score > base_score:
                return cand, True
        except Exception:
            pass
        # also try cp1256 decode path: sometimes file saved in cp1256
        try:
            cand2 = b.decode('cp1256')
            if arabic_score(cand2) > base_score:
                return cand2, True
        except Exception:
            pass
        # nothing to change
        return s, False

    # If utf-8 failed, try cp1256 (Arabic), then cp1252/latin1
    for enc in ('cp1256', 'cp1252', 'latin1'):
        try:
            s2 = b.decode(enc)
            # if s2 contains many arabic letters, accept
            if arabic_score(s2) > 0:
                return s2, True
            # else, still accept cp1252->utf8 conversion attempt via roundtrip
            try:
                cand = s2.encode('latin1').decode('utf-8')
                if arabic_score(cand) > 0:
                    return cand, True
            except Exception:
                pass
        except Exception:
            continue

    # Give up: decode as utf-8 with replacement to preserve content
    try:
        s3 = b.decode('utf-8', errors='replace')
        return s3, False
    except Exception:
        return b.decode('latin1', errors='replace'), False


def is_text_file(path: Path) -> bool:
    if path.suffix.lower() in TEXT_EXTS:
        return True
    # small files without extension
    try:
        if path.stat().st_size > 200000:
            return False
    except Exception:
        return False
    return True


def walk_and_fix(paths):
    changed_files = []
    for p in paths:
        base = Path(p)
        if not base.exists():
            continue
        if base.is_file():
            files = [base]
        else:
            files = [f for f in base.rglob('*') if f.is_file()]
        for f in files:
            if not is_text_file(f):
                continue
            try:
                b = f.read_bytes()
            except Exception:
                continue
            fixed, changed = try_fix_bytes(b)
            if changed:
                bak = f.with_suffix(f.suffix + '.bak')
                try:
                    if not bak.exists():
                        # create backup copy
                        f.rename(bak)
                        # write fixed to original path
                        f.write_text(fixed, encoding='utf-8')
                    else:
                        # backup exists, just overwrite original
                        f.write_text(fixed, encoding='utf-8')
                except Exception:
                    # fallback: write to temp file
                    try:
                        tmp = f.with_suffix('.fixed')
                        tmp.write_text(fixed, encoding='utf-8')
                    except Exception:
                        continue
                changed_files.append(str(f))
    return changed_files


if __name__ == '__main__':
    args = sys.argv[1:] or ['frontend', 'backend']
    changed = walk_and_fix(args)
    if changed:
        print('Fixed files:')
        for c in changed:
            print(' -', c)
    else:
        print('No changes made.')
