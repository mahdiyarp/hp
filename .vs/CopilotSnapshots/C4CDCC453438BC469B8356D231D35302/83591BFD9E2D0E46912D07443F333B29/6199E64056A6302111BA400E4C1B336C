def fix_file(file_path):
    """اصلاح یک فایل از کدگذاری‌های شکسته"""
    try:
        with open(file_path, 'r', encoding='utf-8', errors='ignore') as f:
            content = f.read()
        
        original = content
        
        for corrupted, correct in CORRUPTED_TO_CORRECT.items():
            content = content.replace(corrupted, correct)
        
        if content != original:
            with open(file_path, 'w', encoding='utf-8') as f:
                f.write(content)
            return True
        return False
    except Exception as e:
        print(f"خطا در پردازش فایل {file_path}: {e}")
        return False

def process_directory(directory):
    """پردازش تمام فایل‌های با پسوند مشخص در یک دایرکتوری"""
    fixed_count = 0
    
    for root, dirs, files in os.walk(directory):
        dirs[:] = [d for d in dirs if d not in ['node_modules', '.git', 'dist', 'build']]
        
        for file in files:
            if file.endswith(('.tsx', '.ts', '.json')):
                file_path = os.path.join(root, file)
                if fix_file(file_path):
                    print(f"✓ فایل اصلاح شد: {file_path}")
                    fixed_count += 1
    
    return fixed_count

if __name__ == '__main__':
    project_root = Path(__file__).resolve().parent.parent
    frontend_dir = project_root / 'frontend' / 'src'
    
    print(f"شروع پردازش دایرکتوری: {frontend_dir}")
    
    if frontend_dir.is_dir():
        count = process_directory(str(frontend_dir))
        print(f"\nعملیات تمام شد. مجموعا {count} فایل اصلاح شد.")
    else:
        print(f"خطا: دایرکتوری '{frontend_dir}' یافت نشد. جستجو در کل پروژه...")
        count = process_directory(str(project_root))
        print(f"\nعملیات در کل پروژه تمام شد. مجموعا {count} فایل اصلاح شد.")
