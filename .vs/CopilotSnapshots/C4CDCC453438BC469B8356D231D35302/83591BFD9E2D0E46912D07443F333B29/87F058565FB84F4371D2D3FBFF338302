def fix_file(file_path):
    """اصلاح ?ک فا?ل از کدگذار?‌ها? شکسته"""
    try:
        with open(file_path, 'r', encoding='utf-8') as f:
            content = f.read()
        
        original = content
        
        # جا?گز?ن? متن‌ها? شکسته
        for corrupted, correct in CORRUPTED_TO_CORRECT.items():
            content = content.replace(corrupted, correct)
        
        # اگر تغ??ر? رخ داد، فا?ل را ذخ?ره کن
        if content != original:
            with open(file_path, 'w', encoding='utf-8') as f:
                f.write(content)
            return True
        return False
    except Exception as e:
        print(f"خطا در {file_path}: {e}")
        return False

def process_directory(directory):
    """تمام فا?ل‌ها? TypeScript و JSON را پردازش کن"""
    fixed_count = 0
    
    for root, dirs, files in os.walk(directory):
        # ناد?ده بگ?ر node_modules و .git
        dirs[:] = [d for d in dirs if d not in ['node_modules', '.git', 'dist', 'build']]
        
        for file in files:
            if file.endswith(('.tsx', '.ts', '.json')):
                file_path = os.path.join(root, file)
                if fix_file(file_path):
                    print(f"? اصلاح شد: {file_path}")
                    fixed_count += 1
    
    return fixed_count

