import React, { useEffect, useState } from 'react'import { useI18n } from './i18n/I18nContext'export default function App() {  const { t, dir } = useI18n()  const [apiMessage, setApiMessage] = useState<string>('')  useEffect(() => {    document.documentElement.dir = dir    document.documentElement.lang = 'fa'  }, [dir])  useEffect(() => {    // Test backend connectivity    fetch('/api/hello')      .then(r => r.ok ? r.json() : Promise.reject(r.statusText))      .then(d => setApiMessage(d?.message || ''))      .catch(() => setApiMessage(''))  }, [])  return (    <div style={{ padding: '2rem', fontFamily: 'IranYekan, Vazirmatn, sans-serif' }}>      <h1 style={{ marginBottom: '1rem', textAlign: 'right' }}>حساب‌پاک</h1>      {apiMessage && (        <p style={{ color: '#2f855a', marginBottom: '1rem', textAlign: 'right' }}>          بک‌اند: {apiMessage}        </p>      )}      <p style={{ textAlign: 'right' }}>{t('welcome', 'به برنامه خوش آمدید')}</p>    </div>  )}