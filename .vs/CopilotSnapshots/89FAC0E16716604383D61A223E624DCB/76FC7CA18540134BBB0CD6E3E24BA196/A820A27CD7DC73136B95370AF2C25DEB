/* Global Persian RTL font and rendering fixes (additive) */
@font-face {
  font-family: 'Vazirmatn';
  src: url('/fonts/Vazirmatn-400.woff2') format('woff2');
  font-weight: 100 900;
  font-style: normal;
  font-display: swap;
}

* {
  font-family: "Vazirmatn", "IRANSansX", "Yekan", "IranYekan", sans-serif !important;
  direction: rtl;
  unicode-bidi: plaintext;
}

html, body {
  font-feature-settings: "liga" 1, "clig" 1, "kern" 1;
  text-rendering: optimizeLegibility;
}

:lang(en) {
  direction: ltr;
  unicode-bidi: isolate;
}

/* Soft overrides for UI libraries and charts */
.ant-typography, .ant-btn, .ant-input, .ant-table, .ant-menu, .ant-select, .ant-tag,
.MuiTypography-root, .MuiButton-root, .MuiInputBase-root, .MuiTable-root,
.chart-label, .recharts-text {
  font-family: inherit !important;
}

/* Ensure placeholders inherit font */
::placeholder { font-family: inherit !important; }

/* Additional soft override selectors for components that force fonts */
.force-font, .widget *, .chart-label *, .MuiTypography-root, .ant-typography {
  font-family: 'Vazirmatn', inherit !important;
}
