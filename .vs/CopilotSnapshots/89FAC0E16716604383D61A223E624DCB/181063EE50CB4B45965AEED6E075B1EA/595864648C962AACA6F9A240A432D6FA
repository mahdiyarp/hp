"""
Comprehensive tests for Jalali/Gregorian date conversion utilities.
Tests round-trip conversions, edge cases, and API integration.
"""

import pytest
from datetime import datetime, date
import jdatetime
from app.utils.date import (
    to_shamsi,
    to_gregorian,
    parse_shamsi_date,
    format_shamsi,
    get_shamsi_range,
    shamsi_now,
    is_valid_shamsi_date,
    gregorian_to_shamsi_range_inclusive,
)


class TestToShamsi:
    """Test Gregorian to Shamsi (Jalali) conversion."""

    def test_to_shamsi_simple_date(self):
        """Convert a simple Gregorian date to Shamsi."""
        dt = datetime(2024, 1, 1, 0, 0, 0)
        result = to_shamsi(dt)
        assert result == "1402/10/11"

    def test_to_shamsi_date_object(self):
        """Convert a date object (not datetime)."""
        d = date(2024, 3, 20)
        result = to_shamsi(d)
        assert isinstance(result, str)
        assert "/" in result
        parts = result.split("/")
        assert len(parts) == 3
        assert all(p.isdigit() for p in parts)

    def test_to_shamsi_none_returns_none(self):
        """None input should return None."""
        result = to_shamsi(None)
        assert result is None

    def test_to_shamsi_format_padding(self):
        """Month and day should be zero-padded."""
        dt = datetime(2024, 1, 5, 0, 0, 0)
        result = to_shamsi(dt)
        parts = result.split("/")
        # Check that month and day are 2 digits
        assert len(parts[1]) == 2
        assert len(parts[2]) == 2

    def test_to_shamsi_multiple_dates(self):
        """Test multiple date conversions."""
        test_dates = [
            (datetime(2024, 1, 1), "1402/10/11"),
            (datetime(2024, 12, 31), "1403/10/11"),
            (datetime(2023, 6, 15), "1402/03/25"),
        ]
        for dt, expected in test_dates:
            result = to_shamsi(dt)
            assert result == expected


class TestToGregorian:
    """Test Shamsi to Gregorian conversion."""

    def test_to_gregorian_string_format(self):
        """Convert Shamsi string to Gregorian datetime."""
        result = to_gregorian("1402/10/11")
        assert isinstance(result, datetime)
        assert result.year == 2024
        assert result.month == 1
        assert result.day == 1

    def test_to_gregorian_dash_format(self):
        """Convert Shamsi string with dashes."""
        result = to_gregorian("1402-10-11")
        assert isinstance(result, datetime)
        assert result.year == 2024

    def test_to_gregorian_dict_format(self):
        """Convert Shamsi dict to Gregorian datetime."""
        result = to_gregorian({"year": 1402, "month": 10, "day": 11})
        assert isinstance(result, datetime)
        assert result.year == 2024

    def test_to_gregorian_invalid_format_raises_error(self):
        """Invalid format should raise ValueError."""
        with pytest.raises(ValueError):
            to_gregorian("invalid")

    def test_to_gregorian_invalid_date_raises_error(self):
        """Invalid date values should raise ValueError."""
        with pytest.raises(ValueError):
            to_gregorian("1402/13/01")  # Month 13 doesn't exist

    def test_to_gregorian_midnight_utc(self):
        """Result should be at midnight UTC."""
        result = to_gregorian("1402/10/11")
        assert result.hour == 0
        assert result.minute == 0
        assert result.second == 0


class TestRoundTripConversion:
    """Test that round-trip conversion is lossless."""

    def test_gregorian_to_shamsi_to_gregorian(self):
        """Gregorian -> Shamsi -> Gregorian should preserve date."""
        original = datetime(2024, 3, 20, 14, 30, 45)
        shamsi = to_shamsi(original)
        back = to_gregorian(shamsi)
        # Compare dates only (time should be normalized to midnight)
        assert original.date() == back.date()

    def test_shamsi_to_gregorian_to_shamsi(self):
        """Shamsi -> Gregorian -> Shamsi should be identical."""
        original = "1402/06/15"
        gregorian = to_gregorian(original)
        shamsi = to_shamsi(gregorian)
        assert shamsi == original

    def test_multiple_round_trips(self):
        """Multiple round-trips should preserve the date."""
        original = "1403/01/01"
        result = original
        for _ in range(5):
            gregorian = to_gregorian(result)
            result = to_shamsi(gregorian)
        assert result == original


class TestValidation:
    """Test date validation functions."""

    def test_is_valid_shamsi_date_valid(self):
        """Valid Shamsi dates should return True."""
        assert is_valid_shamsi_date("1402/01/01") is True
        assert is_valid_shamsi_date("1403/12/30") is True

    def test_is_valid_shamsi_date_invalid(self):
        """Invalid Shamsi dates should return False."""
        assert is_valid_shamsi_date("invalid") is False
        assert is_valid_shamsi_date("1402/13/01") is False
        assert is_valid_shamsi_date("1402/01/32") is False

    def test_parse_shamsi_date_valid(self):
        """Parse valid Shamsi date."""
        result = parse_shamsi_date("1402/10/11")
        assert isinstance(result, datetime)
        assert result.year == 2024

    def test_parse_shamsi_date_none(self):
        """Parse None or empty string should return None."""
        assert parse_shamsi_date(None) is None
        assert parse_shamsi_date("") is None


class TestHelpers:
    """Test helper functions."""

    def test_format_shamsi_alias(self):
        """format_shamsi should be an alias for to_shamsi."""
        dt = datetime(2024, 1, 1)
        assert format_shamsi(dt) == to_shamsi(dt)

    def test_shamsi_now(self):
        """shamsi_now should return current date in Shamsi format."""
        result = shamsi_now()
        assert isinstance(result, str)
        assert "/" in result
        parts = result.split("/")
        assert len(parts) == 3
        assert all(p.isdigit() for p in parts)
        # Year should be around 1402-1403
        year = int(parts[0])
        assert 1400 <= year <= 1410

    def test_get_shamsi_range(self):
        """Get Shamsi date range as Gregorian datetimes."""
        start_shamsi = "1402/01/01"
        end_shamsi = "1402/12/29"
        start, end = get_shamsi_range(start_shamsi, end_shamsi)
        assert isinstance(start, datetime)
        assert isinstance(end, datetime)
        assert start < end

    def test_gregorian_to_shamsi_range_inclusive(self):
        """Convert Gregorian range to Shamsi range."""
        start = datetime(2024, 1, 1)
        end = datetime(2024, 12, 31)
        start_shamsi, end_shamsi = gregorian_to_shamsi_range_inclusive(start, end)
        assert isinstance(start_shamsi, str)
        assert isinstance(end_shamsi, str)
        assert "/" in start_shamsi
        assert "/" in end_shamsi


class TestEdgeCases:
    """Test edge cases and boundary conditions."""

    def test_leap_year_handling(self):
        """Handle Gregorian leap year dates correctly."""
        # Feb 29, 2024 (leap year)
        dt = datetime(2024, 2, 29)
        shamsi = to_shamsi(dt)
        back = to_gregorian(shamsi)
        assert back.date() == dt.date()

    def test_year_boundary(self):
        """Handle year boundaries correctly."""
        # Last day of Gregorian year
        dt = datetime(2024, 12, 31)
        shamsi = to_shamsi(dt)
        back = to_gregorian(shamsi)
        assert back.date() == dt.date()

    def test_first_day_of_shamsi_year(self):
        """Handle first day of Shamsi year (usually March 20 or 21)."""
        shamsi = "1403/01/01"
        gregorian = to_gregorian(shamsi)
        assert gregorian.date() == date(2024, 3, 20)

    def test_last_day_of_shamsi_month(self):
        """Handle last day of Shamsi month."""
        shamsi = "1402/12/29"
        gregorian = to_gregorian(shamsi)
        # Last day of 12th month in 1402
        back = to_shamsi(gregorian)
        assert back == shamsi


class TestDateTimePreservation:
    """Test how time components are handled."""

    def test_time_normalized_to_midnight(self):
        """Conversion should normalize time to midnight UTC."""
        dt = datetime(2024, 1, 1, 14, 30, 45)
        shamsi = to_shamsi(dt)
        back = to_gregorian(shamsi)
        # Time should be midnight
        assert back.hour == 0
        assert back.minute == 0
        assert back.second == 0

    def test_microseconds_ignored(self):
        """Microseconds should be ignored."""
        dt1 = datetime(2024, 1, 1, 0, 0, 0, 0)
        dt2 = datetime(2024, 1, 1, 0, 0, 0, 999999)
        assert to_shamsi(dt1) == to_shamsi(dt2)


