class TestDateInputValidation:
    """Test that date inputs are properly validated."""

    def test_invalid_shamsi_date_rejected(self, test_session):
        """Invalid Shamsi dates should be rejected."""
        person = crud.create_person(
            test_session,
            schemas.PersonCreate(name="Test")
        )
        
        # Try to create payment with invalid Shamsi date
        with pytest.raises(Exception):  # Should raise ValueError or similar
            payload = schemas.PaymentCreate(
                direction="out",
                party_id=person.id,
                party_name=person.name,
                amount=1000,
                due_date="1402/13/01",  # Invalid month
                client_calendar="jalali"
            )
            crud.create_payment_manual(test_session, payload)

    def test_shamsi_date_boundary_validation(self, test_session):
        """Shamsi dates should be validated for valid ranges."""
        from app.utils.date import is_valid_shamsi_date
        
        assert is_valid_shamsi_date("1402/12/30") is True
        assert is_valid_shamsi_date("1402/01/01") is True
        assert is_valid_shamsi_date("1402/13/01") is False


class TestDateTimeRoundTrip:
    """Test round-trip conversion through API."""

    def test_invoice_date_round_trip(self, test_session):
        """Create invoice with Shamsi date, verify round-trip."""
        person = crud.create_person(
            test_session,
            schemas.PersonCreate(name="Test")
        )
        product = crud.create_product(
            test_session,
            schemas.ProductCreate(name="Product")
        )
        
        # Input Shamsi date
        input_date = "1402/10/15"
        
        payload = schemas.InvoiceCreate(
            invoice_type="sale",
            party_id=person.id,
            party_name=person.name,
            client_time=input_date,
            client_calendar="jalali",
            items=[
                schemas.InvoiceItemCreate(
                    description="Item",
                    quantity=1,
                    unit="pcs",
                    unit_price=1000,
                    product_id=product.id
                )
            ]
        )
        
        invoice = crud.create_invoice_manual(test_session, payload)
        
        # Verify stored in Gregorian
        assert invoice.client_time is not None
        assert isinstance(invoice.client_time, datetime)
        
        # Convert back to schema (should get Shamsi)
        invoice_out = schemas.InvoiceOut.from_orm(invoice)
        assert hasattr(invoice_out, 'client_time_shamsi')


