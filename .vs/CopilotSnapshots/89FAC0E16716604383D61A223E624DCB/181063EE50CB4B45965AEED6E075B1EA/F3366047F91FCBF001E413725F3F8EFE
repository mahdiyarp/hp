class TestFiscalYearDates:
    """Test fiscal year endpoints with Shamsi dates."""

    def test_create_fiscal_year_with_shamsi_dates(self, test_session):
        """Create fiscal year with Shamsi date input."""
        from app.accounting import fiscal_service
        
        fy = fiscal_service.create_fiscal_year(
            test_session,
            title="FY Test",
            start_date="1402/01/01",
            end_date="1402/12/30",
            is_current=True
        )
        
        assert fy is not None
        assert fy.title == "FY Test"
        # Dates should be stored in Gregorian in database
        assert fy.start_date is not None
        assert fy.end_date is not None

    def test_fiscal_year_date_boundaries(self, test_session):
        """Test fiscal year respects date boundaries."""
        from app.accounting import fiscal_service
        
        fy = fiscal_service.create_fiscal_year(
            test_session,
            title="FY 1402",
            start_date="1402/01/01",
            end_date="1402/12/30",
            is_current=True
        )
        
        # Should be able to create entries within boundaries
        try:
            entry_date = datetime(2023, 3, 20)  # ~1402/01/01
            fiscal_service.ensure_fiscal_year_allows_posting(test_session, entry_date)
        except Exception as e:
            pytest.fail(f"Should allow posting within fiscal year: {e}")


class TestInvoiceDates:
    """Test invoice endpoints with Shamsi dates."""

    def test_invoice_accepts_shamsi_client_time(self, test_session):
        """Invoice creation should accept Shamsi date for client_time."""
        # Setup
        person = crud.create_person(
            test_session,
            schemas.PersonCreate(name="Test Customer")
        )
        product = crud.create_product(
            test_session,
            schemas.ProductCreate(name="Test Product", unit="pcs")
        )
        
        # Create invoice with Shamsi date
        payload = schemas.InvoiceCreate(
            invoice_type="sale",
            mode="manual",
            party_id=person.id,
            party_name=person.name,
            client_time="1402/10/15",  # Shamsi format
            client_calendar="jalali",
            items=[
                schemas.InvoiceItemCreate(
                    description="Test Item",
                    quantity=1,
                    unit="pcs",
