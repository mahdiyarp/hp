import React, { useEffect, useState } from 'react'
import { apiGet } from '../../services/api'
import ChartRenderer from './ChartRenderer'

export default function ReportViewer() {
  const [summary, setSummary] = useState<any | null>(null)
  const [series, setSeries] = useState<any[]>([])
  const [loading, setLoading] = useState(true)

  useEffect(() => { load() }, [])

  async function load() {
    setLoading(true)
    try {
      const res = await apiGet('/api/reports/sales')
      setSummary(res.summary)
      setSeries(res.series?.series || [])
    } catch (e) {
      console.error(e)
    } finally { setLoading(false) }
  }

  return (
    <div>
      {loading ? <div>در حال بارگذاری...</div> : (
        <div className="grid grid-cols-1 lg:grid-cols-3 gap-4">
          <div className="col-span-2">
            <ChartRenderer data={series} />
          </div>
          <div className="p-3 border bg-[#faf4de]">
            <h3 className="font-semibold">خلاصه</h3>
            <pre className="text-xs">{JSON.stringify(summary, null, 2)}</pre>
          </div>
        </div>
      )}
    </div>
  )
}
