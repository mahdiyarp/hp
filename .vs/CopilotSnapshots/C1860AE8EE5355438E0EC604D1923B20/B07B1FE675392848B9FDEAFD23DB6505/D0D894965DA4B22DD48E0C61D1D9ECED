import React from 'react'
import { Line } from 'recharts'
import { ResponsiveContainer, LineChart, XAxis, YAxis, Tooltip } from 'recharts'

export default function ChartRenderer({ data }: { data: any[] }) {
  const mapped = (data || []).map((d: any) => ({ date: d.date, value: d.total }))
  return (
    <div style={{ height: 320 }} className="border bg-white p-2">
      <ResponsiveContainer width="100%" height="100%">
        <LineChart data={mapped}>
          <XAxis dataKey="date" tick={{ fontSize: 10 }} />
          <YAxis />
          <Tooltip />
          <Line type="monotone" dataKey="value" stroke="#1f2e3b" strokeWidth={2} />
        </LineChart>
      </ResponsiveContainer>
    </div>
  )
}
