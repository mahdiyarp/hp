server {
  listen 3000;
  server_name _;
  root /usr/share/nginx/html;
  index index.html;

  # Helpful safety and performance tweaks
  sendfile off;
  tcp_nopush on;
  tcp_nodelay on;

  # Ensure correct MIME types for webfonts
  types {
    font/woff2 woff2;
    font/woff woff;
    font/ttf ttf;
    font/otf otf;
    application/vnd.ms-fontobject eot;
    image/svg+xml svg;
  }

  # Serve fonts directly and allow cross-origin access
  location ~* \.(?:woff2|woff|ttf|otf|eot|svg)$ {
    try_files $uri =404;
    access_log off;
    add_header Cache-Control "public, max-age=31536000, immutable" always;
    add_header Access-Control-Allow-Origin "*" always;
    add_header Access-Control-Allow-Methods "GET, OPTIONS" always;
    add_header Access-Control-Allow-Headers "Origin, Accept, Content-Type" always;
    # prevent nginx from setting charset for binary
    default_type application/octet-stream;
  }

  # Serve other static assets with long cache
  location ~* \.(?:css|js|png|jpg|jpeg|gif|ico|json)$ {
    try_files $uri =404;
    access_log off;
    add_header Cache-Control "public, max-age=31536000" always;
  }

  location / {
    try_files $uri $uri/ /index.html;
    add_header Cache-Control 'no-store, no-cache, must-revalidate, proxy-revalidate' always;
    add_header Pragma 'no-cache' always;
    add_header Expires '0' always;
  }

  location /api/ {
    proxy_pass http://backend:8000/api/;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
  }
}

