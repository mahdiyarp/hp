    - require_roles(role_names=['Admin'])  # ظپظ‚ط· Admin (ظ†ط§ظ…)
    """
    def _dependency(current_user: models.User = Depends(get_current_user)):
        if not current_user.role_id:
            raise HTTPException(status_code=403, detail='ع©ط§ط±ط¨ط± ظ†ظ‚ط´غŒ ظ†ط¯ط§ط±ط¯')
        
