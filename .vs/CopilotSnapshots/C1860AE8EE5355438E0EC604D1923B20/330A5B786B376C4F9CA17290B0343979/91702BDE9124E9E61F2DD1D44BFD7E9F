def _start_backup_scheduler():
    global BACKUP_SCHEDULER_STARTED
    if BACKUP_INTERVAL_MIN <= 0 or BACKUP_SCHEDULER_STARTED:
        return
    BACKUP_SCHEDULER_STARTED = True

    def _loop():
        while True:
            time.sleep(BACKUP_INTERVAL_MIN * 60)
            session = db.SessionLocal()
            try:
                create_scheduled_backup(session, note='Auto-scheduled snapshot')
                LOGGER.info('Scheduled backup created by scheduler')
            except Exception as exc:
                LOGGER.warning('Scheduled backup failed: %s', exc)
            finally:
                try:
                    session.close()
                except Exception:
                    pass

    thread = threading.Thread(target=_loop, daemon=True, name='backup-scheduler')
    thread.start()


