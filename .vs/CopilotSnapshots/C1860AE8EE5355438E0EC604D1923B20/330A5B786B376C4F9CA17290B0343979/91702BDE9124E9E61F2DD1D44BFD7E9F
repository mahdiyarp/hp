        if role_names and current_user.role_obj:
            if current_user.role_obj.name not in role_names:
                raise HTTPException(status_code=403, detail='ط´ظ…ط§ ط¯ط³طھط±ط³غŒ ظ†ط¯ط§ط±غŒط¯')
        
        return current_user
    return _dependency


def require_permissions(permission_names: List[str]):
    """ط¨ط±ط±ط³غŒ ط¯ط³طھط±ط³غŒ ط¨ط± ط§ط³ط§ط³ ظ†ط§ظ… permission
    
    ط§ط³طھظپط§ط¯ظ‡:
    - require_permissions(['finance_view'])  # ظ…ط´ط§ظ‡ط¯ظ‡ ظ…ط§ظ„غŒ
    - require_permissions(['sales_create', 'sales_edit'])  # ط§غŒط¬ط§ط¯ غŒط§ ظˆغŒط±ط§غŒط´ ظپط±ظˆط´
    """
    def _dependency(current_user: models.User = Depends(get_current_user)):
        if not current_user.role_id or not current_user.role_obj:
            raise HTTPException(status_code=403, detail='ع©ط§ط±ط¨ط± ظ†ظ‚ط´غŒ ظ†ط¯ط§ط±ط¯')
        
        user_perm_names = set(p.name for p in (current_user.role_obj.permissions or []))
        required_perms = set(permission_names)
        
        # Check if user has at least one of the required permissions
        if not user_perm_names & required_perms:
            raise HTTPException(status_code=403, detail=f'ط´ظ…ط§ ط¯ط³طھط±ط³غŒ ظ†ط¯ط§ط±غŒط¯. ظ†غŒط§ط² ط¨ظ‡ غŒع©غŒ ط§ط² ط§غŒظ† ط¯ط³طھط±ط³غŒâ€Œظ‡ط§: {", ".join(permission_names)}')
        
        return current_user
    return _dependency


