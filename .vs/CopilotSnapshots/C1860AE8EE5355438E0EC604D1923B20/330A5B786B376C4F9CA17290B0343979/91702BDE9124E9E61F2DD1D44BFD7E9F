# Ensure responses include explicit utf-8 charset where appropriate
@app.middleware("http")
async def ensure_charset_middleware(request: Request, call_next):
    response = await call_next(request)
    try:
        ct = response.headers.get('content-type')
        if ct:
            if 'charset' not in ct.lower():
                # Append charset for textual/media types only
                if ct.startswith('application/json') or ct.startswith('text/') or 'application/' in ct:
                    response.headers['content-type'] = f"{ct}; charset=utf-8"
        else:
            # Fallback: if response has media_type attribute, set sensible default
            mt = getattr(response, 'media_type', None)
            if mt and ('json' in mt or mt.startswith('text/')):
                response.headers['content-type'] = f"{mt}; charset=utf-8"
    except Exception:
        # do not break responses on header manipulation issues
        pass
    return response

# No-cache middleware: add Cache-Control headers for static/html/json responses
@app.middleware("http")
async def no_cache_middleware(request: Request, call_next):
    response = await call_next(request)
    try:
        # Only set no-cache for textual responses to avoid interfering with binary downloads
        ct = response.headers.get('content-type', '')
        if ct and (ct.startswith('text/') or 'json' in ct):
            response.headers['Cache-Control'] = 'no-cache, no-store, must-revalidate'
            response.headers['Pragma'] = 'no-cache'
            response.headers['Expires'] = '0'
    except Exception:
        pass
    return response

