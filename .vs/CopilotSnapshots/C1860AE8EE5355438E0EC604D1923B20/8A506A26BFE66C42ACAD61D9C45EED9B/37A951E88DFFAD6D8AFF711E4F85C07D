/* Force IranYekan selectively to UI elements to avoid layout regressions */
body, .hp-card, .retroPanel, .retroPanelPadded, .widget-container, .dashboard, .dashboard * {
  font-family: "IranYekan", "Vazirmatn", sans-serif !important;
  direction: rtl;
}

/* Respect third-party library rendering but prefer IranYekan for typography */
.ant-typography,
.MuiTypography-root,
button,
input,
textarea,
table,
.chart-label {
  font-family: "IranYekan", "Vazirmatn", sans-serif !important;
}
