from time import time
from threading import Lock
from typing import Optional


class SimpleRateLimiter:
    """In-memory token-bucket like rate limiter per key.

    Not suitable for multi-process production; OK for dev/tests.
    """

    def __init__(self):
        # store state: key -> (tokens, last_ts, rate_per_min)
        self._store = {}
        self._lock = Lock()

    def _now(self) -> float:
        return time()

    def allow(self, key: str, rate_per_min: int, burst: Optional[int] = None) -> bool:
        """Check and consume a token for `key`.

        rate_per_min: allowed tokens per minute
        burst: maximum burst tokens (defaults to rate_per_min)
        """
        if not key:
            return False
        if rate_per_min <= 0:
            return False
        with self._lock:
            now = self._now()
            rate_per_sec = rate_per_min / 60.0
            max_tokens = burst if burst and burst > 0 else rate_per_min
            tokens, last_ts, configured = self._store.get(key, (max_tokens, now, rate_per_min))
            # refill
            elapsed = max(0.0, now - last_ts)
            refill = elapsed * rate_per_sec
            tokens = min(max_tokens, tokens + refill)
            if tokens >= 1.0:
                tokens -= 1.0
                self._store[key] = (tokens, now, rate_per_min)
                return True
            else:
                # update last_ts for bookkeeping
                self._store[key] = (tokens, now, rate_per_min)
                return False


# Redis-backed limiter optional
try:
    import redis
except Exception:
    redis = None


class RedisRateLimiter:
    """Redis-backed rate limiter using simple token bucket via INCR/EXPIRE.

    Note: This is a lightweight implementation and may allow minor bursts across processes.
    """

    def __init__(self, redis_url: str | None):
        if not redis:
            raise RuntimeError('redis package not available')
        self._r = redis.from_url(redis_url or 'redis://localhost:6379/0')

    def allow(self, key: str, rate_per_min: int, burst: Optional[int] = None) -> bool:
        if not key or rate_per_min <= 0:
            return False
        max_tokens = burst if burst and burst > 0 else rate_per_min
        # window is 60s for per-minute rate. We'll use a sliding window approximation via counters per-second bucket.
        window = 60
        # simple: track tokens consumed in current window
        redis_key = f"rate:{key}"
        p = self._r.pipeline()
        p.incr(redis_key, amount=1)
        p.expire(redis_key, window)
        val, _ = p.execute()
        try:
            val = int(val)
        except Exception:
            return False
        # allow if val <= max_tokens
        return val <= max_tokens


# module-level chooser
_limiter_impl = None
_limiter = None


def get_limiter():
    global _limiter_impl, _limiter
    if _limiter is not None:
        return _limiter
    # prefer Redis if REDIS_URL provided in env
    import os
    redis_url = os.getenv('REDIS_URL')
    if redis_url and redis:
        try:
            _limiter = RedisRateLimiter(redis_url)
            _limiter_impl = 'redis'
            return _limiter
        except Exception:
            pass
    _limiter = SimpleRateLimiter()
    _limiter_impl = 'memory'
    return _limiter


# convenience singleton
limiter = get_limiter()
