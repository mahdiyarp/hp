from time import time
from threading import Lock
from typing import Optional


class SimpleRateLimiter:
    """In-memory token-bucket like rate limiter per key.

    Not suitable for multi-process production; OK for dev/tests.
    """

    def __init__(self):
        # store state: key -> (tokens, last_ts, rate_per_min)
        self._store = {}
        self._lock = Lock()

    def _now(self) -> float:
        return time()

    def allow(self, key: str, rate_per_min: int, burst: Optional[int] = None) -> bool:
        """Check and consume a token for `key`.

        rate_per_min: allowed tokens per minute
        burst: maximum burst tokens (defaults to rate_per_min)
        """
        if not key:
            return False
        if rate_per_min <= 0:
            return False
        with self._lock:
            now = self._now()
            rate_per_sec = rate_per_min / 60.0
            max_tokens = burst if burst and burst > 0 else rate_per_min
            tokens, last_ts, configured = self._store.get(key, (max_tokens, now, rate_per_min))
            # refill
            elapsed = max(0.0, now - last_ts)
            refill = elapsed * rate_per_sec
            tokens = min(max_tokens, tokens + refill)
            if tokens >= 1.0:
                tokens -= 1.0
                self._store[key] = (tokens, now, rate_per_min)
                return True
            else:
                # update last_ts for bookkeeping
                self._store[key] = (tokens, now, rate_per_min)
                return False


# module-level singleton
limiter = SimpleRateLimiter()
