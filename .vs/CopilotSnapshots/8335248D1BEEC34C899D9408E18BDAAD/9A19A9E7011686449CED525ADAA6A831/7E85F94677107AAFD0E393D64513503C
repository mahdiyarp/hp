version: '3.9'
services:
  db:
    image: postgres:15-alpine
    environment:
      POSTGRES_USER: postgres
      POSTGRES_PASSWORD: postgres
      POSTGRES_DB: hesabpak
    volumes:
      - db_data:/var/lib/postgresql/data

  redis:
    image: redis:7-alpine
    container_name: hesabpak_redis
    ports:
      - '6379:6379'
    restart: unless-stopped

  backend:
    build:
      context: ./backend
    container_name: hesabpak_backend
    ports:
      - '8000:8000'
    env_file:
      - ./backend/.env
    environment:
      DEMO_SEED: "true"
      # point backend to local redis
      REDIS_URL: "redis://redis:6379/0"
    depends_on:
      - db
      - redis
    restart: unless-stopped

  frontend:
    build:
      context: ./frontend
    container_name: hesabpak_frontend
    ports:
      - '3000:3000'
    depends_on:
      - backend

volumes:
  db_data:
