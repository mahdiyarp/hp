#!/bin/bash

###############################################
# HesabPak - سیستم حسابداری فارسی
# راه‌اندازی سریع برای Linux و macOS
###############################################

set -e

cd "$(dirname "${BASH_SOURCE[0]}")"

echo ""
echo "╔════════════════════════════════════════════════╗"
echo "║   HesabPak - سیستم حسابداری حساب‌پاک         ║"
echo "║   راه‌اندازی خودکار سرویس‌ها                  ║"
echo "╚════════════════════════════════════════════════╝"
echo ""

# بررسی Docker
if ! command -v docker &> /dev/null; then
    echo "❌ خطا: Docker یافت نشد"
    echo "📥 لطفا Docker را دانلود و نصب کنید:"
    echo "   https://www.docker.com/products/docker-desktop"
    exit 1
fi

# بررسی Docker daemon
if ! docker ps &> /dev/null; then
    echo "⚠️  هشدار: Docker daemon در حال اجرا نیست"
    echo "🔄 لطفا Docker Desktop را راه‌اندازی کنید"
    exit 1
fi

# شروع سرویس‌ها
echo "🚀 راه‌اندازی سرویس‌ها..."
docker compose up -d --build

if [ "$?" -ne 0 ]; then
    echo ""
    echo "❌ خطا: شروع سرویس‌ها ناموفق بود"
    echo "📋 دستور خروج: docker compose down"
    exit 1
fi

# منتظر راه‌اندازی سرویس‌ها
echo ""
echo "⏳ صبر برای آماده شدن سرویس‌ها (تا 30 ثانیه)..."
sleep 30

echo ""
echo "╔════════════════════════════════════════════════╗"
echo "║        ✓ سرویس‌های HesabPak شروع شدند        ║"
echo "╚════════════════════════════════════════════════╝"
echo ""
echo "📱 رابط کاربری وب:"
echo "   👉 http://localhost:3000"
echo ""
echo "📚 مستندات API (Swagger):"
echo "   👉 http://localhost:8000/docs"
echo ""
echo "🔑 اطلاعات ورود پیش‌فرض:"
echo "   نام کاربری: developer"
echo "   رمز عبور: 09123506545"
echo ""
echo "📛 تنظیمات پایگاه‌داده:"
echo "   Host: db:5432"
echo "   نام: hesabpak"
echo "   کاربر: postgres"
echo "   رمز: postgres"
echo ""
echo "🛑 متوقف کردن سرویس‌ها:"
echo "   دستور: docker compose down"
echo ""
echo "⏱️  برای توقف، Ctrl+C را فشار دهید"
echo ""

# باز کردن مرورگر
echo "🌐 باز کردن رابط کاربری..."
if command -v xdg-open &> /dev/null; then
    xdg-open "http://localhost:3000" &
elif command -v open &> /dev/null; then
    open "http://localhost:3000" &
fi

# نمایش لاگ‌ها
docker compose logs -f
