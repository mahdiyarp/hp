#!/usr/bin/env python3
"""
اسکریپت بررسی وضعیت HesabPak
"""

import os
import sys
from pathlib import Path

def check_project_structure():
    """بررسی ساختار پروژه"""
    print("=" * 60)
    print("🔍 بررسی ساختار HesabPak")
    print("=" * 60)
    
    root = Path(__file__).parent
    
    checks = {
        "Backend": [
            "backend/requirements.txt",
            "backend/Dockerfile",
            "backend/entrypoint.sh",
            "backend/app/main.py",
            "backend/.env",
        ],
        "Frontend": [
            "frontend/package.json",
            "frontend/Dockerfile",
            "frontend/nginx.conf",
            "frontend/src/main.tsx",
            "frontend/tsconfig.json",
        ],
        "Docker": [
            "docker-compose.yml",
            "start.bat",
            "start.sh",
        ],
        "Config": [
            ".env",
            ".env.run",
            "README.md",
        ],
    }
    
    total_ok = 0
    total_missing = 0
    
    for category, files in checks.items():
        print(f"\n📦 {category}:")
        for file in files:
            path = root / file
            if path.exists():
                size = path.stat().st_size if path.is_file() else "DIR"
                print(f"  ✅ {file} ({size} bytes)" if size != "DIR" else f"  ✅ {file}")
                total_ok += 1
            else:
                print(f"  ❌ {file} - یافت نشد")
                total_missing += 1
    
    print("\n" + "=" * 60)
    print(f"📊 نتیجه: {total_ok} ✅ | {total_missing} ❌")
    print("=" * 60)
    
    return total_missing == 0

if __name__ == "__main__":
    success = check_project_structure()
    sys.exit(0 if success else 1)
