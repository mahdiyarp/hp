@echo off
REM ==================================================
REM HesabPak - سیستم حسابداری فارسی
REM راه‌اندازی سریع برای Windows
REM ==================================================

chcp 65001 >nul
setlocal enabledelayedexpansion

cd /d "%~dp0"

echo.
echo ╔════════════════════════════════════════════════╗
echo ║   HesabPak - سیستم حسابداری حساب‌پاک         ║
echo ║   راه‌اندازی خودکار سرویس‌ها                  ║
echo ╚════════════════════════════════════════════════╝
echo.

REM بررسی Docker
docker ps >nul 2>nul
if errorlevel 1 (
    echo ⚠️  هشدار: Docker در حال اجرا نیست
    echo 🔄 تلاش برای راه‌اندازی Docker Desktop...
    if exist "C:\Program Files\Docker\Docker\Docker.exe" (
        start "" "C:\Program Files\Docker\Docker\Docker.exe"
        echo ⏳ صبر برای راه‌اندازی Docker...
        timeout /t 15 /nobreak
    ) else (
        echo ❌ خطا: Docker Desktop یافت نشد
        echo 📥 لطفا Docker را از اینجا دانلود کنید:
        echo    https://www.docker.com/products/docker-desktop
        pause
        exit /b 1
    )
)

REM شروع سرویس‌ها
echo 🚀 راه‌اندازی سرویس‌ها...
docker compose up -d --build

if errorlevel 1 (
    echo.
    echo ❌ خطا: شروع سرویس‌ها ناموفق بود
    echo 📋 دستور خروج: docker compose down
    pause
    exit /b 1
)

REM منتظر راه‌اندازی سرویس‌ها
echo.
echo ⏳ صبر برای آماده شدن سرویس‌ها (تا 30 ثانیه)...
timeout /t 30 /nobreak

echo.
echo ╔════════════════════════════════════════════════╗
echo ║        ✓ سرویس‌های HesabPak شروع شدند        ║
echo ╚════════════════════════════════════════════════╝
echo.
echo 📱 رابط کاربری وب:
echo    👉 http://localhost:3000
echo.
echo 📚 مستندات API (Swagger):
echo    👉 http://localhost:8000/docs
echo.
echo 🔑 اطلاعات ورود پیش‌فرض:
echo    نام کاربری: developer
echo    رمز عبور: 09123506545
echo.
echo 📛 تنظیمات پایگاه‌داده:
echo    Host: db:5432
echo    نام: hesabpak
echo    کاربر: postgres
echo    رمز: postgres
echo.
echo 🛑 متوقف کردن سرویس‌ها:
echo    دستور: docker compose down
echo.
echo ⏱️  این پنجره را باز نگه دارید تا سرویس‌ها فعال بمانند
echo.

REM باز کردن مرورگر
echo 🌐 باز کردن رابط کاربری...
start "" "http://localhost:3000" 2>NUL || (
    if exist "%SystemRoot%\explorer.exe" (
        "%SystemRoot%\explorer.exe" "http://localhost:3000"
    )
)

echo.
echo ⏸️  برای توقف، کلید Ctrl+C را فشار دهید یا این پنجره را بسته‌اید.
echo.
pause
