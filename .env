# HesabPak Environment Configuration
# Copy this file to .env and update values as needed

# Application
BRANCH=1
APP_NAME=HesabPak
APP_ENV=production

# Database
DB_USER=hesabpak
DB_PASS=secure_password_123
DB_NAME=hesabpak_db
DB_HOST=db
DB_PORT=5432

# Developer Account (Default)
DEVELOPER_USER=developer
DEVELOPER_PASS=88808881
DEVELOPER_MOBILE=88808881

# Server Configuration
BACKEND_PORT=8881
FRONTEND_PORT=8880

# JWT Secret (Change this in production!)
JWT_SECRET=your-super-secret-key-change-this-in-production

# CORS
CORS_ORIGINS=http://localhost:8880,http://localhost:8881

# Email (Optional)
SMTP_SERVER=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# SMS Provider (Optional)
SMS_PROVIDER=
SMS_API_KEY=

# File Upload
MAX_UPLOAD_SIZE=52428800
UPLOAD_DIR=./uploads

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log