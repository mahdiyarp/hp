def clone_default_phases() -> List[Dict]:
    return json.loads(json.dumps(DEFAULT_PHASES))


def ensure_dirs() -> None:
    ROADMAP_DIR.mkdir(parents=True, exist_ok=True)
    GENERATED_PAGE_DIR.mkdir(parents=True, exist_ok=True)
    PHASE_DOCS_DIR.mkdir(parents=True, exist_ok=True)


def slugify(value: str) -> str:
    cleaned = re.sub(r"[^\w-]+", "-", value, flags=re.UNICODE)
    cleaned = re.sub(r"-+", "-", cleaned).strip("-")
    return cleaned or "phase"


def parse_markers_from_text(text: str) -> Set[str]:
    pattern = re.compile(r"DONE:([A-Za-z0-9._-]+)", re.IGNORECASE)
    return {m.group(1).upper() for m in pattern.finditer(text or "")}


def extract_done_markers_from_commits(limit: int = 50) -> Set[str]:
    try:
        proc = subprocess.run(
            ["git", "log", f"-{limit}", "--pretty=%B"],
            cwd=PROJECT_ROOT,
            capture_output=True,
            text=True,
            check=True,
        )
    except Exception:
        return set()
    return parse_markers_from_text(proc.stdout)


def load_roadmap() -> Dict:
    if ROADMAP_JSON.exists():
        try:
            data = json.loads(ROADMAP_JSON.read_text(encoding="utf-8"))
        except Exception:
            data = {}
    else:
        data = {}
    if "phases" not in data:
        data["phases"] = clone_default_phases()
    data.setdefault("project", "NeuroChainX")
    data.setdefault("version", "v1")
    data.setdefault("notes", "Auto-generated by roadmap_sync")
    return data


def normalize_roadmap(roadmap: Dict) -> None:
    for phase in roadmap.get("phases", []):
        phase.setdefault("status", "pending")
        phase.setdefault("percent", 0)
        phase.setdefault("fibonacci_weight", 1)
        phase.setdefault("dependencies", [])
        phase.setdefault("milestones", [])
        for m in phase["milestones"]:
            m["done"] = bool(m.get("done", False))
            m["task"] = m.get("task", "").strip()
    roadmap["phases"] = sorted(roadmap.get("phases", []), key=lambda p: p.get("id", 0))


def apply_done_markers(roadmap: Dict, markers: Set[str]) -> List[str]:
    applied: List[str] = []
    normalized = {m.upper().strip() for m in markers if m}
    if not normalized:
        return applied
    for phase in roadmap.get("phases", []):
        for m in phase.get("milestones", []):
            mid = str(m.get("id") or "").upper()
            if mid in normalized and not m.get("done"):
                m["done"] = True
                applied.append(mid)
    return applied


def recalc_progress(roadmap: Dict) -> Dict:
    phases = roadmap.get("phases", [])
    total_weights = sum(p.get("fibonacci_weight", 1) for p in phases) or 1
    total_milestones = 0
    completed_milestones = 0
    for phase in phases:
        milestones = phase.get("milestones", [])
        total_milestones += len(milestones)
        done_count = sum(1 for m in milestones if m.get("done"))
        completed_milestones += done_count
        percent = round((done_count / len(milestones)) * 100, 2) if milestones else 0
        phase["percent"] = percent
        phase["milestones_total"] = len(milestones)
        phase["milestones_done"] = done_count
        if done_count == 0:
            phase["status"] = "pending"
        elif done_count == len(milestones):
            phase["status"] = "completed"
        else:
            phase["status"] = "in_progress"
    weighted = (
        sum((p.get("percent", 0) * p.get("fibonacci_weight", 1)) for p in phases) / total_weights
        if phases
        else 0
    )
    milestone_progress = (completed_milestones / total_milestones * 100) if total_milestones else 0
    now_iso = datetime.now(timezone.utc).isoformat()
    roadmap["overall_progress"] = round(weighted, 2)
    roadmap["overall_weighted_progress"] = roadmap["overall_progress"]
    roadmap["overall_milestone_progress"] = round(milestone_progress, 2)
    roadmap["phases_completed"] = sum(1 for p in phases if p.get("status") == "completed")
    roadmap["phases_in_progress"] = sum(1 for p in phases if p.get("status") == "in_progress")
    roadmap["phases_pending"] = sum(1 for p in phases if p.get("status") == "pending")
    roadmap["total_milestones"] = total_milestones
    roadmap["completed_milestones"] = completed_milestones
    roadmap["updated_at"] = now_iso
    return roadmap


def build_status_payload(roadmap: Dict, applied_markers: Set[str], sources: List[str]) -> Dict:
    source_list = sources or ["auto"]
    return {
        "project": roadmap.get("project", "NeuroChainX"),
        "overall_progress": roadmap.get("overall_progress", 0),
        "overall_weighted_progress": roadmap.get("overall_weighted_progress", roadmap.get("overall_progress", 0)),
        "overall_milestone_progress": roadmap.get("overall_milestone_progress", 0),
        "phases_completed": roadmap.get("phases_completed", 0),
        "phases_in_progress": roadmap.get("phases_in_progress", 0),
        "phases_pending": roadmap.get("phases_pending", 0),
        "total_milestones": roadmap.get("total_milestones", 0),
        "completed_milestones": roadmap.get("completed_milestones", 0),
        "updated_at": roadmap.get("updated_at"),
        "applied_markers": sorted(applied_markers),
        "sources": source_list,
        "phases": [
            {
                "id": p.get("id"),
                "code": p.get("code"),
                "name": p.get("name"),
                "status": p.get("status"),
                "percent": p.get("percent"),
                "fibonacci_weight": p.get("fibonacci_weight"),
                "milestones_total": p.get("milestones_total", len(p.get("milestones", []))),
                "milestones_done": p.get("milestones_done", 0),
            }
            for p in roadmap.get("phases", [])
        ],
    }


def write_json(path: Path, payload: Dict) -> None:
    path.write_text(json.dumps(payload, indent=2, ensure_ascii=False), encoding="utf-8")


def write_roadmap_md(roadmap: Dict, status_payload: Dict) -> None:
    status_map = {"pending": "در انتظار", "in_progress": "در حال انجام", "completed": "تکمیل\u200cشده"}
    lines: List[str] = []
    lines.append("# نقشه راه NeuroChainX")
    lines.append("")
    lines.append(f"آخرین به\u200cروزرسانی: {status_payload.get('updated_at')}")
    lines.append(
        f"پیشرفت وزنی کلی: {status_payload.get('overall_progress', 0)}%"
    )
    lines.append(
        f"تکمیل مایلستون: {status_payload.get('completed_milestones', 0)}/{status_payload.get('total_milestones', 0)} "
        f"({status_payload.get('overall_milestone_progress', 0)}%)"
    )
    lines.append("")
    lines.append("| فاز | وضعیت | ٪ | انجام/کل | وزن |")
    lines.append("| --- | --- | --- | --- | --- |")
    for p in roadmap.get("phases", []):
        st = status_map.get(str(p.get("status") or "").lower(), p.get("status"))
        lines.append(
            f"| {p.get('id')} - {p.get('name')} | {st} | {p.get('percent')}% | "
            f"{p.get('milestones_done')}/{p.get('milestones_total')} | {p.get('fibonacci_weight')} |"
        )
    lines.append("")
    lines.append("## جزئیات فازها")
    for p in roadmap.get("phases", []):
        lines.append(f"### {p.get('id'):02d} - {p.get('name')}")
        lines.append(
            f"وضعیت: {status_map.get(str(p.get('status') or '').lower(), p.get('status'))} ({p.get('percent')}%)، وزن: {p.get('fibonacci_weight')}، "
            f"وابستگی\u200cها: {', '.join(p.get('dependencies', []) or ['بدون وابستگی'])}"
        )
        if p.get("summary"):
            lines.append("")
            lines.append(p.get("summary"))
        lines.append("")
        lines.append("مایلستون\u200cها:")
        for m in p.get("milestones", []):
            prefix = "[x]" if m.get("done") else "[ ]"
            lines.append(f"- {prefix} {m.get('id')}: {m.get('task')}")
        if p.get("outcomes"):
            lines.append("")
            lines.append("خروجی\u200cهای مورد انتظار:")
            for o in p.get("outcomes", []):
                lines.append(f"- {o}")
        lines.append("")
    ROADMAP_MD.write_text("\n".join(lines), encoding="utf-8")


def write_phase_docs(roadmap: Dict) -> None:
    status_map = {"pending": "در انتظار", "in_progress": "در حال انجام", "completed": "تکمیل\u200cشده"}
    for phase in roadmap.get("phases", []):
        slug = slugify(phase.get("name", f"phase-{phase.get('id', '')}"))
        path = PHASE_DOCS_DIR / f"{phase.get('id'):02d}-{slug}.md"
        lines = [
            f"# فاز {phase.get('id'):02d} - {phase.get('name')}",
            "",
            f"وضعیت: {status_map.get(str(phase.get('status') or '').lower(), phase.get('status'))} ({phase.get('percent')}%)، وزن: {phase.get('fibonacci_weight')}",
            f"وابستگی\u200cها: {', '.join(phase.get('dependencies', []) or ['بدون وابستگی'])}",
            "",
            "## خلاصه",
            phase.get("summary", "—"),
            "",
            "## مایلستون\u200cها",
        ]
        for m in phase.get("milestones", []):
            prefix = "[x]" if m.get("done") else "[ ]"
            lines.append(f"- {prefix} {m.get('id')}: {m.get('task')}")
        lines.append("")
        lines.append("## خروجی\u200cهای مورد انتظار")
        for o in phase.get("outcomes", []) or ["(پس از مشخص شدن خروجی\u200cها تکمیل شود)"]:
            lines.append(f"- {o}")
        path.write_text("\n".join(lines) + "\n", encoding="utf-8")


def generate_live_html(roadmap: Dict, status_payload: Dict) -> None:
    payload = {"roadmap": roadmap, "status": status_payload}
    payload_json = json.dumps(payload, ensure_ascii=False).replace("</", "<\\/")
    html_template = """<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>نقشه راه NeuroChainX - زنده</title>
  <style>
    :root {
      --bg: #0b111a;
      --panel: #0f1724;
      --panel-2: #0b1220;
      --accent: #7c3aed;
      --accent-2: #22d3ee;
      --text: #e5e7eb;
      --muted: #94a3b8;
      --border: #1f2937;
    }
    * { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: 'Vazirmatn', 'IRANSans', 'Space Grotesk', 'Inter', system-ui, -apple-system, sans-serif;
      background: radial-gradient(circle at 20% 20%, rgba(124,58,237,0.12), transparent 30%), radial-gradient(circle at 80% 0%, rgba(34,211,238,0.1), transparent 25%), var(--bg);
      color: var(--text);
      min-height: 100vh;
      padding: 24px;
      direction: rtl;
      text-align: right;
    }
    .shell {
      max-width: 1200px;
      margin: 0 auto;
    }
    .hero {
      background: linear-gradient(135deg, rgba(124,58,237,0.25), rgba(34,211,238,0.2));
      border: 1px solid var(--border);
      border-radius: 18px;
      padding: 20px;
      box-shadow: 0 20px 60px rgba(0,0,0,0.35), 0 0 30px rgba(124,58,237,0.2);
    }
    .hero h1 { margin: 0 0 8px; letter-spacing: 0.5px; }
    .meta { display: flex; gap: 12px; flex-wrap: wrap; color: var(--muted); font-size: 14px; }
    .progress {
      position: relative;
      background: var(--panel);
      border: 1px solid var(--border);
      border-radius: 12px;
      margin: 20px 0 8px;
      height: 14px;
      overflow: hidden;
    }
    .progress span {
      position: absolute;
      inset: 0;
      background: linear-gradient(90deg, var(--accent), var(--accent-2));
      box-shadow: 0 0 24px rgba(124,58,237,0.3);
      transition: width 0.6s ease;
    }
    .cards { margin-top: 18px; display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 14px; }
    .card {
      background: var(--panel-2);
      border: 1px solid var(--border);
      border-radius: 14px;
      padding: 14px;
      box-shadow: 0 14px 40px rgba(0,0,0,0.25);
    }
    .card header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 8px;
    }
    .pill {
      padding: 2px 10px;
      border-radius: 999px;
      font-size: 12px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      border: 1px solid var(--border);
      background: rgba(255,255,255,0.05);
    }
    .pill.pending { color: #fbbf24; border-color: #f59e0b33; }
    .pill.in_progress { color: #60a5fa; border-color: #3b82f633; }
    .pill.completed { color: #34d399; border-color: #10b98133; }
    .milestones { margin-top: 8px; padding-left: 0; list-style: none; display: grid; gap: 6px; }
    .milestones li { display: flex; gap: 8px; align-items: flex-start; color: var(--muted); }
    .tick {
      width: 18px; height: 18px; border-radius: 4px; border: 1px solid var(--border); display: grid; place-items: center; font-size: 11px;
      background: rgba(124,58,237,0.12);
    }
    .tick.done { background: linear-gradient(135deg, #34d399, #22c55e); color: #0b111a; border-color: #34d399; }
    .footer { margin-top: 6px; color: var(--muted); font-size: 12px; }
    .last-updated { color: var(--muted); font-size: 13px; }
    @media (max-width: 640px) {
      body { padding: 14px; }
      .cards { grid-template-columns: 1fr; }
    }
  </style>
</head>
<body>
  <div class="shell">
    <div class="hero">
      <h1>نقشه راه NeuroChainX</h1>
      <div class="meta">
        <div id="overall-percent">--%</div>
        <div id="milestone-progress">--</div>
        <div id="phase-counts">--</div>
      </div>
      <div class="progress"><span id="overall-bar" style="width: 0%"></span></div>
      <div class="last-updated" id="last-updated">Last sync: --</div>
    </div>
    <div class="cards" id="phase-list"></div>
  </div>

<script>
const initialPayload = __PAYLOAD__;

function statusLabel(status) {
  const map = {
    pending: 'در انتظار',
    in_progress: 'در حال انجام',
    completed: 'تکمیل\u200cشده'
  };
  const key = (status || '').toLowerCase();
  return map[key] || status || 'نامشخص';
}

function percent(val) {
  const n = Number(val || 0);
  return Number.isFinite(n) ? Math.max(0, Math.min(100, n)) : 0;
}

function render(roadmap, status) {
  const phases = (roadmap && roadmap.phases) || [];
  const list = document.getElementById('phase-list');
  list.innerHTML = '';
  phases.forEach(p => {
    const card = document.createElement('div');
    card.className = 'card';
    const done = p.milestones_done || 0;
    const total = p.milestones_total || (p.milestones ? p.milestones.length : 0) || 0;
    const pct = percent(p.percent);
    card.innerHTML = `
      <header>
        <div>
          <div style="font-weight: 600">${String(p.id).padStart(2, '0')} - ${p.name || ''}</div>
          <div style="color: var(--muted); font-size: 12px;">${p.code || ''} - وزن ${p.fibonacci_weight || 0} - ${done}/${total} مایلستون</div>
        </div>
        <span class="pill ${p.status || 'pending'}">${statusLabel(p.status)}</span>
      </header>
      <div class="progress" style="margin: 10px 0 8px; height: 8px;"><span style="width:${pct}%"></span></div>
      <ul class="milestones">
        ${((p.milestones || []).map(m => {
          const flag = m.done ? 'done' : '';
          const tick = m.done ? '&#10003;' : '';
          return `<li><span class="tick ${flag}">${tick}</span><div><strong>${m.id}</strong> - ${m.task}</div></li>`;
        }).join(''))}
      </ul>
      <div class="footer">${p.summary || ''}</div>
    `;
    list.appendChild(card);
  });

  const overall = percent(status && status.overall_progress);
  document.getElementById('overall-bar').style.width = overall + '%';
  document.getElementById('overall-percent').textContent = `پیشرفت وزنی: ${overall.toFixed(1)}%`;
  document.getElementById('milestone-progress').textContent = `مایلستون: ${(status && status.completed_milestones) || 0}/${(status && status.total_milestones) || 0}`;
  document.getElementById('phase-counts').textContent = `فازها در انتظار/در حال انجام/تکمیل: ${(status && status.phases_pending) || 0} / ${(status && status.phases_in_progress) || 0} / ${(status && status.phases_completed) || 0}`;
  document.getElementById('last-updated').textContent = 'آخرین همگام\u200cسازی: ' + (status && status.updated_at ? status.updated_at : 'نامشخص');
}

async function refresh() {
  try {
    const [roadmapRes, statusRes] = await Promise.all([
      fetch('/roadmap/json'),
      fetch('/roadmap/status')
    ]);
    if (!roadmapRes.ok || !statusRes.ok) return;
    const roadmap = await roadmapRes.json();
    const status = await statusRes.json();
    render(roadmap, status);
  } catch (err) {
    console.warn('Roadmap live refresh failed', err);
  }
}

render(initialPayload.roadmap || {}, initialPayload.status || {});
refresh();
setInterval(refresh, 15000);
</script>
</body>
</html>
"""
    LIVE_HTML.write_text(html_template.replace("__PAYLOAD__", payload_json), encoding="utf-8")


def append_progress_log(status_payload: Dict, applied_markers: Set[str], sources: List[str]) -> None:
    ts = status_payload.get("updated_at") or datetime.now(timezone.utc).isoformat()
    markers = ", ".join(sorted(applied_markers)) if applied_markers else "none"
    src = ";".join(sources or ["auto"])
    line = (
        f"{ts}\toverall={status_payload.get('overall_progress', 0)}%"
        f"\tmilestones={status_payload.get('completed_milestones', 0)}/{status_payload.get('total_milestones', 0)}"
        f"\tsources={src}\tapplied={markers}\n"
    )
    with PROGRESS_LOG.open("a", encoding="utf-8") as fh:
        fh.write(line)


def run_sync(args: argparse.Namespace) -> Dict:
    ensure_dirs()
    roadmap = load_roadmap()
    if args.reset_defaults or not roadmap.get("phases"):
        roadmap["phases"] = clone_default_phases()
    normalize_roadmap(roadmap)
    markers: Set[str] = set()
    sources: List[str] = []

    if not args.no_commit_scan:
        commit_markers = extract_done_markers_from_commits(args.commit_limit)
        if commit_markers:
            markers.update(commit_markers)
            sources.append(f"git:{args.commit_limit}")

    if args.text:
        text_markers = parse_markers_from_text(args.text)
        if text_markers:
            markers.update(text_markers)
            sources.append("text")

    if args.markers:
        manual = set()
        for m in args.markers:
            m = m.strip()
            if not m:
                continue
            if m.upper().startswith("DONE:"):
                manual.add(m.split("DONE:", 1)[1].strip().upper())
            else:
                manual.add(m.upper())
        if manual:
            markers.update(manual)
            sources.append("manual")

    applied = apply_done_markers(roadmap, markers)
    recalc_progress(roadmap)
    status_payload = build_status_payload(roadmap, markers, sources)

    if args.dry_run:
        return {"roadmap": roadmap, "status": status_payload, "applied": applied}

    write_json(ROADMAP_JSON, roadmap)
    write_json(STATUS_JSON, status_payload)
    write_roadmap_md(roadmap, status_payload)
    write_phase_docs(roadmap)
    generate_live_html(roadmap, status_payload)
    append_progress_log(status_payload, markers, sources)

    return {"roadmap": roadmap, "status": status_payload, "applied": applied}


def main(argv: List[str] | None = None) -> None:
    parser = argparse.ArgumentParser(
        description="Sync NeuroChainX roadmap artifacts from milestone markers."
    )
    parser.add_argument(
        "--markers", nargs="*", default=[], help="Explicit DONE:<milestone_id> markers."
    )
    parser.add_argument(
        "--text", default="", help="Parse DONE markers from a text blob or commit message."
    )
    parser.add_argument(
        "--commit-limit",
        type=int,
        default=50,
        help="Number of commits to scan for DONE markers.",
    )
    parser.add_argument("--no-commit-scan", action="store_true", help="Skip git commit scanning.")
    parser.add_argument("--dry-run", action="store_true", help="Compute without writing files.")
    parser.add_argument(
        "--reset-defaults",
        action="store_true",
        help="جایگزینی فازها با مقادیر پیش‌فرض (مفید برای بازتولید از صفر).",
    )
    args = parser.parse_args(argv)

    result = run_sync(args)
    status = result["status"]
    applied = result["applied"]
    print(
        f"[roadmap_sync] overall={status.get('overall_progress')}% "
        f"milestones={status.get('completed_milestones')}/{status.get('total_milestones')} "
        f"applied={len(applied)} markers"
    )


if __name__ == "__main__":
    main()
