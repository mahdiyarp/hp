# Production environment variables for HesabPak backend
# ⚠️  CHANGE ALL SECRET VALUES BEFORE DEPLOYING TO PRODUCTION

# Database (PostgreSQL)
DATABASE_URL=postgresql+psycopg2://postgres:CHANGE_ME_IN_PRODUCTION@db:5432/hesabpak

# Redis Cache
REDIS_URL=redis://redis:6379/0

# Security - JWT
SECRET_KEY=CHANGE_ME_PLEASE_USE_STRONG_RANDOM_STRING
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com

# File Upload Security
MAX_UPLOAD_SIZE_MB=50
ALLOWED_UPLOAD_EXTENSIONS=.pdf,.jpg,.jpeg,.png,.xlsx,.csv

# Backup Configuration
BACKUP_RETENTION_DAYS=30
# Generate encryption key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
BACKUP_ENCRYPTION_KEY=

# Optional: Field-level database encryption
# Generate key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DATABASE_ENCRYPTION_KEY=

# Demo/Development Settings (set to false in production)
DEMO_SEED=false
DEBUG=false

# SMTP Email (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@hesabpak.local

# SMS Gateway (optional)
SMS_PROVIDER=
SMS_API_KEY=
SMS_SENDER=

# OpenAI API (optional - for AI features)
OPENAI_API_KEY=

# Application Info
APP_NAME=HesabPak
APP_VERSION=1.0.0
APP_ENV=production
