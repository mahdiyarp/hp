# Backend environment example
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=hesabpak
DATABASE_URL=postgresql+psycopg2://postgres:postgres@db:5432/hesabpak
SECRET_KEY=change-me-super-secret
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
JWT_ALGORITHM=HS256
MEILI_URL=http://meilisearch:7700
MEILI_KEY=
WORLD_TIME_API=https://worldtimeapi.org/api/timezone/Etc/UTC

# Background scheduler (disabled by default)
SCHEDULER_ENABLED=false
SCHEDULER_INTERVAL_SEC=300

# SMS provider settings stored in DB system_settings; these are here for reference only.
# Keys are typically saved encrypted in DB via admin UI.
# sms_provider=ippanel
# sms_api_key=<encrypted-or-plain>
# sms_sender=3000XXXX
