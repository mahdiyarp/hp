      ]
    },
    {
      "parameters": {
        "authentication": "none",
        "method": "POST",
        "url": "={{ ($env.LLM_BASE_URL || \"http://localhost:11434/v1\") + '/chat/completions' }}",
        "responseFormat": "json",
        "jsonParameters": true,
        "headerParametersUi": {
          "parameter": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Authorization",
              "value": "={{ $env.LLM_API_KEY ? 'Bearer ' + $env.LLM_API_KEY : '' }}"
            }
          ]
        },
        "bodyParametersJson": "={{ JSON.stringify({ model: $env.LLM_MODEL || 'llama-3-8b-instruct', temperature: 0.2, max_tokens: 400, messages: [ {role: 'system', content: 'You are a Persian accounting agent for Hesabpak. Respond only with JSON. Fields: action in [invoice.create, payment.create, report.pnl, search.product, assistant.chat] and payload with needed data. If unsure, use assistant.chat. Keep Jalali (Shamsi) dates untouched. Answer in Persian (fa).'}, {role: 'user', content: $json.body?.text || $json.body?.message || $json.body || $json} ] }) }}"
      },
      "id": "3",
      "name": "LLM Intent",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 1,
      "position": [
        -1200,
        160
      ]
    },
    {
      "parameters": {
        "mode": "mergeByPosition"
      },
      "id": "4",
      "name": "Merge Token+NLP",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 2,
      "position": [
        -980,
        20
      ]
    },
    {
      "parameters": {
        "functionCode": "const raw = items[0].json;\nconst choice = raw.choices?.[0]?.message?.content || raw.message?.content || raw;\nlet parsed = {};\ntry {\n  parsed = typeof choice === 'string' ? JSON.parse(choice) : choice;\n} catch (e) {\n  parsed = { action: 'assistant.chat', payload: { message: choice } };\n}\nconst action = parsed.action || 'assistant.chat';\nconst payload = parsed.payload ?? parsed;\nreturn [{ json: { action, payload } }];"
      },
      "id": "5",
      "name": "Parse Intent",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [
        -1020,
        260
      ]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{$json.action}}",
              "value2": "invoice.create"
            }
          ]
        }
      },
