    {
      "parameters": {
        "authentication": "none",
        "method": "POST",
        "url": "={{$env.HP_BASE_URL || \"http://localhost:8000\"}}/api/auth/login",
        "responseFormat": "json",
        "jsonParameters": true,
        "options": {
          "timeout": 30
        },
        "bodyParametersJson": "={{ JSON.stringify({ username: $env.HP_USER || \"admin\", password: $env.HP_PASS || \"admin\" }) }}"
      },
      "id": "2",
      "name": "Login JWT",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 1,
