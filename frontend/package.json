{
  "name": "hesabpak-frontend",
  "version": "1.0.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/check-theme-consistency.cjs && node scripts/sync-fonts.cjs",
    "build": "vite build",
    "preview": "vite preview --port 3000",
    "prepreview": "node scripts/sync-fonts.cjs",
    "start": "node index.js",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "format": "prettier --write \"{src,public}/**/*.{ts,tsx,js,json,css,html}\"",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
    "clean-fonts": "node scripts/clean-fonts.cjs",
    "check:headers-config": "node scripts/check-headers-config.cjs",
    "check:theme": "node scripts/check-theme-consistency.cjs",
    "pretest": "node scripts/test-setup.cjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:smoke": "vitest run src/smoke/navigation.test.tsx",
    "pretest:e2e": "node scripts/test-setup.cjs",
    "test:e2e": "playwright test",
    "shot:dashboard": "node scripts/capture-dashboard.mjs",
    "prepare": "husky install"
  },
  "dependencies": {
    "@majidh1/jalalidatepicker": "^0.9.5",
    "chart.js": "^4.4.2",
    "express": "^4.18.2",
    "grapesjs": "^0.21.5",
    "jalaali-js": "^1.1.0",
    "react": "^18.2.0",
    "react-chartjs-2": "^5.2.0",
    "react-dom": "^18.2.0",
    "react-grid-layout": "^1.3.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/react": "^14.0.0",
    "@types/express": "^4.17.21",
    "@types/react": "^18.2.21",
    "@types/react-dom": "^18.2.7",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/coverage-v8": "^4.0.16",
    "autoprefixer": "^10.4.14",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "husky": "^9.0.11",
    "jsdom": "^24.0.0",
    "lint-staged": "^15.2.2",
    "playwright": "^1.56.1",
    "postcss": "^8.4.24",
    "prettier": "^3.3.3",
    "tailwindcss": "^3.4.3",
    "typescript": "^5.5.4",
    "vite": "^7.3.0",
    "vitest": "^4.0.16"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx,js}": [
      "eslint --fix"
    ],
    "{src,public}/**/*.{ts,tsx,js,json,css,html}": [
      "prettier --write"
    ]
  }
}
