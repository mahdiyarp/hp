{
  "name": "hesabpak-frontend",
  "version": "1.0.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "dev": "vite",
    "dev-alt": "vite --force --host",
    "dev3000": "vite --port 3000 --host",
    "build": "vite build",
    "preview": "vite preview --port 3000",
    "preview5173": "vite preview --port 5173",
    "start": "node index.js",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "format": "prettier --write \"{src,public}/**/*.{ts,tsx,js,json,css,html}\"",
    "typecheck": "tsc --noEmit",
    "prepare": "husky install",
    "pw:install-local": "set PLAYWRIGHT_BROWSERS_PATH=0 && npx @playwright/test install --with-deps",
    "pretest": "npm run -s pw:install-local",
    "persian-check": "node ./scripts/persian-check.js",
    "iranYekan-check": "npx @playwright/test test frontend/tests/playwright --reporter=list",
    "test": "npm run iranYekan-check",
    "test:smoke": "npx @playwright/test test frontend/tests/playwright --reporter=list",
    "test:visual": "npx @playwright/test test frontend/tests/playwright --reporter=html",
    "preui:smoke": "npm run -s pw:install-local",
    "ui:smoke": "set PLAYWRIGHT_BROWSERS_PATH=0 && npx @playwright/test test --config tests/playwright/playwright.config.js --reporter=list,html",
    "ui:visual": "set PLAYWRIGHT_BROWSERS_PATH=0 && npx @playwright/test test --config tests/playwright/playwright.config.js --reporter=html",
    "ui:interaction": "set PLAYWRIGHT_BROWSERS_PATH=0 && npx @playwright/test test --config tests/playwright/playwright.config.js --grep @interaction --reporter=list",
    "pw:show-report": "npx @playwright/test show-report --port=0",
    "pw:show-trace": "npx @playwright/test show-trace"
  },
  "dependencies": {
    "express": "^4.18.2",
    "grapesjs": "^0.22.14",
    "jalaali-js": "^1.1.0",
    "moment-jalaali": "^0.10.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-grid-layout": "^1.3.4",
    "react-modern-calendar-datepicker": "^3.1.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/express": "^4.17.21",
    "@types/react": "^18.2.21",
    "@types/react-dom": "^18.2.7",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "autoprefixer": "^10.4.14",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.2",
    "postcss": "^8.4.24",
    "prettier": "^3.3.3",
    "tailwindcss": "^3.4.3",
    "typescript": "^5.1.6",
    "vite": "^5.0.0"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx,js}": [
      "eslint --fix"
    ],
    "{src,public}/**/*.{ts,tsx,js,json,css,html}": [
      "prettier --write"
    ]
  }
}
