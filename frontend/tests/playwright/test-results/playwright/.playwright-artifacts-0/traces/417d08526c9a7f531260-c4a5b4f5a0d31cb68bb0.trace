s when the proper IranYekan woff2 is missing */\r\n@font-face {\r\n  font-family: 'IranYekan';\r\n  src: url('/fonts/Yekan.woff2') format('woff2');\r\n  font-weight: 400;\r\n  font-style: normal;\r\n  font-display: swap;\r\n}\r\n@font-face {\r\n  font-family: 'IranYekan';\r\n  src: url('/fonts/Yekan.woff2') format('woff2');\r\n  font-weight: 500;\r\n  font-style: normal;\r\n  font-display: swap;\r\n}\r\n@font-face {\r\n  font-family: 'IranYekan';\r\n  src: url('/fonts/Yekan.woff2') format('woff2');\r\n  font-weight: 700;\r\n  font-style: normal;\r\n  font-display: swap;\r\n}\r\n\r\n/* Vazirmatn family (bundled) */\r\n@font-face {\r\n  font-family: 'Vazirmatn';\r\n  src: url('/fonts/Vazirmatn-400.woff2') format('woff2');\r\n  font-weight: 400;\r\n  font-style: normal;\r\n  font-display: swap;\r\n}\r\n@font-face {\r\n  font-family: 'Vazirmatn';\r\n  src: url('/fonts/Vazirmatn-500.woff2') format('woff2');\r\n  font-weight: 500;\r\n  font-style: normal;\r\n  font-display: swap;\r\n}\r\n@font-face {\r\n  font-family: 'Vazirmatn';\r\n  src: url('/fonts/Vazirmatn-700.woff2') format('woff2');\r\n  font-weight: 700;\r\n  font-style: normal;\r\n  font-display: swap;\r\n}\r\n\r\n/* Legacy Yekan (bundled) */\r\n@font-face {\r\n  font-family: 'Yekan';\r\n  src: url('/fonts/Yekan.woff2') format('woff2');\r\n  font-weight: 400 700;\r\n  font-style: normal;\r\n  font-display: swap;\r\n}\r\n\r\n:root {\r\n  /* prefer IranYekan (mapped to Yekan when missing), then Vazirmatn, then Yekan */\r\n  --app-font: 'IranYekan', 'Vazirmatn', 'Yekan', system-ui, -apple-system, 'Segoe UI', sans-serif;\r\n}\r\n\r\nhtml[dir='rtl'], body, #root {\r\n  font-family: var(--app-font) !important;\r\n  direction: rtl;\r\n}\r\n\r\n/* Keep this file minimal; other component-level tweaks remain in the specialized CSS files */\r\n"],["STYLE",{},"/* Classic UI baseline: simple, readable, neutral */\r\n:root {\r\n  --bg: #ffffff;\r\n  --fg: #111827;\r\n  --muted: #6b7280;\r\n  --border: #d1d5db;\r\n  --primary: #2563eb;\r\n  --primary-contrast: #ffffff;\r\n}\r\n\r\nhtml, body, #root {\r\n  height: 100%;\r\n  background: var(--bg);\r\n  color: var(--fg);\r\n}\r\n\r\nbody {\r\n  font-family: IRANYekan, tahoma, Arial, sans-serif;\r\n  line-height: 1.5;\r\n}\r\n\r\na { color: var(--primary); text-decoration: none; }\r\na:hover { text-decoration: underline; }\r\n\r\n/* Layout */\r\n.container { max-width: 1200px; margin: 0 auto; padding: 16px; }\r\n.card { background: #fff; border: 1px solid var(--border); border-radius: 6px; padding: 16px; }\r\n\r\n/* Headings */\r\nh1, h2, h3 { font-weight: 600; margin: 0 0 12px; }\r\nh1 { font-size: 22px; }\r\nh2 { font-size: 18px; }\r\nh3 { font-size: 16px; }\r\n\r\n/* Forms */\r\nlabel { display: block; font-size: 13px; color: var(--muted); margin-bottom: 6px; }\r\ninput[type=\"text\"], input[type=\"number\"], input[type=\"email\"], input[type=\"date\"], select, textarea {\r\n  width: 100%;\r\n  border: 1px solid var(--border);\r\n  border-radius: 4px;\r\n  padding: 8px 10px;\r\n  background: #fff;\r\n}\r\ninput:focus, select:focus, textarea:focus { outline: none; border-color: var(--primary); box-shadow: 0 0 0 2px rgba(37, 99, 235, .15); }\r\n\r\n/* Buttons */\r\n.button, button, input[type=\"submit\"], input[type=\"button\"] {\r\n  display: inline-block;\r\n  border: 1px solid var(--primary);\r\n  background: var(--primary);\r\n  color: var(--primary-contrast);\r\n  border-radius: 4px;\r\n  padding: 8px 12px;\r\n  cursor: pointer;\r\n}\r\n.button.secondary, .btn-secondary {\r\n  border-color: var(--border);\r\n  background: #fff;\r\n  color: var(--fg);\r\n}\r\n.button:disabled, button:disabled { opacity: .6; cursor: default; }\r\n\r\n/* Tables */\r\ntable { width: 100%; border-collapse: collapse; background: #fff; }\r\nth, td { text-align: right; padding: 10px; border: 1px solid var(--border); }\r\nth { background: #f9fafb; font-weight: 600; }\r\ntr:nth-child(even) { background: #fcfcfd; }\r\n\r\n/* Utilities */\r\n.mt-1 { margin-top: 4px; } .mt-2 { margin-top: 8px; } .mt-3 { margin-top: 12px; } .mt-4 { margin-top: 16px; }\r\n.mb-1 { margin-bottom: 4px; } .mb-2 { margin-bottom: 8px; } .mb-3 { margin-bottom: 12px; } .mb-4 { margin-bottom: 16px; }\r\n.grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }\r\n.grid-3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; }\r\n.flex { display: flex; align-items: center; gap: 8px; }\r\n\r\n/* RTL tweaks */\r\nbody[dir=\"rtl\"] input, body[dir=\"rtl\"] select, body[dir=\"rtl\"] textarea { text-align: right; }\r\n"]],"\n  ",["BODY",{"dir":"rtl","style":"font-family: 'Vazirmatn','Yekan','IRANSansX',sans-serif;"},"\n    ",["DIV",{"id":"root"},["DIV",{"class":"min-h-screen flex flex-col"},["HEADER",{"class":"hp-card px-4 py-3 sticky top-0 z-10"},["DIV",{"class":"max-w-7xl mx-auto flex items-center gap-4"},["DIV",{"class":"text-2xl font-bold tracking-wide"},"حساب‌پاک"],["DIV",{"class":"flex-1"}],["DIV",{"class":"hidden md:flex items-center gap-3"},["INPUT",{"__playwright_value_":"","class":"hp-input w-72","placeholder":"جستجو..."}],["BUTTON",{"class":"hp-button"},"جستجو"],["SPAN",{"class":"hp-badge warning"},"در حال بررسی API"],["FORM",{"class":"flex items-center gap-2"},["INPUT",{"__playwright_value_":"admin","class":"hp-input w-36","placeholder":"نام کاربری","value":"admin"}],["INPUT",{"__playwright_value_":"Admin@123","class":"hp-input w-36","type":"password","placeholder":"رمز عبور","value":"Admin@123"}],["BUTTON",{"class":"hp-button"},"ورود"]]]]],["DIV",{"class":"flex-1"},["DIV",{"class":"max-w-7xl mx-auto px-4 py-6 grid grid-cols-12 gap-4"},["ASIDE",{"class":"col-span-12 md:col-span-3 lg:col-span-2"},["NAV",{"class":"hp-card p-3"},["UL",{"class":"space-y-1 text-sm"},["LI",{},["A",{"class":"block px-3 py-2 rounded hover:bg-[var(--background)] bg-[var(--background)]","href":"#dashboard"},"داشبورد"]],["LI",{},["A",{"class":"block px-3 py-2 rounded hover:bg-[var(--background)] ","href":"#invoices"},"فاکتورها"]],["LI",{},["A",{"cla