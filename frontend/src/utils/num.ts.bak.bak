// Utility to format numbers using Persian (fa) locale
import jalaali from 'jalaali-js'

export function formatNumberFa(n: number | string) {
  const num = typeof n === 'string' ? Number(n) : n
  if (Number.isNaN(num)) return String(n)
  return new Intl.NumberFormat('fa').format(num)
}

// Format number with Persian digits and space every 3 digits (e.g. ط؛آ±ط؛آ²ط؛آ³ ط؛آ´ط؛آµط؛آ¶ ط؛آ·ط؛آ¸ط؛آ¹)
export function formatNumberFaSpaced(n: number | string) {
  const raw = typeof n === 'string' ? n : String(n)
  const digitsOnly = raw.replace(/[^0-9.-]/g, '')
  if (!digitsOnly || isNaN(Number(digitsOnly))) return toPersianDigits(raw)
  const [signPart, intPartRaw, fracPart] = (() => {
    const negative = digitsOnly.startsWith('-')
    const cleaned = negative ? digitsOnly.slice(1) : digitsOnly
    const [intPart, frac] = cleaned.split('.')
    return [negative ? '-' : '', intPart, frac]
  })()
  const grouped = intPartRaw.replace(/\B(?=(\d{3})+(?!\d))/g, ',') // commas
  const withFrac = fracPart ? `${grouped}.${fracPart}` : grouped
  const persian = toPersianDigits(`${signPart}${withFrac}`)
  return persian
}

// Basic Persian number words (limited scale) for currency narration
const units = ['','ط؛إ’ط¹آ©','ط·آ¯ط¸ث†','ط·آ³ط¸â€،','ط¹â€ ط¸â€،ط·آ§ط·آ±','ط¸آ¾ط¸â€ ط·آ¬','ط·آ´ط·آ´','ط¸â€،ط¸ظ¾ط·ع¾','ط¸â€،ط·آ´ط·ع¾','ط¸â€ ط¸â€،']
const teens = ['ط·آ¯ط¸â€،','ط؛إ’ط·آ§ط·آ²ط·آ¯ط¸â€،','ط·آ¯ط¸ث†ط·آ§ط·آ²ط·آ¯ط¸â€،','ط·آ³ط؛إ’ط·آ²ط·آ¯ط¸â€،','ط¹â€ ط¸â€،ط·آ§ط·آ±ط·آ¯ط¸â€،','ط¸آ¾ط·آ§ط¸â€ ط·آ²ط·آ¯ط¸â€،','ط·آ´ط·آ§ط¸â€ ط·آ²ط·آ¯ط¸â€،','ط¸â€،ط¸ظ¾ط·آ¯ط¸â€،','ط¸â€،ط·آ¬ط·آ¯ط¸â€،','ط¸â€ ط¸ث†ط·آ²ط·آ¯ط¸â€،']
const tens = ['','','ط·آ¨ط؛إ’ط·آ³ط·ع¾','ط·آ³ط؛إ’','ط¹â€ ط¸â€،ط¸â€‍','ط¸آ¾ط¸â€ ط·آ¬ط·آ§ط¸â€،','ط·آ´ط·آµط·ع¾','ط¸â€،ط¸ظ¾ط·ع¾ط·آ§ط·آ¯','ط¸â€،ط·آ´ط·ع¾ط·آ§ط·آ¯','ط¸â€ ط¸ث†ط·آ¯']
const hundreds = ['','ط·آµط·آ¯','ط·آ¯ط¸ث†ط؛إ’ط·آ³ط·ع¾','ط·آ³ط؛إ’ط·آµط·آ¯','ط¹â€ ط¸â€،ط·آ§ط·آ±ط·آµط·آ¯','ط¸آ¾ط·آ§ط¸â€ ط·آµط·آ¯','ط·آ´ط·آ´ط·آµط·آ¯','ط¸â€،ط¸ظ¾ط·ع¾ط·آµط·آ¯','ط¸â€،ط·آ´ط·ع¾ط·آµط·آ¯','ط¸â€ ط¸â€،ط·آµط·آ¯']
const scales = ['','ط¸â€،ط·آ²ط·آ§ط·آ±','ط¸â€¦ط؛إ’ط¸â€‍ط؛إ’ط¸ث†ط¸â€ ','ط¸â€¦ط؛إ’ط¸â€‍ط؛إ’ط·آ§ط·آ±ط·آ¯','ط·ع¾ط·آ±ط؛إ’ط¸â€‍ط؛إ’ط¸ث†ط¸â€ ']

function threeDigitToWords(num: number): string {
  if (num === 0) return ''
  const h = Math.floor(num / 100)
  const t = Math.floor((num % 100) / 10)
  const u = num % 10
  const parts: string[] = []
  if (h) parts.push(hundreds[h])
  if (t === 1) {
    parts.push(teens[u])
    return parts.join(' ط¸ث† ')
  }
  if (t) parts.push(tens[t])
  if (u) parts.push(units[u])
  return parts.join(' ط¸ث† ')
}

export function numberToPersianWords(n: number): string {
  if (n === 0) return 'ط·آµط¸ظ¾ط·آ±'
  if (n < 0) return `ط¸â€¦ط¸â€ ط¸ظ¾ط؛إ’ ${numberToPersianWords(Math.abs(n))}`
  const parts: string[] = []
  let scaleIndex = 0
  while (n > 0 && scaleIndex < scales.length) {
    const chunk = n % 1000
    if (chunk) {
      const chunkWords = threeDigitToWords(chunk)
      const scaleWord = scales[scaleIndex]
      parts.unshift([chunkWords, scaleWord].filter(Boolean).join(' '))
    }
    n = Math.floor(n / 1000)
    scaleIndex++
  }
  return parts.join(' ط¸ث† ')
}

export interface CurrencyFormatResult {
  numeric: string // e.g. ط؛آ±ط؛آ²ط؛آ³ ط؛آ´ط؛آµط؛آ¶
  words: string   // e.g. ط؛إ’ط¹آ©ط·آµط·آ¯ ط¸ث† ط·آ¨ط؛إ’ط·آ³ط·ع¾ ط¸ث† ط·آ³ط¸â€، ط¸â€،ط·آ²ط·آ§ط·آ± ط¸ث† ط¹â€ ط¸â€،ط·آ§ط·آ±ط·آµط·آ¯ ط¸ث† ط¸آ¾ط¸â€ ط·آ¬ط·آ§ط¸â€، ط¸ث† ط·آ´ط·آ´
  full: string    // concatenated with unit
}

export function formatCurrencyFa(value: number | string, unit: 'ط·آ±ط؛إ’ط·آ§ط¸â€‍' | 'ط·ع¾ط¸ث†ط¸â€¦ط·آ§ط¸â€ ' = 'ط·آ±ط؛إ’ط·آ§ط¸â€‍', withWords = true): CurrencyFormatResult {
  const num = typeof value === 'string' ? Number(value.replace(/[^0-9.-]/g, '')) : value
  if (Number.isNaN(num)) {
    return { numeric: toPersianDigits(String(value)), words: '', full: toPersianDigits(String(value)) }
  }
  const numeric = formatNumberFaSpaced(num)
  const words = withWords ? numberToPersianWords(Math.trunc(num)) : ''
  const full = [numeric, unit].join(' ') + (withWords ? ` (${words} ${unit})` : '')
  return { numeric, words, full }
}

export function isoToJalali(iso: string) {
  // parse ISO (assumed UTC) and convert to Jalali date + time string
  const d = new Date(iso)
  if (isNaN(d.getTime())) return iso
  const gy = d.getUTCFullYear()
  const gm = d.getUTCMonth() + 1
  const gd = d.getUTCDate()
  const { jy, jm, jd } = jalaali.toJalaali(gy, gm, gd)
  const hh = String(d.getUTCHours()).padStart(2, '0')
  const mm = String(d.getUTCMinutes()).padStart(2, '0')
  const ss = String(d.getUTCSeconds()).padStart(2, '0')
  // Use Persian numerals via Intl
  const dateStr = `${jy}/${String(jm).padStart(2, '0')}/${String(jd).padStart(2, '0')}`
  const timeStr = `${hh}:${mm}:${ss}`
  return `${new Intl.NumberFormat('fa').format(Number(jy))}/${new Intl.NumberFormat('fa').format(Number(jm))}/${new Intl.NumberFormat('fa').format(Number(jd))} ${timeStr}`
}

export function toPersianDigits(value: string | number) {
  const persian = ['ط؛آ°', 'ط؛آ±', 'ط؛آ²', 'ط؛آ³', 'ط؛آ´', 'ط؛آµ', 'ط؛آ¶', 'ط؛آ·', 'ط؛آ¸', 'ط؛آ¹']
  const str = String(value)
  let out = ''
  for (const ch of str) {
    if (ch >= '0' && ch <= '9') {
      out += persian[Number(ch)]
    } else {
      out += ch
    }
  }
  return out
}

// Convenience wrapper for prices (default ط·آ±ط؛إ’ط·آ§ط¸â€‍, include words)
export function formatPrice(value: number | string, unit: 'ط·آ±ط؛إ’ط·آ§ط¸â€‍' | 'ط·ع¾ط¸ث†ط¸â€¦ط·آ§ط¸â€ ' = 'ط·آ±ط؛إ’ط·آ§ط¸â€‍') {
  return formatCurrencyFa(value, unit, true).full
}
