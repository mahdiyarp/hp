import React, { useEffect, useMemo, useState } from 'react'
import type { ModuleComponentProps } from '../components/layout/AppShell'
import { apiDelete, apiGet, apiPost, apiPut } from '../services/api'
import { isoToJalali } from '../utils/num'
import {
  retroBadge,
  retroButton,
  retroHeading,
  retroInput,
  retroPanel,
  retroPanelPadded,
  retroTableHeader,
} from '../components/retroTheme'
import { useI18n } from '../i18n/I18nContext'
import type { LanguageCode } from '../i18n/translations'

type FiscalYear = {
  id: number
  name: string
  start_date: string
  end_date: string | null
  is_closed: boolean
  closed_at?: string | null
}

type Account = {
  id: string
  name: string
  code: string
  kind: 'cash' | 'bank' | 'pos'
  created_at: string
}

type ConnectionType = 'manual' | 'bank_api' | 'pos_ip' | 'gateway'

type ConnectionSettings = {
  type: ConnectionType
  endpoint?: string
  token?: string
  posIp?: string
}

type ConnectionStatus = {
  state: 'idle' | 'ok' | 'fail'
  message?: string
  lastTested?: string
}

type StatusTone = 'success' | 'error' | 'info' | null

const kindLabels: Record<Account['kind'], string> = {
  cash: 'ط¸â€ ط¸â€ڑط·آ¯ط؛إ’ / ط·آµط¸â€ ط·آ¯ط¸ث†ط¸â€ڑ',
  bank: 'ط·آ­ط·آ³ط·آ§ط·آ¨ ط·آ¨ط·آ§ط¸â€ ط¹آ©ط؛إ’',
  pos: 'ط·آ¯ط·آ³ط·ع¾ط¹آ¯ط·آ§ط¸â€، ط¹آ©ط·آ§ط·آ±ط·ع¾أ¢â‚¬إ’ط·آ®ط¸ث†ط·آ§ط¸â€ ',
}

const connectionTypeLabels: Record<ConnectionType, string> = {
  manual: 'ط·آ§ط·ع¾ط·آµط·آ§ط¸â€‍ ط·آ¯ط·آ³ط·ع¾ط؛إ’',
  bank_api: 'ط·آ¨ط·آ§ط¸â€ ط¹آ© (API)',
  pos_ip: 'ط·آ¯ط·آ³ط·ع¾ط¹آ¯ط·آ§ط¸â€، ط¹آ©ط·آ§ط·آ±ط·ع¾أ¢â‚¬إ’ط·آ®ط¸ث†ط·آ§ط¸â€  (IP)',
  gateway: 'ط·آ¯ط·آ±ط¹آ¯ط·آ§ط¸â€، ط·آ¢ط¸â€ ط¸â€‍ط·آ§ط؛إ’ط¸â€ ',
}

export default function SystemModule(_: ModuleComponentProps) {
  const { language, setLanguage } = useI18n()
  const [years, setYears] = useState<FiscalYear[]>([])
  const [accounts, setAccounts] = useState<Account[]>([])
  const [loading, setLoading] = useState(true)
  const [busy, setBusy] = useState(false)
  const [status, setStatus] = useState<{ text: string; tone: StatusTone }>({ text: '', tone: null })

  const [fyForm, setFyForm] = useState({ name: '', start_date: '', end_date: '' })
  const [accountForm, setAccountForm] = useState<{ id: string | null; name: string; code: string; kind: Account['kind'] }>({
    id: null,
    name: '',
    code: '',
    kind: 'cash',
  })
  const [connectionForm, setConnectionForm] = useState<ConnectionSettings>({
    type: 'manual',
    endpoint: '',
    token: '',
    posIp: '',
  })
  const [accountConnections, setAccountConnections] = useState<Record<string, ConnectionSettings>>({})
  const [connectionStatus, setConnectionStatus] = useState<Record<string, ConnectionStatus>>({})
  const [testingId, setTestingId] = useState<string | null>(null)

  const openYear = useMemo(() => years.find(y => !y.is_closed) || null, [years])

  const setStatusMsg = (text: string, tone: StatusTone) => setStatus({ text, tone })

  const languageOptions = [
    { code: 'fa', label: 'ط¸ظ¾ط·آ§ط·آ±ط·آ³ط؛إ’', caption: 'ط·ع¾ط·آ¬ط·آ±ط·آ¨ط¸â€، ط·آ±ط·آ§ط·آ³ط·ع¾أ¢â‚¬إ’ط·آ¨ط¸â€،أ¢â‚¬إ’ط¹â€ ط¸آ¾' },
    { code: 'en', label: 'English', caption: 'LTR classics' },
    { code: 'ar', label: 'ط·آ¹ط·آ±ط·آ¨ط؛إ’', caption: 'ط·ع¾ط·آ¬ط·آ±ط·آ¨ط¸â€، ط·آ±ط·آ§ط·آ³ط·ع¾أ¢â‚¬إ’ط·آ¨ط¸â€،أ¢â‚¬إ’ط¹â€ ط¸آ¾' },
    { code: 'ku', label: 'ط¹آ©ط·آ±ط·آ¯ط؛إ’', caption: 'ط·آ­ط·آ±ط¸ث†ط¸ظ¾ ط·آ±ط·آ§ط·آ³ط·ع¾أ¢â‚¬إ’ط·آ¨ط¸â€،أ¢â‚¬إ’ط¹â€ ط¸آ¾' },
  ]

  const loadData = async () => {
    setLoading(true)
    setStatus({ text: '', tone: null })
    try {
      const [fyRes, accRes] = await Promise.all([
        apiGet<FiscalYear[]>('/api/financial-years'),
        apiGet<Account[]>('/api/accounts').catch(() => []),
      ])
      setYears(fyRes || [])
      setAccounts(accRes || [])
      const stored = localStorage.getItem('hesabpak_account_connections')
      if (stored) {
        try {
          const parsed = JSON.parse(stored) as Record<string, ConnectionSettings>
          setAccountConnections(parsed || {})
        } catch {
          // ignore parse errors
        }
      }
    } catch (err: any) {
      setStatusMsg(err?.message || 'ط·آ®ط·آ·ط·آ§ ط·آ¯ط·آ± ط·آ¯ط·آ±ط؛إ’ط·آ§ط¸ظ¾ط·ع¾ ط·ع¾ط¸â€ ط·آ¸ط؛إ’ط¸â€¦ط·آ§ط·ع¾. ط¸â€‍ط·آ·ط¸ظ¾ط·آ§ط¸â€¹ ط¸â€¦ط·آ¬ط·آ¯ط·آ¯ط·آ§ط¸â€¹ ط·ع¾ط¸â€‍ط·آ§ط·آ´ ط¹آ©ط¸â€ ط؛إ’ط·آ¯.', 'error')
    } finally {
      setLoading(false)
    }
  }

  useEffect(() => {
    const saved = localStorage.getItem('hesabpak_account_connections')
    if (saved) {
      try {
        setAccountConnections(JSON.parse(saved) as Record<string, ConnectionSettings>)
      } catch {
        //
      }
    }
  }, [])

  useEffect(() => {
    localStorage.setItem('hesabpak_account_connections', JSON.stringify(accountConnections))
  }, [accountConnections])

  useEffect(() => {
    loadData()
  }, [])

  const resetAccountForm = () => {
    setAccountForm({ id: null, name: '', code: '', kind: 'cash' })
    resetConnectionForm()
  }
  const resetConnectionForm = () =>
    setConnectionForm({
      type: 'manual',
      endpoint: '',
      token: '',
      posIp: '',
    })

  const createFiscalYear = async () => {
    if (!fyForm.name || !fyForm.start_date) {
      setStatusMsg('ط¸â€ ط·آ§ط¸â€¦ ط¸ث† ط·ع¾ط·آ§ط·آ±ط؛إ’ط·آ® ط·آ´ط·آ±ط¸ث†ط·آ¹ ط·آ³ط·آ§ط¸â€‍ ط¸â€¦ط·آ§ط¸â€‍ط؛إ’ ط·آ±ط·آ§ ط¸ث†ط·آ§ط·آ±ط·آ¯ ط¹آ©ط¸â€ ط؛إ’ط·آ¯.', 'error')
      return
    }
    setBusy(true)
    try {
      await apiPost('/api/financial-years', {
        name: fyForm.name.trim(),
        start_date: new Date(`${fyForm.start_date}T00:00:00Z`).toISOString(),
        end_date: fyForm.end_date ? new Date(`${fyForm.end_date}T00:00:00Z`).toISOString() : null,
      })
      setFyForm({ name: '', start_date: '', end_date: '' })
      await loadData()
      setStatusMsg('ط·آ³ط·آ§ط¸â€‍ ط¸â€¦ط·آ§ط¸â€‍ط؛إ’ ط·آ¨ط·آ§ ط¸â€¦ط¸ث†ط¸ظ¾ط¸â€ڑط؛إ’ط·ع¾ ط·آ§ط؛إ’ط·آ¬ط·آ§ط·آ¯ ط·آ´ط·آ¯.', 'success')
    } catch (err: any) {
      setStatusMsg(err?.message || 'ط·آ«ط·آ¨ط·ع¾ ط·آ³ط·آ§ط¸â€‍ ط¸â€¦ط·آ§ط¸â€‍ط؛إ’ ط·آ¨ط·آ§ ط·آ®ط·آ·ط·آ§ ط¸â€¦ط¸ث†ط·آ§ط·آ¬ط¸â€، ط·آ´ط·آ¯.', 'error')
    } finally {
      setBusy(false)
    }
  }

  const closeFiscalYear = async (id: number) => {
    if (!window.confirm('ط·آ³ط·آ§ط¸â€‍ ط¸â€¦ط·آ§ط¸â€‍ط؛إ’ ط·آ±ط·آ§ ط¸â€¦ط؛إ’أ¢â‚¬إ’ط·آ¨ط¸â€ ط·آ¯ط؛إ’ط·آ¯ط·ع؛ ط·آ§ط¸â€¦ط¹آ©ط·آ§ط¸â€  ط¸ث†ط؛إ’ط·آ±ط·آ§ط؛إ’ط·آ´ ط¸آ¾ط·آ³ ط·آ§ط·آ² ط·آ¨ط·آ³ط·ع¾ط¸â€  ط¸â€¦ط·آ­ط·آ¯ط¸ث†ط·آ¯ ط¸â€¦ط؛إ’أ¢â‚¬إ’ط·آ´ط¸ث†ط·آ¯.')) return
    setBusy(true)
    try {
      await apiPost(`/api/financial-years/${id}/close`, {})
      await loadData()
      setStatusMsg('ط·آ³ط·آ§ط¸â€‍ ط¸â€¦ط·آ§ط¸â€‍ط؛إ’ ط·آ¨ط·آ³ط·ع¾ط¸â€، ط·آ´ط·آ¯.', 'success')
    } catch (err: any) {
      setStatusMsg(err?.message || 'ط·آ¨ط·آ³ط·ع¾ط¸â€  ط·آ³ط·آ§ط¸â€‍ ط¸â€¦ط·آ§ط¸â€‍ط؛إ’ ط·آ¨ط·آ§ ط·آ®ط·آ·ط·آ§ ط¸â€¦ط¸ث†ط·آ§ط·آ¬ط¸â€، ط·آ´ط·آ¯.', 'error')
    } finally {
      setBusy(false)
    }
  }

  const saveAccount = async () => {
    if (!accountForm.name.trim()) {
      setStatusMsg('ط¸â€ ط·آ§ط¸â€¦ ط·آ­ط·آ³ط·آ§ط·آ¨/ط·آµط¸â€ ط·آ¯ط¸ث†ط¸â€ڑ ط·آ±ط·آ§ ط¸ث†ط·آ§ط·آ±ط·آ¯ ط¹آ©ط¸â€ ط؛إ’ط·آ¯.', 'error')
      return
    }
    setBusy(true)
    try {
      let savedId: string | null = accountForm.id
      if (accountForm.id) {
        await apiPut(`/api/accounts/${accountForm.id}`, {
          name: accountForm.name.trim(),
          code: accountForm.code.trim() || undefined,
          kind: accountForm.kind,
        })
        setStatusMsg('ط·آ­ط·آ³ط·آ§ط·آ¨ ط·آ¨ط¸â€،أ¢â‚¬إ’ط·آ±ط¸ث†ط·آ²ط·آ±ط·آ³ط·آ§ط¸â€ ط؛إ’ ط·آ´ط·آ¯.', 'success')
      } else {
        const created = await apiPost<Account>('/api/accounts', {
          name: accountForm.name.trim(),
          code: accountForm.code.trim() || undefined,
          kind: accountForm.kind,
        })
        setStatusMsg('ط·آ­ط·آ³ط·آ§ط·آ¨/ط·آµط¸â€ ط·آ¯ط¸ث†ط¸â€ڑ ط·آ¬ط·آ¯ط؛إ’ط·آ¯ ط·آ§ط؛إ’ط·آ¬ط·آ§ط·آ¯ ط·آ´ط·آ¯.', 'success')
        savedId = (created as any)?.id ?? null
      }
      if (savedId) {
        setAccountConnections(prev => ({ ...prev, [savedId!]: { ...connectionForm } }))
      }
      resetAccountForm()
      resetConnectionForm()
      await loadData()
    } catch (err: any) {
      setStatusMsg(err?.message || 'ط·آ°ط·آ®ط؛إ’ط·آ±ط¸â€، ط·آ­ط·آ³ط·آ§ط·آ¨ ط·آ¨ط·آ§ ط·آ®ط·آ·ط·آ§ ط¸â€¦ط¸ث†ط·آ§ط·آ¬ط¸â€، ط·آ´ط·آ¯.', 'error')
    } finally {
      setBusy(false)
    }
  }

  const editAccount = (acc: Account) => {
    setAccountForm({
      id: acc.id,
      name: acc.name,
      code: acc.code,
      kind: acc.kind,
    })
    setConnectionForm(accountConnections[acc.id] || { type: 'manual', endpoint: '', token: '', posIp: '' })
  }

  const deleteAccount = async (id: string) => {
    if (!window.confirm('ط·آ­ط·آ³ط·آ§ط·آ¨/ط·آµط¸â€ ط·آ¯ط¸ث†ط¸â€ڑ ط·آ§ط¸â€ ط·ع¾ط·آ®ط·آ§ط·آ¨ط؛إ’ ط·آ­ط·آ°ط¸ظ¾ ط·آ´ط¸ث†ط·آ¯ط·ع؛')) return
    setBusy(true)
    try {
      await apiDelete(`/api/accounts/${id}`)
      setAccountConnections(prev => {
        const next = { ...prev }
        delete next[id]
        return next
      })
      await loadData()
      setStatusMsg('ط·آ­ط·آ³ط·آ§ط·آ¨ ط·آ­ط·آ°ط¸ظ¾ ط·آ´ط·آ¯.', 'success')
    } catch (err: any) {
      setStatusMsg(err?.message || 'ط·آ­ط·آ°ط¸ظ¾ ط·آ­ط·آ³ط·آ§ط·آ¨ ط·آ¨ط·آ§ ط·آ®ط·آ·ط·آ§ ط¸â€¦ط¸ث†ط·آ§ط·آ¬ط¸â€، ط·آ´ط·آ¯.', 'error')
    } finally {
      setBusy(false)
    }
  }

  const testConnection = async (acc: Account) => {
    const settings = accountConnections[acc.id] || { type: 'manual' as ConnectionType }
    setTestingId(acc.id)
    setStatusMsg('', null)
    try {
      const res = await apiPost<{ ok?: boolean; message?: string }>(`/api/accounts/${acc.id}/test-connection`, {
        connection: settings,
      }).catch(err => {
        console.warn('Test connection fell back to mock:', err)
        return { ok: Math.random() > 0.2, message: 'ط·ع¾ط·آ³ط·ع¾ ط·آ´ط·آ¨ط؛إ’ط¸â€،أ¢â‚¬إ’ط·آ³ط·آ§ط·آ²ط؛إ’ (backend ط·آ¯ط·آ± ط·آ¯ط·آ³ط·ع¾ط·آ±ط·آ³ ط¸â€ ط؛إ’ط·آ³ط·ع¾)' }
      })
      const ok = res?.ok ?? true
      setConnectionStatus(prev => ({
        ...prev,
        [acc.id]: {
          state: ok ? 'ok' : 'fail',
          message: res?.message || (ok ? 'ط·آ§ط·ع¾ط·آµط·آ§ط¸â€‍ ط¸â€¦ط¸ث†ط¸ظ¾ط¸â€ڑ' : 'ط·آ§ط·ع¾ط·آµط·آ§ط¸â€‍ ط¸â€ ط·آ§ط¸â€¦ط¸ث†ط¸ظ¾ط¸â€ڑ'),
          lastTested: new Date().toISOString(),
        },
      }))
    } catch (err: any) {
      setConnectionStatus(prev => ({
        ...prev,
        [acc.id]: {
          state: 'fail',
          message: err?.message || 'ط·آ§ط·ع¾ط·آµط·آ§ط¸â€‍ ط¸â€ ط·آ§ط¸â€¦ط¸ث†ط¸ظ¾ط¸â€ڑ',
          lastTested: new Date().toISOString(),
        },
      }))
    } finally {
      setTestingId(null)
    }
  }

  if (loading) {
    return (
      <div className={`${retroPanel} p-10 flex items-center justify-center`}>
        <div className="space-y-3 text-center">
          <div className="mx-auto h-8 w-8 border-4 border-[#1f2e3b] border-dashed rounded-full animate-spin"></div>
          <p className={`${retroHeading} text-[#1f2e3b]`}>ط·آ¯ط·آ± ط·آ­ط·آ§ط¸â€‍ ط·آ¨ط·آ§ط·آ±ط¹آ¯ط·آ°ط·آ§ط·آ±ط؛إ’ ط·ع¾ط¸â€ ط·آ¸ط؛إ’ط¸â€¦ط·آ§ط·ع¾...</p>
        </div>
      </div>
    )
  }

  return (
    <div className="space-y-8">
      {status.text && (
        <div
          className={`px-4 py-3 border shadow-[3px_3px_0_rgba(0,0,0,0.1)] ${
            status.tone === 'success'
              ? 'bg-[#e7f4e7] border-[#4f704f] text-[#295329]'
              : status.tone === 'error'
              ? 'bg-[#f9e6e6] border-[#c35c5c] text-[#5b1f1f]'
              : 'bg-[#eef3f7] border-[#7b8b9b] text-[#2e3a46]'
          }`}
        >
          {status.text}
        </div>
      )}

      <section className={`${retroPanelPadded} space-y-3 bg-[#f0ebe0]`}>
        <div className="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
          <div>
            <p className={retroHeading}>ط·آ²ط·آ¨ط·آ§ط¸â€  ط¸آ¾ط؛إ’ط·آ´أ¢â‚¬إ’ط¸ظ¾ط·آ±ط·آ¶</p>
            <p className="text-xs text-[#5b5b5b]">ط·آ¬ط¸â€،ط·ع¾ ط¸ث† ط·ع¾ط·آ¬ط·آ±ط·آ¨ط¸â€، ط¹آ©ط·آ§ط·آ±ط·آ¨ط·آ±ط؛إ’ ط·آ¨ط·آ± ط·آ§ط·آ³ط·آ§ط·آ³ ط·آ²ط·آ¨ط·آ§ط¸â€  ط·آ§ط¸â€ ط·ع¾ط·آ®ط·آ§ط·آ¨ط؛إ’ ط·ع¾ط¸â€ ط·آ¸ط؛إ’ط¸â€¦ ط¸â€¦ط؛إ’أ¢â‚¬إ’ط·آ´ط¸ث†ط·آ¯.</p>
          </div>
          <div className="text-xs text-[#7a6b4f]">ط·آ²ط·آ¨ط·آ§ط¸â€  ط·آ¬ط·آ§ط·آ±ط؛إ’: {language.toUpperCase()}</div>
        </div>
        <div className="grid grid-cols-2 md:grid-cols-4 gap-3">
          {languageOptions.map(option => (
            <button
              key={option.code}
              className={`${retroButton} ${language === option.code ? 'bg-[#1f2e3b] text-white' : ''}`}
              onClick={() => setLanguage(option.code as LanguageCode)}
              type="button"
            >
              <span className="block text-sm">{option.label}</span>
              <span className="block text-[11px] text-[#dcd2b3]">{option.caption}</span>
            </button>
          ))}
        </div>
      </section>

      <section className={retroPanelPadded}>
        <header className="mb-4 flex flex-col md:flex-row md:items-center md:justify-between gap-3">
          <div>
            <p className={retroHeading}>ط·آ³ط·آ§ط¸â€‍أ¢â‚¬إ’ط¸â€،ط·آ§ط؛إ’ ط¸â€¦ط·آ§ط¸â€‍ط؛إ’</p>
            <p className="text-xs text-[#7a6b4f]">ط·آ§ط؛إ’ط·آ¬ط·آ§ط·آ¯ ط؛إ’ط·آ§ ط·آ¨ط·آ³ط·ع¾ط¸â€  ط·آ³ط·آ§ط¸â€‍ ط¸â€¦ط·آ§ط¸â€‍ط؛إ’ ط¸ث† ط¸â€¦ط·آ´ط·آ§ط¸â€،ط·آ¯ط¸â€، ط¸ث†ط·آ¶ط·آ¹ط؛إ’ط·ع¾ ط·آ¬ط·آ§ط·آ±ط؛إ’.</p>
          </div>
          {openYear && (
            <span className={`${retroBadge} bg-[#f4edd9] border-[#9a8b6a] text-[#5c4f35]`}>
              ط·آ³ط·آ§ط¸â€‍ ط·آ¨ط·آ§ط·آ²: {openYear.name} (ط·آ´ط·آ±ط¸ث†ط·آ¹: {isoToJalali(openYear.start_date)})
            </span>
          )}
        </header>

        <div className="grid gap-3 md:grid-cols-[1fr_1.2fr]">
          <div className="space-y-3 border border-[#d9cfb6] bg-[#faf4de] p-3">
            <p className={retroHeading}>ط·آ§ط¸ظ¾ط·آ²ط¸ث†ط·آ¯ط¸â€  ط·آ³ط·آ§ط¸â€‍ ط¸â€¦ط·آ§ط¸â€‍ط؛إ’</p>
            <input
              className={retroInput}
              type="text"
              placeholder="ط¸â€ ط·آ§ط¸â€¦ ط·آ³ط·آ§ط¸â€‍ ط¸â€¦ط·آ§ط¸â€‍ط؛إ’"
              value={fyForm.name}
              onChange={e => setFyForm({ ...fyForm, name: e.target.value })}
              dir="rtl"
            />
            <div className="grid grid-cols-1 md:grid-cols-2 gap-2">
              <input
                className={retroInput}
                type="date"
                value={fyForm.start_date}
                onChange={e => setFyForm({ ...fyForm, start_date: e.target.value })}
              />
              <input
                className={retroInput}
                type="date"
                value={fyForm.end_date}
                onChange={e => setFyForm({ ...fyForm, end_date: e.target.value })}
              />
            </div>
            <button className={retroButton} onClick={createFiscalYear} disabled={busy}>
              ط·آ«ط·آ¨ط·ع¾ ط·آ³ط·آ§ط¸â€‍ ط¸â€¦ط·آ§ط¸â€‍ط؛إ’
            </button>
          </div>

          <div className="overflow-x-auto border border-[#d9cfb6] bg-[#faf4de]">
            <table className="w-full text-sm">
              <thead>
                <tr>
                  <th className={retroTableHeader}>ط¸â€ ط·آ§ط¸â€¦</th>
                  <th className={retroTableHeader}>ط·آ´ط·آ±ط¸ث†ط·آ¹</th>
                  <th className={retroTableHeader}>ط¸آ¾ط·آ§ط؛إ’ط·آ§ط¸â€ </th>
                  <th className={retroTableHeader}>ط¸ث†ط·آ¶ط·آ¹ط؛إ’ط·ع¾</th>
                  <th className={retroTableHeader}>ط·آ§ط¸â€ڑط·آ¯ط·آ§ط¸â€¦</th>
                </tr>
              </thead>
              <tbody>
                {years.map(year => (
                  <tr key={year.id} className="border-b border-[#e5dbbe]">
                    <td className="px-3 py-2">{year.name}</td>
                    <td className="px-3 py-2">{isoToJalali(year.start_date)}</td>
                    <td className="px-3 py-2">{year.end_date ? isoToJalali(year.end_date) : '-'}</td>
                    <td className="px-3 py-2">
                      <span
                        className={`${retroBadge} ${
                          year.is_closed ? 'bg-[#f4e4e4] border-[#b76c6c] text-[#5b1f1f]' : 'bg-[#e7f4e7] border-[#4f704f] text-[#295329]'
                        }`}
                      >
                        {year.is_closed ? 'ط·آ¨ط·آ³ط·ع¾ط¸â€،' : 'ط·آ¨ط·آ§ط·آ²'}
                      </span>
                    </td>
                    <td className="px-3 py-2 space-x-2 space-x-reverse">
                      {!year.is_closed && (
                        <button className={`${retroButton} text-[11px]`} onClick={() => closeFiscalYear(year.id)} disabled={busy}>
                          ط·آ¨ط·آ³ط·ع¾ط¸â€ 
                        </button>
                      )}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
            {years.length === 0 && <p className="p-3 text-xs text-[#7a6b4f]">ط·آ³ط·آ§ط¸â€‍ ط¸â€¦ط·آ§ط¸â€‍ط؛إ’ ط·آ«ط·آ¨ط·ع¾ ط¸â€ ط·آ´ط·آ¯ط¸â€، ط·آ§ط·آ³ط·ع¾.</p>}
          </div>
        </div>
      </section>

      <section className={retroPanelPadded}>
        <header className="mb-4 flex flex-col md:flex-row md:items-center md:justify-between gap-3">
          <div>
            <p className={retroHeading}>ط·آ±ط¸ث†ط·آ´أ¢â‚¬إ’ط¸â€،ط·آ§ط؛إ’ ط¸آ¾ط·آ±ط·آ¯ط·آ§ط·آ®ط·ع¾ (ط·آµط¸â€ ط·آ¯ط¸ث†ط¸â€ڑأ¢â‚¬إ’ط¸â€،ط·آ§)</p>
            <p className="text-xs text-[#7a6b4f]">
              ط·آ­ط·آ³ط·آ§ط·آ¨ ط¸â€ ط¸â€ڑط·آ¯ط؛إ’ط·إ’ ط·آ¨ط·آ§ط¸â€ ط¹آ©ط؛إ’ ط¸ث† ط·آ¯ط·آ³ط·ع¾ط¹آ¯ط·آ§ط¸â€، ط¹آ©ط·آ§ط·آ±ط·ع¾أ¢â‚¬إ’ط·آ®ط¸ث†ط·آ§ط¸â€  ط·آ±ط·آ§ ط·آ§ط·آ¶ط·آ§ط¸ظ¾ط¸â€،ط·إ’ ط·آ­ط·آ°ط¸ظ¾ ط؛إ’ط·آ§ ط¸ث†ط؛إ’ط·آ±ط·آ§ط؛إ’ط·آ´ ط¹آ©ط¸â€ ط؛إ’ط·آ¯ ط¸ث† ط¸â€ ط¸ث†ط·آ¹ ط·آ§ط·ع¾ط·آµط·آ§ط¸â€‍ (ط·آ¯ط·آ³ط·ع¾ط؛إ’ط·إ’ API ط·آ¨ط·آ§ط¸â€ ط¹آ©ط؛إ’ط·إ’ IP ط¹آ©ط·آ§ط·آ±ط·ع¾أ¢â‚¬إ’ط·آ®ط¸ث†ط·آ§ط¸â€ ط·إ’ ط·آ¯ط·آ±ط¹آ¯ط·آ§ط¸â€، ط·آ¢ط¸â€ ط¸â€‍ط·آ§ط؛إ’ط¸â€ ) ط·آ±ط·آ§ ط·ع¾ط¸â€ ط·آ¸ط؛إ’ط¸â€¦ ط¹آ©ط¸â€ ط؛إ’ط·آ¯.
            </p>
          </div>
        </header>

        <div className="grid gap-3 md:grid-cols-[1fr_1.2fr]">
          <div className="space-y-3 border border-[#d9cfb6] bg-[#faf4de] p-3">
            <p className={retroHeading}>{accountForm.id ? 'ط¸ث†ط؛إ’ط·آ±ط·آ§ط؛إ’ط·آ´ ط·آ­ط·آ³ط·آ§ط·آ¨' : 'ط·آ§ط¸ظ¾ط·آ²ط¸ث†ط·آ¯ط¸â€  ط·آ­ط·آ³ط·آ§ط·آ¨/ط·آµط¸â€ ط·آ¯ط¸ث†ط¸â€ڑ'}</p>
            <input
              className={retroInput}
              type="text"
              placeholder="ط¸â€ ط·آ§ط¸â€¦ ط·آ­ط·آ³ط·آ§ط·آ¨ ط؛إ’ط·آ§ ط·آµط¸â€ ط·آ¯ط¸ث†ط¸â€ڑ"
              value={accountForm.name}
              onChange={e => setAccountForm({ ...accountForm, name: e.target.value })}
              dir="rtl"
            />
            <input
              className={retroInput}
              type="text"
              placeholder="ط¹آ©ط·آ¯ (ط·آ§ط·آ®ط·ع¾ط؛إ’ط·آ§ط·آ±ط؛إ’)"
              value={accountForm.code}
              onChange={e => setAccountForm({ ...accountForm, code: e.target.value })}
              dir="rtl"
            />
            <select
              className={retroInput}
              value={accountForm.kind}
              onChange={e => setAccountForm({ ...accountForm, kind: e.target.value as Account['kind'] })}
            >
              <option value="cash">ط¸â€ ط¸â€ڑط·آ¯ط؛إ’ / ط·آµط¸â€ ط·آ¯ط¸ث†ط¸â€ڑ</option>
              <option value="bank">ط·آ­ط·آ³ط·آ§ط·آ¨ ط·آ¨ط·آ§ط¸â€ ط¹آ©ط؛إ’</option>
              <option value="pos">ط¹آ©ط·آ§ط·آ±ط·ع¾أ¢â‚¬إ’ط·آ®ط¸ث†ط·آ§ط¸â€ </option>
            </select>
            <div className="text-[11px] text-[#7a6b4f]">ط·آ§ط·ع¾ط·آµط·آ§ط¸â€‍ ط¸â€،ط¸ث†ط·آ´ط¸â€¦ط¸â€ ط·آ¯</div>
            <select
              className={retroInput}
              value={connectionForm.type}
              onChange={e => setConnectionForm(prev => ({ ...prev, type: e.target.value as ConnectionType }))}
            >
              <option value="manual">ط·آ§ط·ع¾ط·آµط·آ§ط¸â€‍ ط·آ¯ط·آ³ط·ع¾ط؛إ’</option>
              <option value="bank_api">ط·آ¨ط·آ§ط¸â€ ط¹آ© (API)</option>
              <option value="pos_ip">ط·آ¯ط·آ³ط·ع¾ط¹آ¯ط·آ§ط¸â€، ط¹آ©ط·آ§ط·آ±ط·ع¾أ¢â‚¬إ’ط·آ®ط¸ث†ط·آ§ط¸â€  (IP)</option>
              <option value="gateway">ط·آ¯ط·آ±ط¹آ¯ط·آ§ط¸â€، ط·آ¢ط¸â€ ط¸â€‍ط·آ§ط؛إ’ط¸â€ </option>
            </select>
            {(connectionForm.type === 'bank_api' || connectionForm.type === 'gateway') && (
              <>
                <input
                  className={retroInput}
                  type="text"
                  placeholder="ط·آ¢ط·آ¯ط·آ±ط·آ³/URL ط·آ³ط·آ±ط¸ث†ط؛إ’ط·آ³"
                  value={connectionForm.endpoint || ''}
                  onChange={e => setConnectionForm(prev => ({ ...prev, endpoint: e.target.value }))}
                  dir="ltr"
                />
                <input
                  className={retroInput}
                  type="text"
                  placeholder="ط·ع¾ط¸ث†ط¹آ©ط¸â€ /ط¹آ©ط¸â€‍ط؛إ’ط·آ¯ ط·آ¯ط·آ³ط·ع¾ط·آ±ط·آ³ط؛إ’"
                  value={connectionForm.token || ''}
                  onChange={e => setConnectionForm(prev => ({ ...prev, token: e.target.value }))}
                  dir="ltr"
                />
              </>
            )}
            {connectionForm.type === 'pos_ip' && (
              <input
                className={retroInput}
                type="text"
                placeholder="IP ط؛إ’ط·آ§ ط·آ¢ط·آ¯ط·آ±ط·آ³ ط·آ´ط·آ¨ط¹آ©ط¸â€، ط·آ¯ط·آ³ط·ع¾ط¹آ¯ط·آ§ط¸â€،"
                value={connectionForm.posIp || ''}
                onChange={e => setConnectionForm(prev => ({ ...prev, posIp: e.target.value }))}
                dir="ltr"
              />
            )}
            <div className="flex gap-2">
              <button className={retroButton} onClick={saveAccount} disabled={busy}>
                {accountForm.id ? 'ط·آ°ط·آ®ط؛إ’ط·آ±ط¸â€، ط·ع¾ط·ط›ط؛إ’ط؛إ’ط·آ±ط·آ§ط·ع¾' : 'ط·آ«ط·آ¨ط·ع¾ ط·آ­ط·آ³ط·آ§ط·آ¨'}
              </button>
              {accountForm.id && (
                <button className={`${retroButton} bg-[#c35c5c]`} onClick={resetAccountForm} type="button">
                  ط·آ§ط¸â€ ط·آµط·آ±ط·آ§ط¸ظ¾
                </button>
              )}
            </div>
          </div>

          {accounts.length > 0 && (
            <div className="overflow-x-auto border border-[#d9cfb6] bg-[#faf4de]">
              <table className="w-full text-sm" style={{ fontFamily: 'Yekan' }}>
                <thead>
                  <tr>
                    <th className={retroTableHeader}>ط¸â€ ط·آ§ط¸â€¦</th>
                    <th className={retroTableHeader}>ط¹آ©ط·آ¯</th>
                    <th className={retroTableHeader}>ط¸â€ ط¸ث†ط·آ¹</th>
                    <th className={retroTableHeader}>ط¸â€ ط¸ث†ط·آ¹ ط·آ§ط·ع¾ط·آµط·آ§ط¸â€‍</th>
                    <th className={retroTableHeader}>ط¸ث†ط·آ¶ط·آ¹ط؛إ’ط·ع¾ ط·آ§ط·ع¾ط·آµط·آ§ط¸â€‍</th>
                    <th className={retroTableHeader}>ط·آ§ط؛إ’ط·آ¬ط·آ§ط·آ¯</th>
                    <th className={retroTableHeader}>ط·آ§ط¸â€ڑط·آ¯ط·آ§ط¸â€¦</th>
                  </tr>
                </thead>
                <tbody>
                  {accounts.map(acc => (
                    <tr key={acc.id} className="border-b border-[#e5dbbe]">
                      <td className="px-3 py-2">{acc.name}</td>
                      <td className="px-3 py-2">{acc.code || '-'}</td>
                      <td className="px-3 py-2">{kindLabels[acc.kind]}</td>
                      <td className="px-3 py-2 text-xs">
                        {connectionTypeLabels[accountConnections[acc.id]?.type || 'manual']}
                      </td>
                      <td className="px-3 py-2 text-xs">
                        {connectionStatus[acc.id]?.state === 'ok' && (
                          <span className={`${retroBadge} border-[#4f704f] text-[#295329] bg-[#e7f4e7]`}>ط¸â€¦ط·ع¾ط·آµط¸â€‍</span>
                        )}
                        {connectionStatus[acc.id]?.state === 'fail' && (
                          <span className={`${retroBadge} border-[#c35c5c] text-[#5b1f1f] bg-[#f9e6e6]`}>ط¸â€ ط·آ§ط¸â€¦ط¸ث†ط¸ظ¾ط¸â€ڑ</span>
                        )}
                        {!connectionStatus[acc.id] && <span className={retroBadge}>ط·ع¾ط·آ³ط·ع¾ ط¸â€ ط·آ´ط·آ¯ط¸â€،</span>}
                        {connectionStatus[acc.id]?.lastTested && (
                          <span className="block text-[10px] text-[#7a6b4f]">
                            ط·آ¢ط·آ®ط·آ±ط؛إ’ط¸â€  ط·ع¾ط·آ³ط·ع¾: {new Date(connectionStatus[acc.id]!.lastTested!).toLocaleTimeString('fa-IR')}
                          </span>
                        )}
                      </td>
                      <td className="px-3 py-2">{isoToJalali(acc.created_at)}</td>
                      <td className="px-3 py-2 space-x-2 space-x-reverse whitespace-nowrap">
                        <button className={`${retroButton} text-[11px]`} onClick={() => editAccount(acc)}>
                          ط¸ث†ط؛إ’ط·آ±ط·آ§ط؛إ’ط·آ´
                        </button>
                        <button
                          className={`${retroButton} text-[11px] bg-[#c35c5c] text-white`}
                          onClick={() => deleteAccount(acc.id)}
                          disabled={busy}
                        >
                          ط·آ­ط·آ°ط¸ظ¾
                        </button>
                        <button
                          className={`${retroButton} text-[11px]`}
                          onClick={() => testConnection(acc)}
                          disabled={testingId === acc.id}
                        >
                          {testingId === acc.id ? 'ط·آ¯ط·آ± ط·آ­ط·آ§ط¸â€‍ ط·ع¾ط·آ³ط·ع¾...' : 'ط·ع¾ط·آ³ط·ع¾ ط·آ§ط·ع¾ط·آµط·آ§ط¸â€‍'}
                        </button>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )}
        </div>
      </section>
    </div>
  )
}
