import React, { useEffect, useMemo, useState } from 'react'
import type { ModuleComponentProps } from '../components/layout/AppShell'
import { apiGet, apiPost } from '../services/api'
import { formatNumberFa } from '../utils/num'
import { resolvePaymentMethodLabel, type PaymentAccount } from '../utils/paymentMethods'
import {
  retroButton,
  retroHeading,
  retroInput,
  retroPanel,
  retroPanelPadded,
  retroTableHeader,
  retroMuted,
} from '../components/retroTheme'

interface Person {
  id: string
  name: string
  kind: string | null
  mobile: string | null
  code: string | null
  description: string | null
  created_at: string
}

interface PersonBalance {
  person_id: string
  debit: number
  credit: number
  balance: number
}

interface PersonLedger {
  entries: {
    id: string
    entry_date: string
    description: string
    debit_account: string
    credit_account: string
    amount: number
    running_balance: number
    invoice: { id: number; invoice_number: string } | null
    payment: { method: string; reference?: string } | null
  }[]
  person: {
    name: string
    kind: string | null
    mobile: string | null
    code: string | null
  }
  debit_total: number
  credit_total: number
  net_balance: number
  party_id: string
}

interface KindItem {
  id: string
  title?: string
  parentId: string | null
}

const DEFAULT_KIND_TREE: KindItem[] = [
  { id: 'customer', title: 'ط·آ¸أ¢â‚¬آ¦ط·آ·ط¢آ´ط·آ·ط¹آ¾ط·آ·ط¢آ±ط·ط›ط¥â€™', parentId: null },
  { id: 'supplier', title: 'ط·آ·ط¹آ¾ط·آ·ط¢آ£ط·آ¸أ¢â‚¬آ¦ط·ط›ط¥â€™ط·آ¸أ¢â‚¬آ ط£آ¢أ¢â€ڑآ¬ط¥â€™ط·آ¹ط¢آ©ط·آ¸أ¢â‚¬آ ط·آ¸أ¢â‚¬آ ط·آ·ط¢آ¯ط·آ¸أ¢â‚¬طŒ', parentId: null },
  { id: 'other', title: 'ط·آ·ط¢آ³ط·آ·ط¢آ§ط·ط›ط¥â€™ط·آ·ط¢آ±', parentId: null },
]
const KIND_STORAGE_KEY = 'hesabpak_person_kind_tree_v2'

const fallbackKindLabel = (value: string | null | undefined) => {
  if (!value) return 'ط·آ¸أ¢â‚¬آ ط·آ·ط¢آ§ط·آ¸أ¢â‚¬آ¦ط·آ·ط¢آ´ط·آ·ط¢آ®ط·آ·ط¢آµ'
  switch (value) {
    case 'customer':
      return 'ط·آ¸أ¢â‚¬آ¦ط·آ·ط¢آ´ط·آ·ط¹آ¾ط·آ·ط¢آ±ط·ط›ط¥â€™'
    case 'supplier':
      return 'ط·آ·ط¹آ¾ط·آ·ط¢آ£ط·آ¸أ¢â‚¬آ¦ط·ط›ط¥â€™ط·آ¸أ¢â‚¬آ ط£آ¢أ¢â€ڑآ¬ط¥â€™ط·آ¹ط¢آ©ط·آ¸أ¢â‚¬آ ط·آ¸أ¢â‚¬آ ط·آ·ط¢آ¯ط·آ¸أ¢â‚¬طŒ'
    case 'other':
      return 'ط·آ·ط¢آ³ط·آ·ط¢آ§ط·ط›ط¥â€™ط·آ·ط¢آ±'
    default:
      return value
  }
}

const kindLabel = (id: string | null | undefined, tree: KindItem[]) => {
  if (!id) return 'ط·آ¸أ¢â‚¬آ ط·آ·ط¢آ§ط·آ¸أ¢â‚¬آ¦ط·آ·ط¢آ´ط·آ·ط¢آ®ط·آ·ط¢آµ'
  const item = tree.find(k => k.id === id)
  if (item?.title) return item.title
  return fallbackKindLabel(id)
}

export default function PeopleModule({ smartDate }: ModuleComponentProps) {
  const [people, setPeople] = useState<Person[]>([])
  const [balances, setBalances] = useState<PersonBalance[]>([])
  const [loading, setLoading] = useState(true)
  const [error, setError] = useState<string | null>(null)
  const [search, setSearch] = useState('')
  const [kindFilter, setKindFilter] = useState<'all' | string>('all')
  const [sortField, setSortField] = useState<'name' | 'created_at' | 'balance' | 'debit' | 'credit'>('name')
  const [sortOrder, setSortOrder] = useState<'asc' | 'desc'>('asc')
  const [showForm, setShowForm] = useState(false)
  const [creating, setCreating] = useState(false)
  const [formError, setFormError] = useState<string | null>(null)
  const [formSuccess, setFormSuccess] = useState<string | null>(null)
  const [selectedPerson, setSelectedPerson] = useState<Person | null>(null)
  const [ledgerData, setLedgerData] = useState<PersonLedger | null>(null)
  const [loadingLedger, setLoadingLedger] = useState(false)
  const [pageSize, setPageSize] = useState(20)
  const [kindTree, setKindTree] = useState<KindItem[]>([...DEFAULT_KIND_TREE])
  const [newKind, setNewKind] = useState({ id: '', title: '', parentId: 'root' as string | 'root' })
  const [kindError, setKindError] = useState<string | null>(null)
  const [accounts, setAccounts] = useState<PaymentAccount[]>([])

  const emptyForm = {
    name: '',
    kind: 'customer',
    mobile: '',
    code: '',
    description: '',
  }
  const [personForm, setPersonForm] = useState(emptyForm)

  useEffect(() => {
    loadPeople()
    loadBalances()
    loadAccounts()
  }, [])

  useEffect(() => {
    try {
      const raw = localStorage.getItem(KIND_STORAGE_KEY)
      if (raw) {
        const parsed = JSON.parse(raw)
        if (Array.isArray(parsed) && parsed.every((v: any) => typeof v.id === 'string')) {
          const ids = parsed.map((p: KindItem) => p.id)
          const missing = DEFAULT_KIND_TREE.filter(d => !ids.includes(d.id))
          setKindTree([...parsed, ...missing])
          return
        }
      }
    } catch (err) {
      console.warn('kind tree read failed', err)
    }
    setKindTree([...DEFAULT_KIND_TREE])
  }, [])

  useEffect(() => {
    if (!kindTree.find(k => k.id === personForm.kind)) {
      setPersonForm(prev => ({ ...prev, kind: kindTree[0]?.id ?? 'customer' }))
    }
    if (kindFilter !== 'all' && !kindTree.find(k => k.id === kindFilter)) {
      setKindFilter('all')
    }
  }, [kindTree, personForm.kind, kindFilter])

  const persistKinds = (next: KindItem[]) => {
    setKindTree(next)
    try {
      localStorage.setItem(KIND_STORAGE_KEY, JSON.stringify(next))
    } catch (err) {
      console.warn('persist kind fail', err)
    }
  }

  const addKind = () => {
    const id = newKind.id.trim()
    if (!id) return
    if (kindTree.some(k => k.id === id)) {
      setKindError('ط·آ·ط¢آ´ط·آ¸أ¢â‚¬آ ط·آ·ط¢آ§ط·آ·ط¢آ³ط·آ¸أ¢â‚¬طŒ ط·آ·ط¹آ¾ط·آ¹ط¢آ©ط·آ·ط¢آ±ط·آ·ط¢آ§ط·آ·ط¢آ±ط·ط›ط¥â€™ ط·آ·ط¢آ§ط·آ·ط¢آ³ط·آ·ط¹آ¾.')
      return
    }
    const parentId = newKind.parentId === 'root' ? null : newKind.parentId
    persistKinds([...kindTree, { id, title: newKind.title.trim() || undefined, parentId }])
    setNewKind({ id: '', title: '', parentId: 'root' })
    setKindError(null)
  }

  const loadPeople = async () => {
    setLoading(true)
    setError(null)
    try {
      const data = await apiGet<Person[]>('/api/persons')
      setPeople(data)
    } catch (err) {
      console.error(err)
      setError('ط·آ·ط¢آ¯ط·آ·ط¢آ±ط·ط›ط¥â€™ط·آ·ط¢آ§ط·آ¸ط¸آ¾ط·آ·ط¹آ¾ ط·آ¸ط¸آ¾ط·آ¸أ¢â‚¬طŒط·آ·ط¢آ±ط·آ·ط¢آ³ط·آ·ط¹آ¾ ط·آ·ط¢آ§ط·آ¸ط¸آ¾ط·آ·ط¢آ±ط·آ·ط¢آ§ط·آ·ط¢آ¯ ط·آ¸أ¢â‚¬آ¦ط·آ¸ط«â€ ط·آ¸ط¸آ¾ط·آ¸أ¢â‚¬ع‘ط·ط›ط¥â€™ط·آ·ط¹آ¾ط£آ¢أ¢â€ڑآ¬ط¥â€™ط·آ·ط¢آ¢ط·آ¸أ¢â‚¬آ¦ط·ط›ط¥â€™ط·آ·ط¢آ² ط·آ¸أ¢â‚¬آ ط·آ·ط¢آ¨ط·آ¸ط«â€ ط·آ·ط¢آ¯.')
    } finally {
      setLoading(false)
    }
  }

  const loadBalances = async () => {
    try {
      const data = await apiGet<{ balances: PersonBalance[] }>('/api/persons/balances')
      setBalances(data.balances)
    } catch (err) {
      console.error('Failed to load balances', err)
    }
  }

  const loadAccounts = async () => {
    try {
      const data = await apiGet<PaymentAccount[]>('/api/accounts').catch(() => [])
      setAccounts(data ?? [])
    } catch (err) {
      console.warn('Failed to load accounts', err)
    }
  }

  const handleFormChange = (field: keyof typeof emptyForm, value: string) => {
    setPersonForm(prev => ({ ...prev, [field]: value }))
  }

  const resetForm = () => {
    setPersonForm(emptyForm)
    setFormError(null)
    setFormSuccess(null)
  }

  const submitPerson = async (e: React.FormEvent) => {
    e.preventDefault()
    if (!personForm.name.trim()) {
      setFormError('ط·آ¸أ¢â‚¬آ ط·آ·ط¢آ§ط·آ¸أ¢â‚¬آ¦ ط·آ¸أ¢â‚¬آ¦ط·آ·ط¢آ®ط·آ·ط¢آ§ط·آ·ط¢آ·ط·آ·ط¢آ¨ ط·آ·ط¢آ±ط·آ·ط¢آ§ ط·آ¸ط«â€ ط·آ·ط¢آ§ط·آ·ط¢آ±ط·آ·ط¢آ¯ ط·آ¹ط¢آ©ط·آ¸أ¢â‚¬آ ط·ط›ط¥â€™ط·آ·ط¢آ¯.')
      return
    }
    setCreating(true)
    setFormError(null)
    try {
      const payload = {
        name: personForm.name.trim(),
        kind: personForm.kind.trim() || undefined,
        mobile: personForm.mobile.trim() || undefined,
        code: personForm.code.trim() || undefined,
        description: personForm.description.trim() || undefined,
      }
      const created = await apiPost<Person>('/api/persons', payload)
      setPeople(prev => [created, ...prev])
      setFormSuccess('ط·آ¸أ¢â‚¬آ¦ط·آ·ط¢آ®ط·آ·ط¢آ§ط·آ·ط¢آ·ط·آ·ط¢آ¨ ط·آ·ط¢آ°ط·آ·ط¢آ®ط·ط›ط¥â€™ط·آ·ط¢آ±ط·آ¸أ¢â‚¬طŒ ط·آ·ط¢آ´ط·آ·ط¢آ¯.')
      setPersonForm(emptyForm)
    } catch (err) {
      setFormError(err instanceof Error ? err.message : 'ط·آ·ط¢آ«ط·آ·ط¢آ¨ط·آ·ط¹آ¾ ط·آ¸أ¢â‚¬آ¦ط·آ·ط¢آ®ط·آ·ط¢آ§ط·آ·ط¢آ·ط·آ·ط¢آ¨ ط·آ·ط¢آ¨ط·آ·ط¢آ§ ط·آ·ط¢آ®ط·آ·ط¢آ·ط·آ·ط¢آ§ ط·آ·ط¢آ±ط·آ¸ط«â€ ط·آ·ط¢آ¨ط·آ¸أ¢â‚¬طŒط£آ¢أ¢â€ڑآ¬ط¥â€™ط·آ·ط¢آ±ط·آ¸ط«â€  ط·آ·ط¢آ´ط·آ·ط¢آ¯.')
    } finally {
      setCreating(false)
    }
  }

  const peopleWithBalances = useMemo(() => {
    return people.map(p => {
      const balance = balances.find(b => b.person_id === p.id)
      return {
        ...p,
        debit: balance?.debit ?? 0,
        credit: balance?.credit ?? 0,
        balance: balance?.balance ?? 0,
      }
    })
  }, [people, balances])

  const filtered = useMemo(() => {
    return peopleWithBalances
      .filter(p => (kindFilter === 'all' ? true : (p.kind ?? 'other') === kindFilter))
      .filter(p => {
        if (!search) return true
        const hay = `${p.name} ${p.mobile ?? ''} ${p.code ?? ''}`.toLowerCase()
        return hay.includes(search.toLowerCase())
      })
      .sort((a, b) => {
        let aVal: any = a[sortField]
        let bVal: any = b[sortField]
        if (sortField === 'debit' || sortField === 'credit' || sortField === 'balance') {
          aVal = Number(aVal) || 0
          bVal = Number(bVal) || 0
        }
        if (sortField === 'created_at') {
          aVal = new Date(aVal).getTime()
          bVal = new Date(bVal).getTime()
        }
        if (aVal < bVal) return sortOrder === 'asc' ? -1 : 1
        if (aVal > bVal) return sortOrder === 'asc' ? 1 : -1
        return 0
      })
  }, [peopleWithBalances, kindFilter, search, sortField, sortOrder])

  const visiblePeople = useMemo(() => filtered.slice(0, pageSize), [filtered, pageSize])

  const handleSort = (field: typeof sortField) => {
    if (sortField === field) {
      setSortOrder(prev => (prev === 'asc' ? 'desc' : 'asc'))
    } else {
      setSortField(field)
      setSortOrder('asc')
    }
  }

  const handlePrint = () => {
    window.print()
  }

  const loadPersonLedger = async (person: Person) => {
    setSelectedPerson(person)
    setLoadingLedger(true)
    setLedgerData(null)
    try {
      const data = await apiGet<PersonLedger>(`/api/ledger/party/${person.id}`)
      setLedgerData(data)
    } catch (err) {
      console.error(err)
      setError('ط·آ·ط¢آ¯ط·آ·ط¢آ±ط·ط›ط¥â€™ط·آ·ط¢آ§ط·آ¸ط¸آ¾ط·آ·ط¹آ¾ ط·آ¹ط¢آ¯ط·آ·ط¢آ±ط·آ·ط¢آ¯ط·آ·ط¢آ´ ط·آ·ط¢آ­ط·آ·ط¢آ³ط·آ·ط¢آ§ط·آ·ط¢آ¨ ط·آ·ط¢آ¨ط·آ·ط¢آ§ ط·آ·ط¢آ®ط·آ·ط¢آ·ط·آ·ط¢آ§ ط·آ¸أ¢â‚¬آ¦ط·آ¸ط«â€ ط·آ·ط¢آ§ط·آ·ط¢آ¬ط·آ¸أ¢â‚¬طŒ ط·آ·ط¢آ´ط·آ·ط¢آ¯.')
    } finally {
      setLoadingLedger(false)
    }
  }

  const exportLedger = () => {
    if (!ledgerData) return
    const rows = ledgerData.entries.map(entry => {
      const payLabel = entry.payment ? resolvePaymentMethodLabel(entry.payment.method, accounts) : ''
      const payCell = entry.payment?.reference ? `${payLabel} - ${entry.payment.reference}` : payLabel
      return [
        new Date(entry.entry_date).toLocaleDateString('fa-IR'),
        entry.description,
        entry.debit_account === 'AccountsReceivable' ? formatNumberFa(entry.amount) : '',
        entry.credit_account === 'AccountsReceivable' ? formatNumberFa(entry.amount) : '',
        formatNumberFa(entry.running_balance),
        entry.invoice?.invoice_number ?? '',
        payCell,
      ].join('\t')
    })
    const csv = ['ط·آ·ط¹آ¾ط·آ·ط¢آ§ط·آ·ط¢آ±ط·ط›ط¥â€™ط·آ·ط¢آ®\tط·آ·ط¢آ´ط·آ·ط¢آ±ط·آ·ط¢آ­\tط·آ·ط¢آ¯ط·آ·ط¢آ±ط·ط›ط¥â€™ط·آ·ط¢آ§ط·آ¸ط¸آ¾ط·آ·ط¹آ¾\tط·آ¸ط¢آ¾ط·آ·ط¢آ±ط·آ·ط¢آ¯ط·آ·ط¢آ§ط·آ·ط¢آ®ط·آ·ط¹آ¾\tط·آ¸أ¢â‚¬آ¦ط·آ·ط¢آ§ط·آ¸أ¢â‚¬آ ط·آ·ط¢آ¯ط·آ¸أ¢â‚¬طŒ\tط·آ¸ط¸آ¾ط·آ·ط¢آ§ط·آ¹ط¢آ©ط·آ·ط¹آ¾ط·آ¸ط«â€ ط·آ·ط¢آ±\tط·آ¸أ¢â‚¬آ¦ط·آ·ط¢آ±ط·آ·ط¢آ¬ط·آ·ط¢آ¹', ...rows].join('\n')
    const blob = new Blob(['\ufeff' + csv], { type: 'text/csv;charset=utf-8;' })
    const url = URL.createObjectURL(blob)
    const link = document.createElement('a')
    link.href = url
    link.download = `ledger-${ledgerData.person.name}-${new Date().toISOString().split('T')[0]}.csv`
    link.click()
    URL.revokeObjectURL(url)
  }

  if (loading) {
    return (
      <div className={`${retroPanel} p-10 flex items-center justify-center`}>
        <div className="space-y-3 text-center">
          <div className="mx-auto h-8 w-8 border-4 border-[#1f2e3b] border-dashed rounded-full animate-spin"></div>
          <p className={`${retroHeading} text-[#1f2e3b]`}>ط·آ·ط¢آ¯ط·آ·ط¢آ± ط·آ·ط¢آ­ط·آ·ط¢آ§ط·آ¸أ¢â‚¬â€چ ط·آ·ط¢آ¨ط·آ·ط¢آ§ط·آ·ط¢آ±ط·آ¹ط¢آ¯ط·آ·ط¢آ°ط·آ·ط¢آ§ط·آ·ط¢آ±ط·ط›ط¥â€™ ط·آ¸أ¢â‚¬آ¦ط·آ·ط¢آ®ط·آ·ط¢آ§ط·آ·ط¢آ·ط·آ·ط¢آ¨ط·آ·ط¢آ§ط·آ¸أ¢â‚¬آ ...</p>
        </div>
      </div>
    )
  }

  return (
    <div className="space-y-8">
      {error && (
        <div className="border-2 border-[#c35c5c] bg-[#f9e6e6] text-[#5b1f1f] px-4 py-3 shadow-[4px_4px_0_#c35c5c]">
          {error}
        </div>
      )}

      <section className={`${retroPanelPadded} space-y-4 bg-[#fdf7e6]`}>
        <header className="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4">
          <div>
            <p className={retroHeading}>ط·آ¸أ¢â‚¬آ¦ط·آ·ط¢آ®ط·آ·ط¢آ§ط·آ·ط¢آ·ط·آ·ط¢آ¨ط·آ·ط¢آ§ط·آ¸أ¢â‚¬آ </p>
            <h2 className="text-2xl font-semibold mt-2">ط·آ¸أ¢â‚¬آ¦ط·آ·ط¢آ¯ط·ط›ط¥â€™ط·آ·ط¢آ±ط·ط›ط¥â€™ط·آ·ط¹آ¾ ط·آ·ط¢آ§ط·آ·ط¢آ±ط·آ·ط¹آ¾ط·آ·ط¢آ¨ط·آ·ط¢آ§ط·آ·ط¢آ·ط·آ·ط¢آ§ط·آ·ط¹آ¾ ط·آ·ط¹آ¾ط·آ·ط¢آ¬ط·آ·ط¢آ§ط·آ·ط¢آ±ط·ط›ط¥â€™</h2>
            <p className={`text-xs ${retroMuted} mt-2`}>
              ط·آ·ط¹آ¾ط·آ·ط¢آ§ط·آ·ط¢آ±ط·ط›ط¥â€™ط·آ·ط¢آ® ط·آ¸أ¢â‚¬طŒط·آ¸ط«â€ ط·آ·ط¢آ´ط·آ¸أ¢â‚¬آ¦ط·آ¸أ¢â‚¬آ ط·آ·ط¢آ¯: {smartDate.jalali ?? 'ط·آ·ط¹آ¾ط·آ·ط¢آ¹ط·آ·ط¢آ±ط·ط›ط¥â€™ط·آ¸ط¸آ¾ ط·آ¸أ¢â‚¬آ ط·آ·ط¢آ´ط·آ·ط¢آ¯ط·آ¸أ¢â‚¬طŒ'} | {smartDate.isoDate ?? 'ISO TBD'}
            </p>
          </div>
          <div className="flex flex-wrap gap-2">
            <button className={`${retroButton} !bg-[#1f2e3b]`} onClick={() => { loadPeople(); loadBalances(); }}>
              ط·آ·ط¹آ¾ط·آ·ط¢آ§ط·آ·ط¢آ²ط·آ¸أ¢â‚¬طŒط£آ¢أ¢â€ڑآ¬ط¥â€™ط·آ·ط¢آ³ط·آ·ط¢آ§ط·آ·ط¢آ²ط·ط›ط¥â€™
            </button>
            <button
              className={retroButton}
              onClick={() => {
                resetForm()
                setShowForm(true)
              }}
            >
              ط·آ·ط¢آ§ط·آ¸ط¸آ¾ط·آ·ط¢آ²ط·آ¸ط«â€ ط·آ·ط¢آ¯ط·آ¸أ¢â‚¬آ  ط·آ¸أ¢â‚¬آ¦ط·آ·ط¢آ®ط·آ·ط¢آ§ط·آ·ط¢آ·ط·آ·ط¢آ¨
            </button>
          </div>
        </header>

        <div className="grid grid-cols-1 md:grid-cols-3 gap-4 text-sm">
          <div className={`${retroPanel} bg-white/80 px-4 py-3 shadow-inner`}>
            <p className={retroHeading}>ط·آ¹ط¢آ©ط·آ¸أ¢â‚¬â€چ ط·آ¸أ¢â‚¬آ¦ط·آ·ط¢آ®ط·آ·ط¢آ§ط·آ·ط¢آ·ط·آ·ط¢آ¨ط·آ·ط¢آ§ط·آ¸أ¢â‚¬آ </p>
            <p className="text-2xl font-semibold">{formatNumberFa(people.length)}</p>
          </div>
          <div className={`${retroPanel} bg-white/80 px-4 py-3 shadow-inner`}>
            <p className={retroHeading}>ط·آ¸أ¢â‚¬آ¦ط·آ·ط¢آ´ط·آ·ط¹آ¾ط·آ·ط¢آ±ط·ط›ط¥â€™ط·آ·ط¢آ§ط·آ¸أ¢â‚¬آ </p>
            <p className="text-2xl font-semibold">
              {formatNumberFa(people.filter(p => p.kind === 'customer').length)}
            </p>
