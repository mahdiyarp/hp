            placeholder="ط·آ·ط¢آ´ط·آ¸أ¢â‚¬آ ط·آ·ط¢آ§ط·آ·ط¢آ³ط·آ¸أ¢â‚¬طŒ (customer_vip)"
            value={newKind.id}
            onChange={e => setNewKind(prev => ({ ...prev, id: e.target.value }))}
          />
          <input
            className={`${retroInput} w-32`}
            placeholder="ط·آ·ط¢آ¹ط·آ¸أ¢â‚¬آ ط·آ¸ط«â€ ط·آ·ط¢آ§ط·آ¸أ¢â‚¬آ  (ط·آ¸ط«â€ ط·ط›ط¥â€™ط·آ¹ط¹آ©ط·آ¸أ¢â‚¬طŒ)"
            value={newKind.title}
            onChange={e => setNewKind(prev => ({ ...prev, title: e.target.value }))}
          />
          <select
            className={`${retroInput} w-32`}
            value={newKind.parentId}
            onChange={e => setNewKind(prev => ({ ...prev, parentId: e.target.value }))}
          >
            <option value="root">ط·آ·ط¢آ¨ط·آ·ط¢آ¯ط·آ¸ط«â€ ط·آ¸أ¢â‚¬آ  ط·آ¸ط«â€ ط·آ·ط¢آ§ط·آ¸أ¢â‚¬â€چط·آ·ط¢آ¯</option>
            {kindTree.map(kind => (
              <option key={kind.id} value={kind.id}>
                {kindLabel(kind.id, kindTree)}
              </option>
            ))}
          </select>
          <button className={`${retroButton} !bg-[#1f2e3b]`} onClick={addKind} disabled={!newKind.id.trim()}>
            ط·آ·ط¢آ«ط·آ·ط¢آ¨ط·آ·ط¹آ¾ ط·آ¸أ¢â‚¬آ ط·آ¸ط«â€ ط·آ·ط¢آ¹ ط·آ·ط¢آ¬ط·آ·ط¢آ¯ط·ط›ط¥â€™ط·آ·ط¢آ¯
          </button>
        </div>
        {kindError && <div className="text-sm text-[#5b1f1f]">{kindError}</div>}
        <div className="grid grid-cols-1 md:grid-cols-2 gap-3">
          {kindTree.map(kind => (
            <div key={kind.id} className="border border-dashed border-[#c5bca5] px-4 py-3 bg-white space-y-1">
              <p className="font-semibold">{kindLabel(kind.id, kindTree)}</p>
              <p className="text-[11px] text-[#7a6b4f]">ط·آ·ط¢آ´ط·آ¸أ¢â‚¬آ ط·آ·ط¢آ§ط·آ·ط¢آ³ط·آ¸أ¢â‚¬طŒ: {kind.id}</p>
              <p className="text-[11px] text-[#7a6b4f]">
                ط·آ¸ط«â€ ط·آ·ط¢آ§ط·آ¸أ¢â‚¬â€چط·آ·ط¢آ¯: {kind.parentId ? kindLabel(kind.parentId, kindTree) : 'ط·آ·ط¢آ¨ط·آ·ط¢آ¯ط·آ¸ط«â€ ط·آ¸أ¢â‚¬آ  ط·آ¸ط«â€ ط·آ·ط¢آ§ط·آ¸أ¢â‚¬â€چط·آ·ط¢آ¯'}
              </p>
            </div>
          ))}
        </div>
      </section>

      {selectedPerson && (
        <div className="fixed inset-0 bg-black bg-opacity-40 flex items-center justify-center p-4 z-50">
          <div className={`${retroPanelPadded} max-w-6xl w-full max-h-[90vh] overflow-y-auto space-y-4`}>
            <header className="flex items-center justify-between gap-3 sticky top-0 bg-[#fdf7e6] pb-3 border-b border-[#c5bca5]">
              <div>
                <p className={retroHeading}>ط·آ¹ط¢آ¯ط·آ·ط¢آ±ط·آ·ط¢آ¯ط·آ·ط¢آ´ ط·آ·ط¢آ­ط·آ·ط¢آ³ط·آ·ط¢آ§ط·آ·ط¢آ¨</p>
                <h3 className="text-xl font-semibold mt-2">{selectedPerson.name}</h3>
                <p className="text-xs text-[#7a6b4f]">
                  {kindLabel(selectedPerson.kind, kindTree)} {selectedPerson.mobile && `| ${selectedPerson.mobile}`}
                </p>
              </div>
              <div className="flex gap-2">
                {ledgerData && (
                  <button className={`${retroButton} !bg-[#1f2e3b]`} onClick={exportLedger}>
                    ط·آ·ط¢آ®ط·آ·ط¢آ±ط·آ¸ط«â€ ط·آ·ط¢آ¬ط·ط›ط¥â€™ CSV
                  </button>
                )}
                <button className={`${retroButton} !bg-[#5b4a2f]`} onClick={() => setSelectedPerson(null)}>
                  ط·آ·ط¢آ¨ط·آ·ط¢آ³ط·آ·ط¹آ¾ط·آ¸أ¢â‚¬آ 
                </button>
              </div>
            </header>

            {loadingLedger ? (
              <div className="flex items-center justify-center py-12">
                <div className="space-y-3 text-center">
                  <div className="mx-auto h-8 w-8 border-4 border-[#1f2e3b] border-dashed rounded-full animate-spin"></div>
                  <p className={`${retroHeading} text-[#1f2e3b]`}>ط·آ·ط¢آ¯ط·آ·ط¢آ± ط·آ·ط¢آ­ط·آ·ط¢آ§ط·آ¸أ¢â‚¬â€چ ط·آ·ط¢آ¨ط·آ·ط¢آ§ط·آ·ط¢آ±ط·آ¹ط¢آ¯ط·آ·ط¢آ°ط·آ·ط¢آ§ط·آ·ط¢آ±ط·ط›ط¥â€™ ط·آ¹ط¢آ¯ط·آ·ط¢آ±ط·آ·ط¢آ¯ط·آ·ط¢آ´ ط·آ¸أ¢â‚¬آ¦ط·آ·ط¢آ§ط·آ¸أ¢â‚¬â€چط·ط›ط¥â€™...</p>
                </div>
              </div>
            ) : ledgerData ? (
              <>
                <div className="grid grid-cols-3 gap-3">
                  <div className="border border-[#bfb69f] bg-[#f6f1df] px-4 py-3 shadow-inner">
                    <p className={retroHeading}>ط·آ·ط¢آ¬ط·آ¸أ¢â‚¬آ¦ط·آ·ط¢آ¹ ط·آ·ط¢آ¯ط·آ·ط¢آ±ط·ط›ط¥â€™ط·آ·ط¢آ§ط·آ¸ط¸آ¾ط·آ·ط¹آ¾</p>
                    <p className="text-2xl font-semibold text-red-700">{formatNumberFa(ledgerData.debit_total)}</p>
                  </div>
                  <div className="border border-[#bfb69f] bg-[#f6f1df] px-4 py-3 shadow-inner">
                    <p className={retroHeading}>ط·آ·ط¢آ¬ط·آ¸أ¢â‚¬آ¦ط·آ·ط¢آ¹ ط·آ¸ط¢آ¾ط·آ·ط¢آ±ط·آ·ط¢آ¯ط·آ·ط¢آ§ط·آ·ط¢آ®ط·آ·ط¹آ¾</p>
                    <p className="text-2xl font-semibold text-green-700">{formatNumberFa(ledgerData.credit_total)}</p>
                  </div>
                  <div className="border border-[#bfb69f] bg-[#f6f1df] px-4 py-3 shadow-inner">
                    <p className={retroHeading}>ط·آ¸أ¢â‚¬آ¦ط·آ·ط¢آ§ط·آ¸أ¢â‚¬آ ط·آ·ط¢آ¯ط·آ¸أ¢â‚¬طŒ ط·آ¸أ¢â‚¬آ ط·آ¸أ¢â‚¬طŒط·آ·ط¢آ§ط·ط›ط¥â€™ط·ط›ط¥â€™</p>
                    <p className={`text-2xl font-semibold ${ledgerData.net_balance > 0 ? 'text-red-700' : ledgerData.net_balance < 0 ? 'text-green-700' : 'text-[#7a6b4f]'}`}>
                      {ledgerData.net_balance === 0
                        ? 'ط·آ¸أ¢â‚¬آ¦ط·آ·ط¹آ¾ط·آ¸ط«â€ ط·آ·ط¢آ§ط·آ·ط¢آ²ط·آ¸أ¢â‚¬آ '
                        : `${formatNumberFa(Math.abs(ledgerData.net_balance))} ${ledgerData.net_balance > 0 ? '(ط·آ·ط¢آ¨ط·آ·ط¢آ¯ط·آ¸أ¢â‚¬طŒط·آ¹ط¢آ©ط·آ·ط¢آ§ط·آ·ط¢آ±)' : '(ط·آ·ط¢آ¨ط·آ·ط¢آ³ط·آ·ط¹آ¾ط·آ·ط¢آ§ط·آ¸أ¢â‚¬آ ط·آ¹ط¢آ©ط·آ·ط¢آ§ط·آ·ط¢آ±)'}`}
                    </p>
                  </div>
                </div>
                {ledgerData.entries.length ? (
                  <div className="overflow-x-auto">
                    <table className="w-full border border-[#c5bca5] bg-[#faf4de] text-sm">
                      <thead>
                        <tr>
                          <th className={retroTableHeader}>ط·آ·ط¹آ¾ط·آ·ط¢آ§ط·آ·ط¢آ±ط·ط›ط¥â€™ط·آ·ط¢آ®</th>
                          <th className={retroTableHeader}>ط·آ·ط¢آ´ط·آ·ط¢آ±ط·آ·ط¢آ­</th>
                          <th className={retroTableHeader}>ط·آ·ط¢آ¯ط·آ·ط¢آ±ط·ط›ط¥â€™ط·آ·ط¢آ§ط·آ¸ط¸آ¾ط·آ·ط¹آ¾</th>
                          <th className={retroTableHeader}>ط·آ¸ط¢آ¾ط·آ·ط¢آ±ط·آ·ط¢آ¯ط·آ·ط¢آ§ط·آ·ط¢آ®ط·آ·ط¹آ¾</th>
                          <th className={retroTableHeader}>ط·آ¸أ¢â‚¬آ¦ط·آ·ط¢آ§ط·آ¸أ¢â‚¬آ ط·آ·ط¢آ¯ط·آ¸أ¢â‚¬طŒ</th>
                          <th className={retroTableHeader}>ط·آ·ط¢آ­ط·آ¸ط«â€ ط·آ·ط¢آ§ط·آ¸أ¢â‚¬â€چط·آ¸أ¢â‚¬طŒ</th>
                        </tr>
                      </thead>
                      <tbody>
                        {ledgerData.entries.map(entry => (
                          <tr key={entry.id} className="border-b border-[#d9cfb6] hover:bg-[#f6f1df]">
                            <td className="px-3 py-2 text-xs">{new Date(entry.entry_date).toLocaleDateString('fa-IR')}</td>
                            <td className="px-3 py-2">
                              {entry.description}
                              {entry.invoice && (
                                <span className="block text-[10px] text-blue-700 mt-1">ط·آ¸ط¸آ¾ط·آ·ط¢آ§ط·آ¹ط¢آ©ط·آ·ط¹آ¾ط·آ¸ط«â€ ط·آ·ط¢آ±: {entry.invoice.invoice_number}</span>
                              )}
                              {entry.payment && (
                                <span className="block text-[10px] text-green-700 mt-1">
                                  ط·آ¸ط¢آ¾ط·آ·ط¢آ±ط·آ·ط¢آ¯ط·آ·ط¢آ§ط·آ·ط¢آ®ط·آ·ط¹آ¾:{' '}
                                  {resolvePaymentMethodLabel(entry.payment.method, accounts)}
                                  {entry.payment.reference ? ` - ${entry.payment.reference}` : ''}
                                </span>
                              )}
                            </td>
                            <td className="px-3 py-2 text-left text-red-700 font-mono">
                              {entry.debit_account === 'AccountsReceivable' ? formatNumberFa(entry.amount) : '-'}
                            </td>
                            <td className="px-3 py-2 text-left text-green-700 font-mono">
                              {entry.credit_account === 'AccountsReceivable' ? formatNumberFa(entry.amount) : '-'}
                            </td>
                            <td className="px-3 py-2 text-left font-mono">{formatNumberFa(entry.running_balance)}</td>
                            <td className="px-3 py-2 text-xs text-[#7a6b4f]">ط£آ¢أ¢â€ڑآ¬أ¢â‚¬â€Œ</td>
                          </tr>
                        ))}
                      </tbody>
                    </table>
                  </div>
                ) : (
                  <div className="text-center text-[#7a6b4f] py-8">ط·آ¸ط«â€ ط·آ·ط¢آ±ط·آ¸ط«â€ ط·آ·ط¢آ¯ ط·آ¸أ¢â‚¬آ¦ط·آ·ط¢آ§ط·آ¸أ¢â‚¬â€چط·ط›ط¥â€™ ط·آ·ط¢آ¨ط·آ·ط¢آ±ط·آ·ط¢آ§ط·ط›ط¥â€™ ط·آ·ط¢آ§ط·ط›ط¥â€™ط·آ¸أ¢â‚¬آ  ط·آ¸أ¢â‚¬آ¦ط·آ·ط¢آ®ط·آ·ط¢آ§ط·آ·ط¢آ·ط·آ·ط¢آ¨ ط·آ·ط¢آ«ط·آ·ط¢آ¨ط·آ·ط¹آ¾ ط·آ¸أ¢â‚¬آ ط·آ·ط¢آ´ط·آ·ط¢آ¯ط·آ¸أ¢â‚¬طŒ ط·آ·ط¢آ§ط·آ·ط¢آ³ط·آ·ط¹آ¾.</div>
                )}
              </>
            ) : null}
          </div>
        </div>
      )}
    </div>
  )
}
