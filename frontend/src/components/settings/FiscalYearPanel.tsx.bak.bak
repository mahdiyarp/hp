import React, { useEffect, useState } from 'react'
import { apiGet, apiPost } from '../../services/api'
import { retroBadge, retroButton, retroHeading, retroInput, retroPanelPadded } from '../retroTheme'

type FiscalYear = {
  id: number
  title: string
  start_date: string
  end_date: string
  status: 'open' | 'closed' | 'locked'
  is_current: boolean
}

type CreatePayload = {
  title: string
  start_date: string
  end_date: string
  is_current: boolean
}

type ActionResult = {
  fiscal_year: FiscalYear
  status: string
  warnings?: string[]
}

const badgeForStatus = (fy: FiscalYear) => {
  const base = `${retroBadge} border`
  if (fy.status === 'open') return `${base} bg-[#e6f9ef] border-[#9ac8a5] text-[#0f5132]`
  if (fy.status === 'closed') return `${base} bg-[#fff4e0] border-[#f2c890] text-[#7c4a03]`
  return `${base} bg-[#ffe6e6] border-[#f2b1b1] text-[#8b1d1d]`
}

export default function FiscalYearPanel() {
  const [fiscalYears, setFiscalYears] = useState<FiscalYear[]>([])
  const [form, setForm] = useState<CreatePayload>({
    title: '',
    start_date: '',
    end_date: '',
    is_current: false,
  })
  const [toast, setToast] = useState<string>('')
  const [busy, setBusy] = useState(false)

  const loadYears = async () => {
    try {
      const data = await apiGet<FiscalYear[]>('/api/fiscal-years')
      setFiscalYears(data || [])
    } catch (err: any) {
      setToast(err?.message || 'ط·آ®ط·آ·ط·آ§ ط·آ¯ط·آ± ط·آ¯ط·آ±ط؛إ’ط·آ§ط¸ظ¾ط·ع¾ ط·آ³ط·آ§ط¸â€‍أ¢â‚¬إ’ط¸â€،ط·آ§ط؛إ’ ط¸â€¦ط·آ§ط¸â€‍ط؛إ’')
    }
  }

  useEffect(() => {
    loadYears()
  }, [])

  const showToast = (txt: string) => {
    setToast(txt)
    setTimeout(() => setToast(''), 2500)
  }

  const submitNew = async () => {
    if (!form.title || !form.start_date || !form.end_date) {
      showToast('ط·آ¹ط¸â€ ط¸ث†ط·آ§ط¸â€  ط¸ث† ط·ع¾ط·آ§ط·آ±ط؛إ’ط·آ®أ¢â‚¬إ’ط¸â€،ط·آ§ ط·آ§ط¸â€‍ط·آ²ط·آ§ط¸â€¦ط؛إ’ ط·آ§ط·آ³ط·ع¾.')
      return
    }
    setBusy(true)
    try {
      await apiPost('/api/fiscal-years', form)
      showToast('ط·آ³ط·آ§ط¸â€‍ ط¸â€¦ط·آ§ط¸â€‍ط؛إ’ ط·آ§ط؛إ’ط·آ¬ط·آ§ط·آ¯ ط·آ´ط·آ¯.')
      setForm({ title: '', start_date: '', end_date: '', is_current: false })
      await loadYears()
    } catch (err: any) {
      showToast(err?.message || 'ط·آ§ط؛إ’ط·آ¬ط·آ§ط·آ¯ ط·آ³ط·آ§ط¸â€‍ ط¸â€¦ط·آ§ط¸â€‍ط؛إ’ ط¸â€ ط·آ§ط¸â€¦ط¸ث†ط¸ظ¾ط¸â€ڑ ط·آ¨ط¸ث†ط·آ¯')
    } finally {
      setBusy(false)
    }
  }

  const doAction = async (id: number, action: 'activate' | 'close' | 'lock') => {
    const confirmMsg =
      action === 'activate'
        ? 'ط¸ظ¾ط·آ¹ط·آ§ط¸â€‍أ¢â‚¬إ’ط·آ³ط·آ§ط·آ²ط؛إ’ ط·آ³ط·آ§ط¸â€‍ ط¸â€¦ط·آ§ط¸â€‍ط؛إ’ط·ع؛'
        : action === 'close'
          ? 'ط·آ¨ط·آ³ط·ع¾ط¸â€  ط·آ³ط·آ§ط¸â€‍ ط¸â€¦ط·آ§ط¸â€‍ط؛إ’ط·ع؛'
          : 'ط¸â€ڑط¸ظ¾ط¸â€‍ ط¸â€ ط¸â€،ط·آ§ط؛إ’ط؛إ’ ط·آ§ط؛إ’ط¸â€  ط·آ³ط·آ§ط¸â€‍ ط¸â€¦ط·آ§ط¸â€‍ط؛إ’ط·ع؛'
    if (!window.confirm(confirmMsg)) return
    setBusy(true)
    try {
      const path =
        action === 'activate'
          ? `/api/fiscal-years/${id}/activate`
          : action === 'close'
            ? `/api/fiscal-years/${id}/close`
            : `/api/fiscal-years/${id}/lock`
      const res = await apiPost<ActionResult>(path)
      showToast(res?.status === 'locked' ? 'ط·آ³ط·آ§ط¸â€‍ ط¸â€¦ط·آ§ط¸â€‍ط؛إ’ ط¸â€ڑط¸ظ¾ط¸â€‍ ط·آ´ط·آ¯.' : 'ط·آ¹ط¸â€¦ط¸â€‍ط؛إ’ط·آ§ط·ع¾ ط·آ§ط¸â€ ط·آ¬ط·آ§ط¸â€¦ ط·آ´ط·آ¯.')
      await loadYears()
    } catch (err: any) {
      showToast(err?.message || 'ط·آ¹ط¸â€¦ط¸â€‍ط؛إ’ط·آ§ط·ع¾ ط¸â€ ط·آ§ط¸â€¦ط¸ث†ط¸ظ¾ط¸â€ڑ ط·آ¨ط¸ث†ط·آ¯')
    } finally {
      setBusy(false)
    }
  }

  return (
    <section className={`${retroPanelPadded} space-y-4 bg-[#f7f2e7] border border-[#e0d4b8] shadow-[6px_6px_0_rgba(0,0,0,0.08)]`}>
      <div className="flex items-center justify-between flex-wrap gap-3">
        <div>
          <p className={retroHeading}>ط·آ³ط·آ§ط¸â€‍أ¢â‚¬إ’ط¸â€،ط·آ§ط؛إ’ ط¸â€¦ط·آ§ط¸â€‍ط؛إ’</p>
          <p className="text-sm text-[#4b4339]">ط¸â€¦ط·آ¯ط؛إ’ط·آ±ط؛إ’ط·ع¾ ط·آ§ط؛إ’ط·آ¬ط·آ§ط·آ¯ط·إ’ ط¸ظ¾ط·آ¹ط·آ§ط¸â€‍أ¢â‚¬إ’ط·آ³ط·آ§ط·آ²ط؛إ’ط·إ’ ط·آ¨ط·آ³ط·ع¾ط¸â€  ط¸ث† ط¸â€ڑط¸ظ¾ط¸â€‍ ط·آ³ط·آ§ط¸â€‍ ط¸â€¦ط·آ§ط¸â€‍ط؛إ’</p>
        </div>
        {toast && <span className={`${retroBadge} bg-[#fff4e0] border-[#f2c890] text-[#7c4a03]`}>{toast}</span>}
      </div>

      <div className="grid md:grid-cols-4 gap-3 items-end bg-white border border-[#e0d4b8] p-3 rounded-lg">
        <label className="text-sm text-[#4b4339] space-y-1">
          ط·آ¹ط¸â€ ط¸ث†ط·آ§ط¸â€ 
          <input className={retroInput} value={form.title} onChange={e => setForm({ ...form, title: e.target.value })} placeholder="ط؛آ±ط؛آ´ط؛آ°ط؛آ³" />
        </label>
        <label className="text-sm text-[#4b4339] space-y-1">
          ط·آ´ط·آ±ط¸ث†ط·آ¹
          <input type="date" className={retroInput} value={form.start_date} onChange={e => setForm({ ...form, start_date: e.target.value })} />
        </label>
        <label className="text-sm text-[#4b4339] space-y-1">
          ط¸آ¾ط·آ§ط؛إ’ط·آ§ط¸â€ 
          <input type="date" className={retroInput} value={form.end_date} onChange={e => setForm({ ...form, end_date: e.target.value })} />
        </label>
        <div className="flex items-center gap-2">
          <label className="text-sm flex items-center gap-2">
            <input type="checkbox" checked={form.is_current} onChange={e => setForm({ ...form, is_current: e.target.checked })} />
            ط·آ³ط·آ§ط¸â€‍ ط·آ¬ط·آ§ط·آ±ط؛إ’
          </label>
          <button className={retroButton} disabled={busy} onClick={submitNew}>
            ط·آ§ط؛إ’ط·آ¬ط·آ§ط·آ¯
          </button>
        </div>
      </div>

      <div className="overflow-auto">
        <table className="w-full text-sm border border-[#e0d4b8] bg-white">
          <thead className="bg-[#efe8d8] text-[#2f281f]">
            <tr>
              <th className="px-3 py-2 text-right">ط·آ¹ط¸â€ ط¸ث†ط·آ§ط¸â€ </th>
              <th className="px-3 py-2 text-right">ط·آ§ط·آ²</th>
              <th className="px-3 py-2 text-right">ط·ع¾ط·آ§</th>
              <th className="px-3 py-2 text-right">ط¸ث†ط·آ¶ط·آ¹ط؛إ’ط·ع¾</th>
              <th className="px-3 py-2 text-right">ط·آ¬ط·آ§ط·آ±ط؛إ’</th>
              <th className="px-3 py-2 text-right">ط·آ§ط¸â€ڑط·آ¯ط·آ§ط¸â€¦ط·آ§ط·ع¾</th>
            </tr>
          </thead>
          <tbody>
            {fiscalYears.map(fy => (
              <tr key={fy.id} className="border-t border-[#e0d4b8]">
                <td className="px-3 py-2">{fy.title}</td>
                <td className="px-3 py-2">{fy.start_date?.slice(0, 10) || '-'}</td>
                <td className="px-3 py-2">{fy.end_date?.slice(0, 10) || '-'}</td>
                <td className="px-3 py-2">
                  <span className={badgeForStatus(fy)}>{fy.status}</span>
                </td>
                <td className="px-3 py-2">{fy.is_current ? <span className={`${retroBadge} bg-[#e6f9ef] border-[#9ac8a5] text-[#0f5132]`}>ط¸ظ¾ط·آ¹ط·آ§ط¸â€‍</span> : '---'}</td>
                <td className="px-3 py-2 space-x-2 space-x-reverse">
                  <button className={retroButton} disabled={busy || fy.is_current} onClick={() => doAction(fy.id, 'activate')}>
                    ط¸ظ¾ط·آ¹ط·آ§ط¸â€‍ ط¹آ©ط·آ±ط·آ¯ط¸â€ 
                  </button>
                  <button className={retroButton} disabled={busy || fy.status !== 'open'} onClick={() => doAction(fy.id, 'close')}>
                    ط·آ¨ط·آ³ط·ع¾ط¸â€ 
                  </button>
                  <button className={retroButton} disabled={busy || fy.status !== 'closed'} onClick={() => doAction(fy.id, 'lock')}>
                    ط¸â€ڑط¸ظ¾ط¸â€‍ ط¸â€ ط¸â€،ط·آ§ط؛إ’ط؛إ’
                  </button>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  )
}
