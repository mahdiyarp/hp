import React, { useEffect, useState } from 'react'
import { apiGet, apiPost, apiPut } from '../../services/api'
import { retroBadge, retroButton, retroHeading, retroInput, retroPanelPadded } from '../retroTheme'

type SmsSettings = {
  provider?: string
  base_url?: string | null
  default_sender?: string | null
  enabled?: boolean
  low_credit_threshold?: number | null
  api_key_masked?: string | null
}

export default function SmsSettingsPanel() {
  const [settings, setSettings] = useState<SmsSettings>({
    provider: 'ippanel',
    base_url: 'https://edge.ippanel.com/v1',
    default_sender: '',
    enabled: false,
    low_credit_threshold: 0,
    api_key_masked: null,
  })
  const [toast, setToast] = useState<string>('')
  const [testNumber, setTestNumber] = useState('')
  const [busy, setBusy] = useState(false)
  const [apiKeyInput, setApiKeyInput] = useState('')

  const load = async () => {
    try {
      const data = await apiGet<SmsSettings>('/api/settings/sms')
      if (data) setSettings(prev => ({ ...prev, ...data }))
    } catch (err: any) {
      setToast(err?.message || 'ط·آ·ط¢آ®ط·آ·ط¢آ·ط·آ·ط¢آ§ ط·آ·ط¢آ¯ط·آ·ط¢آ± ط·آ·ط¢آ¯ط·آ·ط¢آ±ط·ط›ط¥â€™ط·آ·ط¢آ§ط·آ¸ط¸آ¾ط·آ·ط¹آ¾ ط·آ·ط¹آ¾ط·آ¸أ¢â‚¬آ ط·آ·ط¢آ¸ط·ط›ط¥â€™ط·آ¸أ¢â‚¬آ¦ط·آ·ط¢آ§ط·آ·ط¹آ¾ ط·آ¸ط¢آ¾ط·ط›ط¥â€™ط·آ·ط¢آ§ط·آ¸أ¢â‚¬آ¦ط·آ¹ط¢آ©')
    }
  }

  useEffect(() => {
    load()
  }, [])

  const showToast = (txt: string) => {
    setToast(txt)
    setTimeout(() => setToast(''), 2500)
  }

  const save = async () => {
    setBusy(true)
    try {
      await apiPut('/api/settings/sms', {
        ...settings,
        api_key: apiKeyInput || undefined,
      })
      setApiKeyInput('')
      showToast('ط·آ·ط¹آ¾ط·آ¸أ¢â‚¬آ ط·آ·ط¢آ¸ط·ط›ط¥â€™ط·آ¸أ¢â‚¬آ¦ط·آ·ط¢آ§ط·آ·ط¹آ¾ ط·آ·ط¢آ°ط·آ·ط¢آ®ط·ط›ط¥â€™ط·آ·ط¢آ±ط·آ¸أ¢â‚¬طŒ ط·آ·ط¢آ´ط·آ·ط¢آ¯.')
      await load()
    } catch (err: any) {
      showToast(err?.message || 'ط·آ·ط¢آ«ط·آ·ط¢آ¨ط·آ·ط¹آ¾ ط·آ·ط¹آ¾ط·آ¸أ¢â‚¬آ ط·آ·ط¢آ¸ط·ط›ط¥â€™ط·آ¸أ¢â‚¬آ¦ط·آ·ط¢آ§ط·آ·ط¹آ¾ ط·آ¸أ¢â‚¬آ ط·آ·ط¢آ§ط·آ¸أ¢â‚¬آ¦ط·آ¸ط«â€ ط·آ¸ط¸آ¾ط·آ¸أ¢â‚¬ع‘ ط·آ·ط¢آ¨ط·آ¸ط«â€ ط·آ·ط¢آ¯')
    } finally {
      setBusy(false)
    }
  }

  const sendTest = async () => {
    if (!testNumber) {
      showToast('ط·آ·ط¢آ´ط·آ¸أ¢â‚¬آ¦ط·آ·ط¢آ§ط·آ·ط¢آ±ط·آ¸أ¢â‚¬طŒ ط·آ·ط¢آ±ط·آ·ط¢آ§ ط·آ¸ط«â€ ط·آ·ط¢آ§ط·آ·ط¢آ±ط·آ·ط¢آ¯ ط·آ¹ط¢آ©ط·آ¸أ¢â‚¬آ ط·ط›ط¥â€™ط·آ·ط¢آ¯.')
      return
    }
    setBusy(true)
    try {
      await apiPost('/api/settings/sms/test', { to: testNumber, message: 'ط·آ¸ط¢آ¾ط·ط›ط¥â€™ط·آ·ط¢آ§ط·آ¸أ¢â‚¬آ¦ط·آ¹ط¢آ© ط·آ·ط¢آ¢ط·آ·ط¢آ²ط·آ¸أ¢â‚¬آ¦ط·آ·ط¢آ§ط·ط›ط¥â€™ط·آ·ط¢آ´ط·ط›ط¥â€™ ط·آ·ط¢آ³ط·ط›ط¥â€™ط·آ·ط¢آ³ط·آ·ط¹آ¾ط·آ¸أ¢â‚¬آ¦' })
      showToast('ط·آ¸ط¢آ¾ط·ط›ط¥â€™ط·آ·ط¢آ§ط·آ¸أ¢â‚¬آ¦ط·آ¹ط¢آ© ط·آ·ط¹آ¾ط·آ·ط¢آ³ط·آ·ط¹آ¾ ط·آ·ط¢آ§ط·آ·ط¢آ±ط·آ·ط¢آ³ط·آ·ط¢آ§ط·آ¸أ¢â‚¬â€چ ط·آ·ط¢آ´ط·آ·ط¢آ¯.')
    } catch (err: any) {
      showToast(err?.message || 'ط·آ·ط¢آ§ط·آ·ط¢آ±ط·آ·ط¢آ³ط·آ·ط¢آ§ط·آ¸أ¢â‚¬â€چ ط·آ·ط¹آ¾ط·آ·ط¢آ³ط·آ·ط¹آ¾ ط·آ¸أ¢â‚¬آ ط·آ·ط¢آ§ط·آ¸أ¢â‚¬آ¦ط·آ¸ط«â€ ط·آ¸ط¸آ¾ط·آ¸أ¢â‚¬ع‘ ط·آ·ط¢آ¨ط·آ¸ط«â€ ط·آ·ط¢آ¯')
    } finally {
      setBusy(false)
    }
  }

  return (
    <section className={`${retroPanelPadded} space-y-4 bg-[#f7f2e7] border border-[#e0d4b8] shadow-[6px_6px_0_rgba(0,0,0,0.08)]`}>
      <div className="flex items-center justify-between flex-wrap gap-3">
        <div>
          <p className={retroHeading}>ط·آ·ط¹آ¾ط·آ¸أ¢â‚¬آ ط·آ·ط¢آ¸ط·ط›ط¥â€™ط·آ¸أ¢â‚¬آ¦ط·آ·ط¢آ§ط·آ·ط¹آ¾ ط·آ¸ط¢آ¾ط·ط›ط¥â€™ط·آ·ط¢آ§ط·آ¸أ¢â‚¬آ¦ط·آ¹ط¢آ© (IPPanel)</p>
          <p className="text-sm text-[#4b4339]">ط·آ·ط¢آ§ط·آ·ط¢آ±ط·آ·ط¢آ³ط·آ·ط¢آ§ط·آ¸أ¢â‚¬â€چ ط·آ¸ط¢آ¾ط·ط›ط¥â€™ط·آ·ط¢آ§ط·آ¸أ¢â‚¬آ¦ط·آ¹ط¢آ©ط·آ·ط¥â€™ ط·آ·ط¢آ®ط·آ·ط¢آ· ط·آ·ط¢آ§ط·آ·ط¢آ±ط·آ·ط¢آ³ط·آ·ط¢آ§ط·آ¸أ¢â‚¬â€چط·آ·ط¥â€™ ط·آ¸ط«â€  ط·آ·ط¹آ¾ط·آ¸ط«â€ ط·آ¹ط¢آ©ط·آ¸أ¢â‚¬آ  ط·آ·ط¢آ¯ط·آ·ط¢آ³ط·آ·ط¹آ¾ط·آ·ط¢آ±ط·آ·ط¢آ³ط·ط›ط¥â€™</p>
        </div>
        {toast && <span className={`${retroBadge} bg-[#fff4e0] border-[#f2c890] text-[#7c4a03]`}>{toast}</span>}
      </div>

      <div className="grid md:grid-cols-2 gap-3 bg-white border border-[#e0d4b8] p-3 rounded-lg">
        <label className="text-sm text-[#4b4339] space-y-1">
          ط·آ·ط¢آ®ط·آ·ط¢آ· ط·آ·ط¢آ§ط·آ·ط¢آ±ط·آ·ط¢آ³ط·آ·ط¢آ§ط·آ¸أ¢â‚¬â€چ
          <input className={retroInput} value={settings.default_sender || ''} onChange={e => setSettings({ ...settings, default_sender: e.target.value })} />
        </label>
        <label className="text-sm text-[#4b4339] space-y-1">
          ط·آ·ط¢آ¢ط·آ·ط¢آ³ط·آ·ط¹آ¾ط·آ·ط¢آ§ط·آ¸أ¢â‚¬آ ط·آ¸أ¢â‚¬طŒ ط·آ¸أ¢â‚¬طŒط·آ·ط¢آ´ط·آ·ط¢آ¯ط·آ·ط¢آ§ط·آ·ط¢آ± ط·آ·ط¢آ§ط·آ·ط¢آ¹ط·آ·ط¹آ¾ط·آ·ط¢آ¨ط·آ·ط¢آ§ط·آ·ط¢آ±
          <input
            type="number"
            className={retroInput}
            value={settings.low_credit_threshold ?? 0}
            onChange={e => setSettings({ ...settings, low_credit_threshold: Number(e.target.value) })}
          />
        </label>
        <label className="text-sm text-[#4b4339] space-y-1">
          ط·آ¸ط¢آ¾ط·آ·ط¢آ§ط·ط›ط¥â€™ط·آ¸أ¢â‚¬طŒ URL
          <input className={retroInput} value={settings.base_url || ''} onChange={e => setSettings({ ...settings, base_url: e.target.value })} />
        </label>
        <div className="flex items-center gap-3">
          <label className="flex items-center gap-2 text-sm">
            <input type="checkbox" checked={!!settings.enabled} onChange={e => setSettings({ ...settings, enabled: e.target.checked })} />
            ط·آ¸ط¸آ¾ط·آ·ط¢آ¹ط·آ·ط¢آ§ط·آ¸أ¢â‚¬â€چ
          </label>
          <span className={retroBadge}>{settings.api_key_masked ? `ط·آ·ط¹آ¾ط·آ¸ط«â€ ط·آ¹ط¢آ©ط·آ¸أ¢â‚¬آ : ${settings.api_key_masked}` : 'ط·آ·ط¹آ¾ط·آ¸ط«â€ ط·آ¹ط¢آ©ط·آ¸أ¢â‚¬آ  ط·آ·ط¢آ«ط·آ·ط¢آ¨ط·آ·ط¹آ¾ ط·آ¸أ¢â‚¬آ ط·آ·ط¢آ´ط·آ·ط¢آ¯ط·آ¸أ¢â‚¬طŒ'}</span>
        </div>
        <label className="text-sm text-[#4b4339] space-y-1 md:col-span-2">
          ط·آ·ط¹آ¾ط·آ¸ط«â€ ط·آ¹ط¢آ©ط·آ¸أ¢â‚¬آ  / API Key
          <input
            className={retroInput}
            type="password"
            placeholder="*******"
            value={apiKeyInput}
            onChange={e => setApiKeyInput(e.target.value)}
          />
        </label>
      </div>

      <div className="flex items-center gap-3">
        <button className={retroButton} onClick={save} disabled={busy}>
          ط·آ·ط¢آ°ط·آ·ط¢آ®ط·ط›ط¥â€™ط·آ·ط¢آ±ط·آ¸أ¢â‚¬طŒ
        </button>
        <div className="flex items-center gap-2">
          <input className={retroInput} placeholder="ط·آ·ط¢آ´ط·آ¸أ¢â‚¬آ¦ط·آ·ط¢آ§ط·آ·ط¢آ±ط·آ¸أ¢â‚¬طŒ ط·آ·ط¹آ¾ط·آ·ط¢آ³ط·آ·ط¹آ¾" value={testNumber} onChange={e => setTestNumber(e.target.value)} />
          <button className={retroButton} onClick={sendTest} disabled={busy}>
            ط·آ·ط¢آ§ط·آ·ط¢آ±ط·آ·ط¢آ³ط·آ·ط¢آ§ط·آ¸أ¢â‚¬â€چ ط·آ·ط¹آ¾ط·آ·ط¢آ³ط·آ·ط¹آ¾
          </button>
        </div>
      </div>
    </section>
  )
}
