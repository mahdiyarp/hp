import React, { useEffect, useState } from 'react'
import { apiGet, apiPost, apiPut } from '../../services/api'
import { retroBadge, retroButton, retroHeading, retroInput, retroPanelPadded } from '../retroTheme'

type AssistantSettings = {
  provider?: string
  base_url?: string | null
  api_key_masked?: string | null
  model_name?: string | null
  language?: string | null
  enable_doc_understanding?: boolean
  enable_journal_suggestions?: boolean
  enable_alerts?: boolean
  temperature?: number | null
  max_tokens?: number | null
  enabled?: boolean
}

export default function SmartAssistantSettingsPanel() {
  const [settings, setSettings] = useState<AssistantSettings>({
    provider: 'openai',
    base_url: '',
    model_name: 'gpt-4.1',
    language: 'fa',
    enable_doc_understanding: true,
    enable_journal_suggestions: true,
    enable_alerts: false,
    temperature: 0.3,
    max_tokens: 400,
    enabled: false,
  })
  const [apiKeyInput, setApiKeyInput] = useState('')
  const [toast, setToast] = useState<string>('')
  const [health, setHealth] = useState<{ status: string; message?: string } | null>(null)
  const [testQuestion, setTestQuestion] = useState('ط؛إ’ط¹آ© ط·آ®ط¸â€‍ط·آ§ط·آµط¸â€، ط¸â€¦ط·آ§ط¸â€‍ط؛إ’ ط·آ¨ط·آ±ط·آ§ط؛إ’ ط·آ§ط¸â€¦ط·آ±ط¸ث†ط·آ² ط·آ¨ط·آ¯ط¸â€،')
  const [testReply, setTestReply] = useState('')
  const [busy, setBusy] = useState(false)

  const loadSettings = async () => {
    try {
      const data = await apiGet<AssistantSettings>('/api/assistant/settings')
      if (data) setSettings(prev => ({ ...prev, ...data }))
    } catch (err: any) {
      setToast(err?.message || 'ط·آ®ط·آ·ط·آ§ ط·آ¯ط·آ± ط·آ¯ط·آ±ط؛إ’ط·آ§ط¸ظ¾ط·ع¾ ط·ع¾ط¸â€ ط·آ¸ط؛إ’ط¸â€¦ط·آ§ط·ع¾ ط·آ¯ط·آ³ط·ع¾ط؛إ’ط·آ§ط·آ±')
    }
  }

  useEffect(() => {
    loadSettings()
    loadHealth()
  }, [])

  const showToast = (txt: string) => {
    setToast(txt)
    setTimeout(() => setToast(''), 2500)
  }

  const loadHealth = async () => {
    try {
      const data = await apiGet<{ status: string; message?: string }>('/api/assistant/health')
      setHealth(data)
    } catch {
      setHealth({ status: 'error', message: 'ط·آ¹ط·آ¯ط¸â€¦ ط·آ§ط·ع¾ط·آµط·آ§ط¸â€‍ ط·آ¨ط¸â€، ط·آ³ط·آ±ط¸ث†ط؛إ’ط·آ³ ط¸â€،ط¸ث†ط·آ´ط¸â€¦ط¸â€ ط·آ¯' })
    }
  }

  const save = async () => {
    setBusy(true)
    try {
      await apiPut('/api/assistant/settings', { ...settings, api_key: apiKeyInput || undefined })
      setApiKeyInput('')
      showToast('ط·ع¾ط¸â€ ط·آ¸ط؛إ’ط¸â€¦ط·آ§ط·ع¾ ط·آ¯ط·آ³ط·ع¾ط؛إ’ط·آ§ط·آ± ط·آ°ط·آ®ط؛إ’ط·آ±ط¸â€، ط·آ´ط·آ¯.')
      await loadSettings()
      await loadHealth()
    } catch (err: any) {
      showToast(err?.message || 'ط·آ«ط·آ¨ط·ع¾ ط·ع¾ط¸â€ ط·آ¸ط؛إ’ط¸â€¦ط·آ§ط·ع¾ ط¸â€ ط·آ§ط¸â€¦ط¸ث†ط¸ظ¾ط¸â€ڑ ط·آ¨ط¸ث†ط·آ¯')
    } finally {
      setBusy(false)
    }
  }

  const sendTest = async () => {
    setBusy(true)
    try {
      const res = await apiPost<{ reply: string }>('/api/assistant/chat', { message: testQuestion, mode: 'general' })
      setTestReply(res?.reply || '')
    } catch (err: any) {
      setTestReply(err?.message || 'ط·آ®ط·آ·ط·آ§ ط·آ¯ط·آ± ط·آ¯ط·آ±ط؛إ’ط·آ§ط¸ظ¾ط·ع¾ ط¸آ¾ط·آ§ط·آ³ط·آ®')
    } finally {
      setBusy(false)
    }
  }

  return (
    <section className={`${retroPanelPadded} space-y-4 bg-[#f7f2e7] border border-[#e0d4b8] shadow-[6px_6px_0_rgba(0,0,0,0.08)]`}>
      <div className="flex items-center justify-between flex-wrap gap-3">
        <div>
          <p className={retroHeading}>ط·ع¾ط¸â€ ط·آ¸ط؛إ’ط¸â€¦ط·آ§ط·ع¾ ط·آ¯ط·آ³ط·ع¾ط؛إ’ط·آ§ط·آ± ط¸â€،ط¸ث†ط·آ´ط¸â€¦ط¸â€ ط·آ¯</p>
          <p className="text-sm text-[#4b4339]">ط¸آ¾ط؛إ’ط¹آ©ط·آ±ط·آ¨ط¸â€ ط·آ¯ط؛إ’ ط·آ§ط·آ±ط·آ§ط·آ¦ط¸â€،أ¢â‚¬إ’ط·آ¯ط¸â€،ط¸â€ ط·آ¯ط¸â€،ط·إ’ ط¸â€¦ط·آ¯ط¸â€‍ ط¸ث† ط¹آ©ط¸â€‍ط؛إ’ط·آ¯ API</p>
        </div>
        {toast && <span className={`${retroBadge} bg-[#fff4e0] border-[#f2c890] text-[#7c4a03]`}>{toast}</span>}
      </div>

      <div className="grid md:grid-cols-2 gap-3 bg-white border border-[#e0d4b8] p-3 rounded-lg">
        <label className="text-sm text-[#4b4339] space-y-1">
          ط·آ§ط·آ±ط·آ§ط·آ¦ط¸â€،أ¢â‚¬إ’ط·آ¯ط¸â€،ط¸â€ ط·آ¯ط¸â€،
          <select className={retroInput} value={settings.provider} onChange={e => setSettings({ ...settings, provider: e.target.value })}>
            <option value="openai">OpenAI / GPT</option>
            <option value="azure_openai">Azure OpenAI</option>
            <option value="local" disabled>
              Local
            </option>
          </select>
        </label>
        <label className="text-sm text-[#4b4339] space-y-1">
          ط¸â€¦ط·آ¯ط¸â€‍
          <input className={retroInput} value={settings.model_name || ''} onChange={e => setSettings({ ...settings, model_name: e.target.value })} />
        </label>
        <label className="text-sm text-[#4b4339] space-y-1">
          Base URL
          <input className={retroInput} value={settings.base_url || ''} onChange={e => setSettings({ ...settings, base_url: e.target.value })} />
        </label>
        <label className="text-sm text-[#4b4339] space-y-1">
          ط·آ¯ط¸â€¦ط·آ§ (temperature)
          <input
            type="number"
            className={retroInput}
            step="0.1"
            value={settings.temperature ?? 0}
            onChange={e => setSettings({ ...settings, temperature: Number(e.target.value) })}
          />
        </label>
        <label className="text-sm text-[#4b4339] space-y-1">
          ط·آ²ط·آ¨ط·آ§ط¸â€ 
          <select className={retroInput} value={settings.language || 'fa'} onChange={e => setSettings({ ...settings, language: e.target.value })}>
            <option value="fa">ط¸ظ¾ط·آ§ط·آ±ط·آ³ط؛إ’</option>
            <option value="en">English</option>
          </select>
        </label>
        <div className="flex flex-wrap items-center gap-3">
          <label className="flex items-center gap-2 text-sm">
            <input type="checkbox" checked={!!settings.enable_doc_understanding} onChange={e => setSettings({ ...settings, enable_doc_understanding: e.target.checked })} />
            ط·ع¾ط·آ­ط¸â€‍ط؛إ’ط¸â€‍ ط·آ³ط¸â€ ط·آ¯
          </label>
          <label className="flex items-center gap-2 text-sm">
            <input
              type="checkbox"
              checked={!!settings.enable_journal_suggestions}
              onChange={e => setSettings({ ...settings, enable_journal_suggestions: e.target.checked })}
            />
            ط¸آ¾ط؛إ’ط·آ´ط¸â€ ط¸â€،ط·آ§ط·آ¯ ط·آ«ط·آ¨ط·ع¾ ط·آ­ط·آ³ط·آ§ط·آ¨ط·آ¯ط·آ§ط·آ±ط؛إ’
          </label>
          <label className="flex items-center gap-2 text-sm">
            <input type="checkbox" checked={!!settings.enable_alerts} onChange={e => setSettings({ ...settings, enable_alerts: e.target.checked })} />
            ط¸â€،ط·آ´ط·آ¯ط·آ§ط·آ± ط¸â€،ط¸ث†ط·آ´ط¸â€¦ط¸â€ ط·آ¯
          </label>
          <label className="flex items-center gap-2 text-sm">
            <input type="checkbox" checked={!!settings.enabled} onChange={e => setSettings({ ...settings, enabled: e.target.checked })} />
            ط¸ظ¾ط·آ¹ط·آ§ط¸â€‍
          </label>
        </div>
        <label className="text-sm text-[#4b4339] space-y-1 md:col-span-2">
          ط·ع¾ط¸ث†ط¹آ©ط¸â€  / API Key
          <input
            className={retroInput}
            type="password"
            placeholder={settings.api_key_masked || '*******'}
            value={apiKeyInput}
            onChange={e => setApiKeyInput(e.target.value)}
          />
        </label>
      </div>

      <div className="flex items-center gap-3">
        <button className={retroButton} onClick={save} disabled={busy}>
          ط·آ°ط·آ®ط؛إ’ط·آ±ط¸â€،
        </button>
        {health && (
          <span
            className={`${retroBadge} ${
              health.status === 'ok' ? 'bg-[#e6f9ef] border-[#9ac8a5] text-[#0f5132]' : 'bg-[#ffe6e6] border-[#f2b1b1] text-[#8b1d1d]'
            }`}
          >
            ط¸ث†ط·آ¶ط·آ¹ط؛إ’ط·ع¾: {health.status} {health.message ? `- ${health.message}` : ''}
          </span>
        )}
      </div>

      <div className="bg-white border border-[#e0d4b8] p-3 rounded-lg space-y-3">
        <p className="text-sm text-[#4b4339]">ط·ع¾ط·آ³ط·ع¾ ط·آ³ط·آ±ط؛إ’ط·آ¹</p>
        <div className="flex flex-wrap gap-2 items-center">
          <input className={retroInput} value={testQuestion} onChange={e => setTestQuestion(e.target.value)} />
          <button className={retroButton} onClick={sendTest} disabled={busy}>
            ط·آ§ط·آ±ط·آ³ط·آ§ط¸â€‍ ط·آ¨ط¸â€، ط·آ¯ط·آ³ط·ع¾ط؛إ’ط·آ§ط·آ±
          </button>
        </div>
        {testReply && <div className={`${retroBadge} bg-[#f0ebe0] text-[#2f281f]`}>{testReply}</div>}
      </div>
    </section>
  )
}
