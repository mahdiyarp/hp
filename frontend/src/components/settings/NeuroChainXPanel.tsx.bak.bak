import React, { useMemo, useState } from 'react'
import type { FormEvent } from 'react'
import '../../styles/neurochainx.css'

type ConnectionMode = 'api' | 'agent' | 'ci'
type ActionMode = 'sync' | 'status' | 'done'

const connectionModes: { value: ConnectionMode; label: string; help: string }[] = [
  { value: 'api', label: 'API ط·آ±ط·آ³ط¸â€¦ط؛إ’', help: 'ط·آ§ط·آ³ط·ع¾ط¸ظ¾ط·آ§ط·آ¯ط¸â€، ط·آ§ط·آ² REST endpoint n8n ط؛إ’ط·آ§ HesabPak' },
  { value: 'agent', label: 'Local Agent', help: 'ط·آ§ط·ع¾ط·آµط·آ§ط¸â€‍ ط·آ¨ط¸â€، ط؛إ’ط¹آ© agent ط¸â€¦ط·آ­ط¸â€‍ط؛إ’ ط¹آ©ط¸â€، ط·آ¨ط¸â€، ط¸â€¦ط·آ¯ط¸â€‍أ¢â‚¬إ’ط¸â€،ط·آ§ط؛إ’ ط¸â€¦ط·ع¾ط¸â€ أ¢â‚¬إ’ط·آ¨ط·آ§ط·آ² ط¸ث†ط·آµط¸â€‍ ط·آ´ط·آ¯ط¸â€،' },
  { value: 'ci', label: 'CI Mode', help: 'ط·آ§ط·آ¬ط·آ±ط·آ§ط؛إ’ ط¸â€،ط¸â€¦ط¹آ¯ط·آ§ط¸â€¦أ¢â‚¬إ’ط·آ³ط·آ§ط·آ²ط؛إ’ ط·آ§ط·آ² ط·آ·ط·آ±ط؛إ’ط¸â€ڑ ط¸آ¾ط¸â€‍ط·ع¾ط¸ظ¾ط·آ±ط¸â€¦ CI / pipeline' },
]

const actionDefinitions: Record<
  ActionMode,
  { label: string; button: string; method: 'GET' | 'POST'; path: string; requires?: string }
> = {
  sync: { label: 'ط¸â€،ط¸â€¦ط¹آ¯ط·آ§ط¸â€¦أ¢â‚¬إ’ط·آ³ط·آ§ط·آ²ط؛إ’ roadmap', button: 'ط·آ§ط·آ¬ط·آ±ط·آ§ط؛إ’ Sync', method: 'POST', path: '/roadmap/sync' },
  status: { label: 'ط·آ¯ط·آ±ط؛إ’ط·آ§ط¸ظ¾ط·ع¾ ط¸ث†ط·آ¶ط·آ¹ط؛إ’ط·ع¾ roadmap', button: 'ط¸â€ ط¸â€¦ط·آ§ط؛إ’ط·آ´ Status', method: 'GET', path: '/roadmap/status' },
  done: {
    label: 'ط·آ«ط·آ¨ط·ع¾ ط¸â€¦ط·آ§ط؛إ’ط¸â€‍ط·آ³ط·ع¾ط¸ث†ط¸â€  ط·آ§ط¸â€ ط·آ¬ط·آ§ط¸â€¦أ¢â‚¬إ’ط·آ´ط·آ¯ط¸â€،',
    button: 'ط·آ«ط·آ¨ط·ع¾ DONE',
    method: 'POST',
    path: '/roadmap/status',
    requires: 'ط·آ´ط¸â€ ط·آ§ط·آ³ط¸â€، ط¸â€¦ط·آ§ط؛إ’ط¸â€‍ط·آ³ط·ع¾ط¸ث†ط¸â€  (ط¸â€¦ط·آ«ط¸â€‍ط·آ§ط¸â€¹ 51734)',
  },
}

const tidyUrl = (value: string) => value.trim().replace(/\s+$/, '').replace(/\/+$/, '')

const appendLog = (setter: React.Dispatch<React.SetStateAction<string[]>>, message: string) => {
  setter(prev => [message, ...prev].slice(0, 6))
}

const buildUrl = (base: string, path: string) => {
  const cleaned = tidyUrl(base)
  if (!cleaned) return ''
  if (path.startsWith('http')) return path
  return `${cleaned}${path.startsWith('/') ? '' : '/'}${path}`
}

export default function NeuroChainXPanel() {
  const [server, setServer] = useState('http://localhost:5678')
  const [connectionMode, setConnectionMode] = useState<ConnectionMode>('api')
  const [testState, setTestState] = useState<{ status: 'idle' | 'loading' | 'success' | 'error'; message: string }>({
    status: 'idle',
    message: 'ط·آ¢ط¸â€¦ط·آ§ط·آ¯ط¸â€، ط·ع¾ط·آ³ط·ع¾ ط·آ§ط·ع¾ط·آµط·آ§ط¸â€‍',
  })
  const [actionMode, setActionMode] = useState<ActionMode>('sync')
  const [milestoneId, setMilestoneId] = useState('')
  const [operationState, setOperationState] = useState<{ status: 'idle' | 'running' | 'done' | 'error'; message: string }>({
    status: 'idle',
    message: 'ط¸â€،ط¸â€ ط¸ث†ط·آ² ط·آ¹ط¸â€¦ط¸â€‍ط؛إ’ط·آ§ط·ع¾ط؛إ’ ط·آ§ط·آ¬ط·آ±ط·آ§ ط¸â€ ط·آ´ط·آ¯ط¸â€،.',
  })
  const [operationLogs, setOperationLogs] = useState<string[]>([])
  const [actionLoading, setActionLoading] = useState(false)

  const baseTarget = useMemo(() => tidyUrl(server), [server])

  const testConnection = async () => {
    if (!baseTarget) {
      setTestState({ status: 'error', message: 'ط·آ¢ط·آ¯ط·آ±ط·آ³ ط·آ³ط·آ±ط¸ث†ط·آ± ط¸â€¦ط·آ¹ط·ع¾ط·آ¨ط·آ± ط¸â€ ط؛إ’ط·آ³ط·ع¾.' })
      return
    }
    setTestState({ status: 'loading', message: 'ط·آ¯ط·آ± ط·آ­ط·آ§ط¸â€‍ ط·ع¾ط·آ³ط·ع¾ ط·آ§ط·ع¾ط·آµط·آ§ط¸â€‍...' })
    try {
      const res = await fetch(buildUrl(baseTarget, '/roadmap/status'), { method: 'GET' })
      if (!res.ok) throw new Error(`ط¸ث†ط·آ¶ط·آ¹ط؛إ’ط·ع¾ HTTP ${res.status}`)
      const payload = await res.text()
      setTestState({ status: 'success', message: 'ط·آ§ط·ع¾ط·آµط·آ§ط¸â€‍ ط·آ¨ط·آ±ط¸â€ڑط·آ±ط·آ§ط·آ± ط·آ´ط·آ¯.' })
      appendLog(setOperationLogs, `[Connection Test] ط¸â€¦ط¸ث†ط¸ظ¾ط¸â€ڑ: ${payload.slice(0, 64)}`)
    } catch (err: any) {
      setTestState({ status: 'error', message: err?.message || 'ط·آ¹ط·آ¯ط¸â€¦ ط·آ§ط·ع¾ط·آµط·آ§ط¸â€‍ ط·آ¨ط¸â€، ط·آ³ط·آ±ط¸ث†ط·آ±' })
      appendLog(setOperationLogs, `[Connection Test] ط·آ®ط·آ·ط·آ§: ${err?.message ?? 'ط¸â€ ط·آ§ط¸â€¦ط·آ´ط·آ®ط·آµ'}`)
    }
  }

  const handleAction = async (event: FormEvent) => {
    event.preventDefault()
    const definition = actionDefinitions[actionMode]
    if (actionMode === 'done' && !milestoneId.trim()) {
      setOperationState({ status: 'error', message: 'ط·آ´ط¸â€ ط·آ§ط·آ³ط¸â€، ط¸â€¦ط·آ§ط؛إ’ط¸â€‍ط·آ³ط·ع¾ط¸ث†ط¸â€  ط·آ±ط·آ§ ط¸ث†ط·آ§ط·آ±ط·آ¯ ط¹آ©ط¸â€ ط؛إ’ط·آ¯.' })
      return
    }
    if (!baseTarget) {
      setOperationState({ status: 'error', message: 'ط·آ¢ط·آ¯ط·آ±ط·آ³ ط·آ³ط·آ±ط¸ث†ط·آ± ط¸â€ ط·آ§ط¸â€¦ط·آ¹ط·ع¾ط·آ¨ط·آ± ط·آ§ط·آ³ط·ع¾.' })
      return
    }
    const payload =
      actionMode === 'done'
        ? JSON.stringify({ status: `DONE:${milestoneId.trim()}` })
        : JSON.stringify({ action: actionMode })
    setActionLoading(true)
    setOperationState({ status: 'running', message: `${definition.label} ط·آ¯ط·آ± ط·آ­ط·آ§ط¸â€‍ ط·آ§ط·آ¬ط·آ±ط·آ§...` })
    try {
      const response = await fetch(buildUrl(baseTarget, definition.path), {
        method: definition.method,
        headers: {
          'Content-Type': 'application/json',
        },
        body: definition.method === 'POST' ? payload : undefined,
      })
      if (!response.ok) throw new Error(`ط·آ®ط·آ·ط·آ§ط؛إ’ HTTP ${response.status}`)
      const data = await response.text()
      setOperationState({ status: 'done', message: `${definition.label} ط·آ¨ط·آ§ ط¸â€¦ط¸ث†ط¸ظ¾ط¸â€ڑط؛إ’ط·ع¾ ط·آ§ط¸â€ ط·آ¬ط·آ§ط¸â€¦ ط·آ´ط·آ¯.` })
      appendLog(setOperationLogs, `[${definition.label}] ${response.status} - ${data.slice(0, 80)}`)
    } catch (err: any) {
      setOperationState({ status: 'error', message: err?.message ?? 'ط·آ®ط·آ·ط·آ§ط؛إ’ ط·آ´ط·آ¨ط¹آ©ط¸â€،' })
      appendLog(setOperationLogs, `[${definition.label}] ط·آ®ط·آ·ط·آ§: ${err?.message ?? 'ط¸â€ ط·آ§ط¸â€¦ط·آ´ط·آ®ط·آµ'}`)
    } finally {
      setActionLoading(false)
    }
  }

  const quickSync = () => handleAction({ preventDefault: () => {}, stopPropagation: () => {} } as FormEvent)

  const openLivePage = () => {
    const liveUrl = buildUrl(baseTarget, '/roadmap/live')
    if (liveUrl) window.open(liveUrl, '_blank')
  }

  return (
    <div className="neuro-panel" dir="rtl">
      <div className="flex flex-col gap-1">
        <h3>NeuroChainX Roadmap Agent</h3>
        <p>ط¸â€¦ط·آ§ط¹ع©ط¸ث†ط¸â€‍ط؛إ’ ط·آ¨ط·آ±ط·آ§ط؛إ’ ط¸â€¦ط·آ¯ط؛إ’ط·آ±ط؛إ’ط·ع¾ ط·آ³ط·آ±ط؛إ’ط·آ¹ roadmap ط¸ث† ط·آ¹ط¸â€¦ط¸â€‍ط؛إ’ط·آ§ط·ع¾ ط¸ث†ط·آ§ط·آ¨ط·آ³ط·ع¾ط¸â€، ط·آ¯ط·آ± n8n</p>
      </div>

      <section className="neuro-section mt-4">
        <div className="flex items-center justify-between gap-4">
          <div>
            <p className="text-sm">ط·آ§ط·ع¾ط·آµط·آ§ط¸â€‍ ط·آ¨ط¸â€، ط·آ³ط·آ±ط¸ث†ط؛إ’ط·آ³</p>
            <p className="text-xs text-[var(--neuro-muted)]">ط·آ¢ط·آ¯ط·آ±ط·آ³ n8n ط؛إ’ط·آ§ agent ط¸â€¦ط·آ­ط¸â€‍ط؛إ’ ط·آ±ط·آ§ ط¸ث†ط·آ§ط·آ±ط·آ¯ ط¹آ©ط¸â€  ط·ع¾ط·آ§ ط·آ§ط؛إ’ط¸â€  ط¸آ¾ط¸â€ ط¸â€‍ ط·آ¨ط¸â€، ط·آ¢ط¸â€  ط¸ث†ط·آµط¸â€‍ ط·آ´ط¸ث†ط·آ¯.</p>
          </div>
          <div className="neuro-chip">
            {connectionMode === 'ci' ? 'CI Mode' : connectionMode === 'agent' ? 'Local Agent' : 'API ط·آ±ط·آ³ط¸â€¦ط؛إ’'}
          </div>
        </div>
        <div className="neuro-grid mt-3">
          <label className="space-y-1">
            <span>ط·آ¢ط·آ¯ط·آ±ط·آ³ ط·آ³ط·آ±ط¸ث†ط·آ±</span>
            <input
              className="neuro-input"
              value={server}
              onChange={e => setServer(e.target.value)}
              placeholder="ط¸â€¦ط·آ«ط¸â€‍ط·آ§ط¸â€¹ http://localhost:5678"
            />
          </label>
          <div>
            <span>ط¸â€ ط¸ث†ط·آ¹ ط·آ§ط·ع¾ط·آµط·آ§ط¸â€‍</span>
            <div className="neuro-radio-group mt-2">
              {connectionModes.map(mode => (
                <label
                  key={mode.value}
                  className={`neuro-radio ${connectionMode === mode.value ? 'active' : ''}`}
                  onClick={() => setConnectionMode(mode.value)}
                >
                  <input type="radio" name="connection-mode" checked={connectionMode === mode.value} readOnly />
                  <div>
                    <strong>{mode.label}</strong>
                    <div className="text-[0.8rem] text-[var(--neuro-muted)]">{mode.help}</div>
                  </div>
                </label>
              ))}
            </div>
          </div>
          <div>
            <span>ط·ع¾ط·آ³ط·ع¾ ط·آ§ط·ع¾ط·آµط·آ§ط¸â€‍</span>
            <div className={`neuro-status ${testState.status}`}>
              {testState.status === 'loading' ? 'ط·آ¯ط·آ± ط·آ­ط·آ§ط¸â€‍ ط·ع¾ط·آ³ط·ع¾ ط·آ§ط·ع¾ط·آµط·آ§ط¸â€‍...' : testState.message}
            </div>
            <button className="neuro-button mt-3 w-full" type="button" onClick={testConnection}>
              ط·ع¾ط·آ³ط·ع¾ ط·آ§ط·ع¾ط·آµط·آ§ط¸â€‍
            </button>
          </div>
        </div>
      </section>

      <section className="neuro-section mt-6">
        <div className="flex items-center justify-between">
          <div>
            <p className="text-sm">ط·آ¹ط¸â€¦ط¸â€‍ط؛إ’ط·آ§ط·ع¾ NeuroChainX</p>
            <p className="text-xs text-[var(--neuro-muted)]">ط·آ§ط·آ² ط¸â€،ط¸â€¦ط؛إ’ط¸â€  ط¸آ¾ط¸â€ ط¸â€‍ ط¸â€¦ط؛إ’أ¢â‚¬إ’ط·ع¾ط¸ث†ط·آ§ط¸â€ ط؛إ’ syncط·إ’ ط¸ث†ط·آ¶ط·آ¹ط؛إ’ط·ع¾ ط¸ث† ط·آ«ط·آ¨ط·ع¾ DONE ط·آ±ط·آ§ ط·آ¨ط·آ¯ط¸ث†ط¸â€  ط¸ث†ط·آ±ط¸ث†ط·آ¯ ط·آ¨ط¸â€، workflow ط·آ§ط¸â€ ط·آ¬ط·آ§ط¸â€¦ ط·آ¯ط¸â€،ط؛إ’.</p>
          </div>
          <span className="neuro-glow-tag">NeuroChainX</span>
        </div>
        <div className="neuro-radio-group mt-3">
          {Object.entries(actionDefinitions).map(([key, def]) => (
            <label key={key} className={`neuro-radio ${actionMode === key ? 'active' : ''}`}>
              <input type="radio" name="action-mode" checked={actionMode === key} readOnly onClick={() => setActionMode(key as ActionMode)} />
              <div>
                <strong>{def.label}</strong>
                <div className="text-xs text-[var(--neuro-muted)]">{def.button}</div>
              </div>
            </label>
          ))}
        </div>
        {actionMode === 'done' && (
          <div className="mt-4 space-y-2">
            <label className="text-xs">ط·آ´ط¸â€ ط·آ§ط·آ³ط¸â€، ط¸â€¦ط·آ§ط؛إ’ط¸â€‍ط·آ³ط·ع¾ط¸ث†ط¸â€  (ط¸â€¦ط·آ«ط¸â€‍ط·آ§ط¸â€¹ 51734)</label>
            <input className="neuro-input" value={milestoneId} onChange={e => setMilestoneId(e.target.value)} placeholder="ط·آ´ط¸â€¦ط·آ§ط·آ±ط¸â€، ط¸â€¦ط·آ§ط؛إ’ط¸â€‍ط·آ³ط·ع¾ط¸ث†ط¸â€ " />
          </div>
        )}
        <form onSubmit={handleAction} className="mt-4 flex flex-wrap gap-3">
          <button className="neuro-button" type="submit" disabled={actionLoading}>
            {actionDefinitions[actionMode].button}
          </button>
          <button className="neuro-live-button" type="button" onClick={openLivePage}>
            ط·آ¨ط·آ§ط·آ² ط¹آ©ط·آ±ط·آ¯ط¸â€  ط·آµط¸ظ¾ط·آ­ط¸â€، ط·آ²ط¸â€ ط·آ¯ط¸â€،
          </button>
          <button className="neuro-live-button" type="button" onClick={quickSync}>
            ط·آ§ط·آ¬ط·آ±ط·آ§ط؛إ’ ط·آ³ط·آ±ط؛إ’ط·آ¹ (Quick Sync)
          </button>
        </form>
        <div className="neuro-status mt-3" style={{ borderRadius: 12 }}>
          {operationState.message}
        </div>
        <div className="neuro-log">
          <p className="text-xs text-[var(--neuro-muted)] mb-2">ط¹آ¯ط·آ²ط·آ§ط·آ±ط·آ´ ط·آ¢ط·آ®ط·آ±ط؛إ’ط¸â€  ط·آ¹ط¸â€¦ط¸â€‍ط؛إ’ط·آ§ط·ع¾</p>
          <ul>
            {operationLogs.length === 0 && (
              <li className="text-[var(--neuro-muted)]">ط¸â€،ط؛إ’ط¹â€  ط¹آ©ط·آ§ط·آ±ط؛إ’ ط·آ«ط·آ¨ط·ع¾ ط¸â€ ط·آ´ط·آ¯ط¸â€، ط·آ§ط·آ³ط·ع¾.</li>
            )}
            {operationLogs.map(log => (
              <li key={log}>{log}</li>
            ))}
          </ul>
        </div>
      </section>

      <section className="neuro-section mt-6">
        <div className="flex items-center justify-between">
          <div>
            <p className="text-sm">ط·ع¾ط·آµط¸ث†ط؛إ’ط·آ± ط¸ث†ط·آ¶ط·آ¹ط؛إ’ط·ع¾</p>
            <p className="text-xs text-[var(--neuro-muted)]">
              ط¸ث†ط·آ¶ط·آ¹ط؛إ’ط·ع¾ ط·آ³ط·آ±ط؛إ’ط·آ¹ Sync ط¸ث† ط·آµط¸ظ¾ط·آ­ط¸â€، Live workflow ط·آ±ط·آ§ ط¸â€¦ط·آ´ط·آ§ط¸â€،ط·آ¯ط¸â€، ط¹آ©ط¸â€  ط¸ث† ط·آ³ط·آ±ط؛إ’ط·آ¹ ط·آ¨ط¸â€، ط·آ¢ط¸â€ أ¢â‚¬إ’ط¸â€،ط·آ§ ط·آ¯ط·آ³ط·ع¾ط·آ±ط·آ³ط؛إ’ ط·آ¯ط·آ§ط·آ´ط·ع¾ط¸â€، ط·آ¨ط·آ§ط·آ´.
            </p>
          </div>
          <div className="text-xs text-[var(--neuro-muted)]">IRANYekan + ط·آ±ط·آ§ط·آ³ط·ع¾أ¢â‚¬إ’ط¹â€ ط؛إ’ط¸â€ </div>
        </div>
        <div className="mt-4 space-y-2">
          <p className="text-sm">ط·آ´ط·آ§ط·آ®ط·آµأ¢â‚¬إ’ط¸â€،ط·آ§ط؛إ’ ط·آ³ط·آ±ط؛إ’ط·آ¹</p>
          <div className="grid grid-cols-2 gap-3">
            <div className="neuro-status success">Sync ط·آ¢ط¸â€¦ط·آ§ط·آ¯ط¸â€،</div>
            <div className="neuro-status loading">Live page {baseTarget ? 'ط¸â€¦ط·ع¾ط·آµط¸â€‍' : 'ط¸â€ ط·آ§ط¸â€¦ط·آ´ط·آ®ط·آµ'}</div>
          </div>
        </div>
      </section>
    </div>
  )
}
