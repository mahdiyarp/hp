import React, { useState } from 'react'
import { useAuth } from '../context/AuthContext'
import RegisterForm from './RegisterForm'
import {
  retroButton,
  retroHeading,
  retroInput,
  retroLabel,
  retroPanelPadded,
  retroMuted,
} from './retroTheme'

export default function LoginForm() {
  const { login, loginPhone } = useAuth()
  const [showRegister, setShowRegister] = useState(false)
  const [mode, setMode] = useState<'password' | 'phone'>('password')
  const [username, setUsername] = useState('')
  const [password, setPassword] = useState('')
  const [otp, setOtp] = useState('')
  const [otpRequired, setOtpRequired] = useState(false)
  const [phone, setPhone] = useState('')
  const [phoneSession, setPhoneSession] = useState<string | null>(null)
  const [error, setError] = useState<string | null>(null)

  async function onSubmit(e: React.FormEvent) {
    e.preventDefault()
    try {
      setError(null)
      if (mode === 'password') {
        const result = await login(username, password, otpRequired ? otp : undefined)
        if (result.otpRequired) {
          setOtpRequired(true)
          setError('ط¹آ©ط·آ¯ ط·ع¾ط·آ§ط؛إ’ط؛إ’ط·آ¯ ط·آ¯ط¸ث† ط¸â€¦ط·آ±ط·آ­ط¸â€‍ط¸â€،أ¢â‚¬إ’ط·آ§ط؛إ’ ط·آ±ط·آ§ ط¸ث†ط·آ§ط·آ±ط·آ¯ ط¹آ©ط¸â€ ط؛إ’ط·آ¯')
          return
        }
        setOtp('')
        setOtpRequired(false)
      } else {
        if (!otpRequired) {
          await loginPhone(phone)
          setOtpRequired(true)
          setPhoneSession('pending')
          setError('ط¹آ©ط·آ¯ ط·ع¾ط·آ§ط؛إ’ط؛إ’ط·آ¯ ط·آ§ط·آ±ط·آ³ط·آ§ط¸â€‍ ط·آ´ط·آ¯')
          return
        } else {
          await loginPhone(phone, otp, phoneSession || undefined)
          setOtp('')
          setOtpRequired(false)
          setPhoneSession(null)
        }
      }
    } catch (err) {
      if (err instanceof Error) {
        setError(err.message)
      } else {
        setError('ط¸ث†ط·آ±ط¸ث†ط·آ¯ ط¸â€ ط·آ§ط¸â€¦ط¸ث†ط¸ظ¾ط¸â€ڑ')
      }
    }
  }

  return (
    <div className="w-full max-w-md">
      {showRegister ? (
        <>
          <RegisterForm onSuccess={() => setShowRegister(false)} />
          <div className="mt-4 text-center">
            <button
              className="text-sm text-[#154b5f] hover:underline"
              onClick={() => setShowRegister(false)}
              type="button"
            >
              ط¸آ¾ط؛ظ¾ط¸â€‍ط؛â€™ ط·آ³ط؛â€™ ط·آµط·آ§ط·آ±ط¸ظ¾ ط؛ظ¾ط؛إ’ط¹ط›ط·ع؛ ط؛إ’ط؛ظ¾ط·آ§ط¹ط› ط¸ث†ط·آ±ط¸ث†ط·آ¯ ط¹آ©ط·آ±ط؛إ’ط¹ط›
            </button>
          </div>
        </>
      ) : (
        <>
          <form onSubmit={onSubmit} className={`${retroPanelPadded} space-y-5`}>
            <header className="space-y-2 text-right">
              <p className={retroHeading}>hesabpak access terminal</p>
              <h2 className="text-2xl font-semibold text-[#1f2e3b]">ط¸ث†ط·آ±ط¸ث†ط·آ¯ ط·آ¨ط¸â€، ط·آ³ط·آ§ط¸â€¦ط·آ§ط¸â€ ط¸â€،</h2>
              <p className={`text-xs ${retroMuted}`}>
                ط¸ث†ط·آ±ط¸ث†ط·آ¯ ط·آ¨ط·آ§ ط¸â€ ط·آ§ط¸â€¦ ط¹آ©ط·آ§ط·آ±ط·آ¨ط·آ±ط؛إ’/ط·آ±ط¸â€¦ط·آ² ط؛إ’ط·آ§ ط¸â€¦ط¸ث†ط·آ¨ط·آ§ط؛إ’ط¸â€‍ (OTP). ط·آ¯ط·آ± ط·آµط¸ث†ط·آ±ط·ع¾ ط¸ظ¾ط·آ¹ط·آ§ط¸â€‍ ط·آ¨ط¸ث†ط·آ¯ط¸â€  ط¸ث†ط·آ±ط¸ث†ط·آ¯ ط·آ¯ط¸ث† ط¸â€¦ط·آ±ط·آ­ط¸â€‍ط¸â€،أ¢â‚¬إ’ط·آ§ط؛إ’ط·إ’ ط¹آ©ط·آ¯ ط·ع¾ط·آ§ط؛إ’ط؛إ’ط·آ¯ ط¸â€‍ط·آ§ط·آ²ط¸â€¦ ط·آ§ط·آ³ط·ع¾.
              </p>
            </header>

            <div className="flex gap-2 text-sm">
              <button type="button" className={`${retroButton} ${mode === 'password' ? '' : '!opacity-60'}`} onClick={() => { setMode('password'); setOtpRequired(false); setError(null); }}>
                ط¸ث†ط·آ±ط¸ث†ط·آ¯ ط·آ¨ط·آ§ ط·آ±ط¸â€¦ط·آ²
              </button>
              <button type="button" className={`${retroButton} ${mode === 'phone' ? '' : '!opacity-60'}`} onClick={() => { setMode('phone'); setOtpRequired(false); setError(null); }}>
                ط¸ث†ط·آ±ط¸ث†ط·آ¯ ط·آ¨ط·آ§ ط¸â€¦ط¸ث†ط·آ¨ط·آ§ط؛إ’ط¸â€‍
              </button>
            </div>

            <div className="space-y-4">
              {mode === 'password' ? (
                <>
                  <div>
                    <label className={retroLabel}>ط¸â€ ط·آ§ط¸â€¦ ط¹آ©ط·آ§ط·آ±ط·آ¨ط·آ±ط؛إ’</label>
                    <input
                      value={username}
                      onChange={e => setUsername(e.target.value)}
                      className={`${retroInput} w-full`}
                      placeholder="username"
                    />
                  </div>
                  <div>
                    <label className={retroLabel}>ط·آ±ط¸â€¦ط·آ² ط·آ¹ط·آ¨ط¸ث†ط·آ±</label>
                    <input
                      type="password"
                      value={password}
                      onChange={e => setPassword(e.target.value)}
                      className={`${retroInput} w-full`}
                      placeholder="أ¢â‚¬آ¢أ¢â‚¬آ¢أ¢â‚¬آ¢أ¢â‚¬آ¢أ¢â‚¬آ¢أ¢â‚¬آ¢أ¢â‚¬آ¢أ¢â‚¬آ¢"
                    />
                  </div>
                  {otpRequired && (
                    <div>
                      <label className={retroLabel}>ط¹آ©ط·آ¯ ط·ع¾ط·آ§ط؛إ’ط؛إ’ط·آ¯ ط·آ¯ط¸ث† ط¸â€¦ط·آ±ط·آ­ط¸â€‍ط¸â€،أ¢â‚¬إ’ط·آ§ط؛إ’</label>
                      <input
                        value={otp}
                        onChange={e => setOtp(e.target.value)}
                        className={`${retroInput} w-full tracking-[0.6em] text-center`}
                        placeholder="123456"
                        inputMode="numeric"
                        pattern="\\d{6}"
                        autoComplete="one-time-code"
                      />
                    </div>
                  )}
                </>
              ) : (
                <>
                  <div>
                    <label className={retroLabel}>ط·آ´ط¸â€¦ط·آ§ط·آ±ط¸â€، ط¸â€¦ط¸ث†ط·آ¨ط·آ§ط؛إ’ط¸â€‍</label>
                    <input
                      value={phone}
                      onChange={e => setPhone(e.target.value)}
                      className={`${retroInput} w-full`}
                      placeholder="09xxxxxxxxx"
                    />
                  </div>
                  {otpRequired && (
                    <div>
                      <label className={retroLabel}>ط¹آ©ط·آ¯ ط·ع¾ط·آ§ط؛إ’ط؛إ’ط·آ¯</label>
                      <input
                        value={otp}
                        onChange={e => setOtp(e.target.value)}
                        className={`${retroInput} w-full tracking-[0.6em] text-center`}
                        placeholder="123456"
                        inputMode="numeric"
                        pattern="\\d{6}"
                      />
                    </div>
                  )}
                  <p className={`text-[11px] ${retroMuted}`}>ط¹آ©ط·آ¯ ط¸ث†ط·آ±ط¸ث†ط·آ¯ ط·آ§ط·آ² ط·آ·ط·آ±ط؛إ’ط¸â€ڑ SMS ط·آ§ط·آ±ط·آ³ط·آ§ط¸â€‍ ط¸â€¦ط؛إ’أ¢â‚¬إ’ط·آ´ط¸ث†ط·آ¯.</p>
                </>
              )}
            </div>

            {error && (
              <div className="border-2 border-[#c35c5c] bg-[#f9e6e6] text-[#5b1f1f] px-3 py-2 shadow-[3px_3px_0_#c35c5c] text-sm">
                {error}
              </div>
            )}

            <div className="space-y-3">
              <button className={`${retroButton} w-full`} type="submit">
                ط¸ث†ط·آ±ط¸ث†ط·آ¯ ط·آ¨ط¸â€، ط·آ³ط؛إ’ط·آ³ط·ع¾ط¸â€¦
              </button>
            </div>
          </form>

          <div className="mt-4 text-center space-y-2">
            <p className={`text-[11px] ${retroMuted}`}>ط·آ­ط·آ³ط·آ§ط·آ¨ ط¸â€ ط·آ¯ط·آ§ط·آ±ط؛إ’ط·آ¯ط·ع؛</p>
            <button
              className={`${retroButton} !bg-[#2d5b2d] w-full`}
              onClick={() => setShowRegister(true)}
              type="button"
            >
              ط·آ§ط؛إ’ط·آ¬ط·آ§ط·آ¯ ط·آ­ط·آ³ط·آ§ط·آ¨ ط·آ¬ط·آ¯ط؛إ’ط·آ¯ (ط¸â€¦ط¸ث†ط·آ¨ط·آ§ط؛إ’ط¸â€‍)
            </button>
          </div>
        </>
      )}
    </div>
  )
}
