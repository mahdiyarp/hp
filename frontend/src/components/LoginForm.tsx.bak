import React, { useState } from 'react'
import { useAuth } from '../context/AuthContext'
import RegisterForm from './RegisterForm'
import {
  retroButton,
  retroHeading,
  retroInput,
  retroLabel,
  retroPanelPadded,
  retroMuted,
} from './retroTheme'

export default function LoginForm() {
  const { login, loginPhone } = useAuth()
  const [showRegister, setShowRegister] = useState(false)
  const [mode, setMode] = useState<'password' | 'phone'>('password')
  const [username, setUsername] = useState('')
  const [password, setPassword] = useState('')
  const [otp, setOtp] = useState('')
  const [otpRequired, setOtpRequired] = useState(false)
  const [phone, setPhone] = useState('')
  const [phoneSession, setPhoneSession] = useState<string | null>(null)
  const [error, setError] = useState<string | null>(null)

  async function onSubmit(e: React.FormEvent) {
    e.preventDefault()
    try {
      setError(null)
      if (mode === 'password') {
        const result = await login(username, password, otpRequired ? otp : undefined)
        if (result.otpRequired) {
          setOtpRequired(true)
          setError('ط·آ¹ط¢آ©ط·آ·ط¢آ¯ ط·آ·ط¹آ¾ط·آ·ط¢آ§ط·ط›ط¥â€™ط·ط›ط¥â€™ط·آ·ط¢آ¯ ط·آ·ط¢آ¯ط·آ¸ط«â€  ط·آ¸أ¢â‚¬آ¦ط·آ·ط¢آ±ط·آ·ط¢آ­ط·آ¸أ¢â‚¬â€چط·آ¸أ¢â‚¬طŒط£آ¢أ¢â€ڑآ¬ط¥â€™ط·آ·ط¢آ§ط·ط›ط¥â€™ ط·آ·ط¢آ±ط·آ·ط¢آ§ ط·آ¸ط«â€ ط·آ·ط¢آ§ط·آ·ط¢آ±ط·آ·ط¢آ¯ ط·آ¹ط¢آ©ط·آ¸أ¢â‚¬آ ط·ط›ط¥â€™ط·آ·ط¢آ¯')
          return
        }
        setOtp('')
        setOtpRequired(false)
      } else {
        if (!otpRequired) {
          await loginPhone(phone)
          setOtpRequired(true)
          setPhoneSession('pending')
          setError('ط·آ¹ط¢آ©ط·آ·ط¢آ¯ ط·آ·ط¹آ¾ط·آ·ط¢آ§ط·ط›ط¥â€™ط·ط›ط¥â€™ط·آ·ط¢آ¯ ط·آ·ط¢آ§ط·آ·ط¢آ±ط·آ·ط¢آ³ط·آ·ط¢آ§ط·آ¸أ¢â‚¬â€چ ط·آ·ط¢آ´ط·آ·ط¢آ¯')
          return
        } else {
          await loginPhone(phone, otp, phoneSession || undefined)
          setOtp('')
          setOtpRequired(false)
          setPhoneSession(null)
        }
      }
    } catch (err) {
      if (err instanceof Error) {
        setError(err.message)
      } else {
        setError('ط·آ¸ط«â€ ط·آ·ط¢آ±ط·آ¸ط«â€ ط·آ·ط¢آ¯ ط·آ¸أ¢â‚¬آ ط·آ·ط¢آ§ط·آ¸أ¢â‚¬آ¦ط·آ¸ط«â€ ط·آ¸ط¸آ¾ط·آ¸أ¢â‚¬ع‘')
      }
    }
  }

  return (
    <div className="w-full max-w-md">
      {showRegister ? (
        <>
          <RegisterForm onSuccess={() => setShowRegister(false)} />
          <div className="mt-4 text-center">
            <button
              className="text-sm text-[#154b5f] hover:underline"
              onClick={() => setShowRegister(false)}
              type="button"
            >
              ط·آ¸ط¢آ¾ط·ط›ط¸آ¾ط·آ¸أ¢â‚¬â€چط·ط›أ¢â‚¬â„¢ ط·آ·ط¢آ³ط·ط›أ¢â‚¬â„¢ ط·آ·ط¢آµط·آ·ط¢آ§ط·آ·ط¢آ±ط·آ¸ط¸آ¾ ط·ط›ط¸آ¾ط·ط›ط¥â€™ط·آ¹ط·â€؛ط·آ·ط¹ط› ط·ط›ط¥â€™ط·ط›ط¸آ¾ط·آ·ط¢آ§ط·آ¹ط·â€؛ ط·آ¸ط«â€ ط·آ·ط¢آ±ط·آ¸ط«â€ ط·آ·ط¢آ¯ ط·آ¹ط¢آ©ط·آ·ط¢آ±ط·ط›ط¥â€™ط·آ¹ط·â€؛
            </button>
          </div>
        </>
      ) : (
        <>
          <form onSubmit={onSubmit} className={`${retroPanelPadded} space-y-5`}>
            <header className="space-y-2 text-right">
              <p className={retroHeading}>hesabpak access terminal</p>
              <h2 className="text-2xl font-semibold text-[#1f2e3b]">ط·آ¸ط«â€ ط·آ·ط¢آ±ط·آ¸ط«â€ ط·آ·ط¢آ¯ ط·آ·ط¢آ¨ط·آ¸أ¢â‚¬طŒ ط·آ·ط¢آ³ط·آ·ط¢آ§ط·آ¸أ¢â‚¬آ¦ط·آ·ط¢آ§ط·آ¸أ¢â‚¬آ ط·آ¸أ¢â‚¬طŒ</h2>
              <p className={`text-xs ${retroMuted}`}>
                ط·آ¸ط«â€ ط·آ·ط¢آ±ط·آ¸ط«â€ ط·آ·ط¢آ¯ ط·آ·ط¢آ¨ط·آ·ط¢آ§ ط·آ¸أ¢â‚¬آ ط·آ·ط¢آ§ط·آ¸أ¢â‚¬آ¦ ط·آ¹ط¢آ©ط·آ·ط¢آ§ط·آ·ط¢آ±ط·آ·ط¢آ¨ط·آ·ط¢آ±ط·ط›ط¥â€™/ط·آ·ط¢آ±ط·آ¸أ¢â‚¬آ¦ط·آ·ط¢آ² ط·ط›ط¥â€™ط·آ·ط¢آ§ ط·آ¸أ¢â‚¬آ¦ط·آ¸ط«â€ ط·آ·ط¢آ¨ط·آ·ط¢آ§ط·ط›ط¥â€™ط·آ¸أ¢â‚¬â€چ (OTP). ط·آ·ط¢آ¯ط·آ·ط¢آ± ط·آ·ط¢آµط·آ¸ط«â€ ط·آ·ط¢آ±ط·آ·ط¹آ¾ ط·آ¸ط¸آ¾ط·آ·ط¢آ¹ط·آ·ط¢آ§ط·آ¸أ¢â‚¬â€چ ط·آ·ط¢آ¨ط·آ¸ط«â€ ط·آ·ط¢آ¯ط·آ¸أ¢â‚¬آ  ط·آ¸ط«â€ ط·آ·ط¢آ±ط·آ¸ط«â€ ط·آ·ط¢آ¯ ط·آ·ط¢آ¯ط·آ¸ط«â€  ط·آ¸أ¢â‚¬آ¦ط·آ·ط¢آ±ط·آ·ط¢آ­ط·آ¸أ¢â‚¬â€چط·آ¸أ¢â‚¬طŒط£آ¢أ¢â€ڑآ¬ط¥â€™ط·آ·ط¢آ§ط·ط›ط¥â€™ط·آ·ط¥â€™ ط·آ¹ط¢آ©ط·آ·ط¢آ¯ ط·آ·ط¹آ¾ط·آ·ط¢آ§ط·ط›ط¥â€™ط·ط›ط¥â€™ط·آ·ط¢آ¯ ط·آ¸أ¢â‚¬â€چط·آ·ط¢آ§ط·آ·ط¢آ²ط·آ¸أ¢â‚¬آ¦ ط·آ·ط¢آ§ط·آ·ط¢آ³ط·آ·ط¹آ¾.
              </p>
            </header>

            <div className="flex gap-2 text-sm">
              <button type="button" className={`${retroButton} ${mode === 'password' ? '' : '!opacity-60'}`} onClick={() => { setMode('password'); setOtpRequired(false); setError(null); }}>
                ط·آ¸ط«â€ ط·آ·ط¢آ±ط·آ¸ط«â€ ط·آ·ط¢آ¯ ط·آ·ط¢آ¨ط·آ·ط¢آ§ ط·آ·ط¢آ±ط·آ¸أ¢â‚¬آ¦ط·آ·ط¢آ²
              </button>
              <button type="button" className={`${retroButton} ${mode === 'phone' ? '' : '!opacity-60'}`} onClick={() => { setMode('phone'); setOtpRequired(false); setError(null); }}>
                ط·آ¸ط«â€ ط·آ·ط¢آ±ط·آ¸ط«â€ ط·آ·ط¢آ¯ ط·آ·ط¢آ¨ط·آ·ط¢آ§ ط·آ¸أ¢â‚¬آ¦ط·آ¸ط«â€ ط·آ·ط¢آ¨ط·آ·ط¢آ§ط·ط›ط¥â€™ط·آ¸أ¢â‚¬â€چ
              </button>
            </div>

            <div className="space-y-4">
              {mode === 'password' ? (
                <>
                  <div>
                    <label className={retroLabel}>ط·آ¸أ¢â‚¬آ ط·آ·ط¢آ§ط·آ¸أ¢â‚¬آ¦ ط·آ¹ط¢آ©ط·آ·ط¢آ§ط·آ·ط¢آ±ط·آ·ط¢آ¨ط·آ·ط¢آ±ط·ط›ط¥â€™</label>
                    <input
                      value={username}
                      onChange={e => setUsername(e.target.value)}
                      className={`${retroInput} w-full`}
                      placeholder="username"
                    />
                  </div>
                  <div>
                    <label className={retroLabel}>ط·آ·ط¢آ±ط·آ¸أ¢â‚¬آ¦ط·آ·ط¢آ² ط·آ·ط¢آ¹ط·آ·ط¢آ¨ط·آ¸ط«â€ ط·آ·ط¢آ±</label>
                    <input
                      type="password"
                      value={password}
                      onChange={e => setPassword(e.target.value)}
                      className={`${retroInput} w-full`}
                      placeholder="ط£آ¢أ¢â€ڑآ¬ط¢آ¢ط£آ¢أ¢â€ڑآ¬ط¢آ¢ط£آ¢أ¢â€ڑآ¬ط¢آ¢ط£آ¢أ¢â€ڑآ¬ط¢آ¢ط£آ¢أ¢â€ڑآ¬ط¢آ¢ط£آ¢أ¢â€ڑآ¬ط¢آ¢ط£آ¢أ¢â€ڑآ¬ط¢آ¢ط£آ¢أ¢â€ڑآ¬ط¢آ¢"
                    />
                  </div>
                  {otpRequired && (
                    <div>
                      <label className={retroLabel}>ط·آ¹ط¢آ©ط·آ·ط¢آ¯ ط·آ·ط¹آ¾ط·آ·ط¢آ§ط·ط›ط¥â€™ط·ط›ط¥â€™ط·آ·ط¢آ¯ ط·آ·ط¢آ¯ط·آ¸ط«â€  ط·آ¸أ¢â‚¬آ¦ط·آ·ط¢آ±ط·آ·ط¢آ­ط·آ¸أ¢â‚¬â€چط·آ¸أ¢â‚¬طŒط£آ¢أ¢â€ڑآ¬ط¥â€™ط·آ·ط¢آ§ط·ط›ط¥â€™</label>
                      <input
                        value={otp}
                        onChange={e => setOtp(e.target.value)}
                        className={`${retroInput} w-full tracking-[0.6em] text-center`}
                        placeholder="123456"
                        inputMode="numeric"
                        pattern="\\d{6}"
                        autoComplete="one-time-code"
                      />
                    </div>
                  )}
                </>
              ) : (
                <>
                  <div>
                    <label className={retroLabel}>ط·آ·ط¢آ´ط·آ¸أ¢â‚¬آ¦ط·آ·ط¢آ§ط·آ·ط¢آ±ط·آ¸أ¢â‚¬طŒ ط·آ¸أ¢â‚¬آ¦ط·آ¸ط«â€ ط·آ·ط¢آ¨ط·آ·ط¢آ§ط·ط›ط¥â€™ط·آ¸أ¢â‚¬â€چ</label>
                    <input
                      value={phone}
                      onChange={e => setPhone(e.target.value)}
                      className={`${retroInput} w-full`}
                      placeholder="09xxxxxxxxx"
                    />
                  </div>
                  {otpRequired && (
                    <div>
                      <label className={retroLabel}>ط·آ¹ط¢آ©ط·آ·ط¢آ¯ ط·آ·ط¹آ¾ط·آ·ط¢آ§ط·ط›ط¥â€™ط·ط›ط¥â€™ط·آ·ط¢آ¯</label>
                      <input
                        value={otp}
                        onChange={e => setOtp(e.target.value)}
                        className={`${retroInput} w-full tracking-[0.6em] text-center`}
                        placeholder="123456"
                        inputMode="numeric"
                        pattern="\\d{6}"
                      />
                    </div>
                  )}
                  <p className={`text-[11px] ${retroMuted}`}>ط·آ¹ط¢آ©ط·آ·ط¢آ¯ ط·آ¸ط«â€ ط·آ·ط¢آ±ط·آ¸ط«â€ ط·آ·ط¢آ¯ ط·آ·ط¢آ§ط·آ·ط¢آ² ط·آ·ط¢آ·ط·آ·ط¢آ±ط·ط›ط¥â€™ط·آ¸أ¢â‚¬ع‘ SMS ط·آ·ط¢آ§ط·آ·ط¢آ±ط·آ·ط¢آ³ط·آ·ط¢آ§ط·آ¸أ¢â‚¬â€چ ط·آ¸أ¢â‚¬آ¦ط·ط›ط¥â€™ط£آ¢أ¢â€ڑآ¬ط¥â€™ط·آ·ط¢آ´ط·آ¸ط«â€ ط·آ·ط¢آ¯.</p>
                </>
              )}
            </div>

            {error && (
              <div className="border-2 border-[#c35c5c] bg-[#f9e6e6] text-[#5b1f1f] px-3 py-2 shadow-[3px_3px_0_#c35c5c] text-sm">
                {error}
              </div>
            )}

            <div className="space-y-3">
              <button className={`${retroButton} w-full`} type="submit">
                ط·آ¸ط«â€ ط·آ·ط¢آ±ط·آ¸ط«â€ ط·آ·ط¢آ¯ ط·آ·ط¢آ¨ط·آ¸أ¢â‚¬طŒ ط·آ·ط¢آ³ط·ط›ط¥â€™ط·آ·ط¢آ³ط·آ·ط¹آ¾ط·آ¸أ¢â‚¬آ¦
              </button>
            </div>
          </form>

          <div className="mt-4 text-center space-y-2">
            <p className={`text-[11px] ${retroMuted}`}>ط·آ·ط¢آ­ط·آ·ط¢آ³ط·آ·ط¢آ§ط·آ·ط¢آ¨ ط·آ¸أ¢â‚¬آ ط·آ·ط¢آ¯ط·آ·ط¢آ§ط·آ·ط¢آ±ط·ط›ط¥â€™ط·آ·ط¢آ¯ط·آ·ط¹ط›</p>
            <button
              className={`${retroButton} !bg-[#2d5b2d] w-full`}
              onClick={() => setShowRegister(true)}
              type="button"
            >
              ط·آ·ط¢آ§ط·ط›ط¥â€™ط·آ·ط¢آ¬ط·آ·ط¢آ§ط·آ·ط¢آ¯ ط·آ·ط¢آ­ط·آ·ط¢آ³ط·آ·ط¢آ§ط·آ·ط¢آ¨ ط·آ·ط¢آ¬ط·آ·ط¢آ¯ط·ط›ط¥â€™ط·آ·ط¢آ¯ (ط·آ¸أ¢â‚¬آ¦ط·آ¸ط«â€ ط·آ·ط¢آ¨ط·آ·ط¢آ§ط·ط›ط¥â€™ط·آ¸أ¢â‚¬â€چ)
            </button>
          </div>
        </>
      )}
    </div>
  )
}
